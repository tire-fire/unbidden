=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 70
{include if "with-d"}
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/nsswitch.conf 178
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d" and "with-b" or "with-d" and "with-a":only_yes}
{imply "with-b" if "with-b"}

=== usr/share/authselect/vendor/tprof/password-auth 408
auth        required      pam_env.so {if not "with-b":only_yes}
# a comment line {imply "with-d" if "with-c"} tail {include if "with-d"}
password    requisite     pam_pwquality.so
session     optional      pam_keyinit.so revoke {stop if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{if "with-c":yes_text|no_text}
auth        required      pam_env.so
   


=== usr/share/authselect/vendor/tprof/postlogin 633
{imply "with-c" if ("with-d")}
password    requisite     pam_pwquality.so {include if not (not "with-a")} tail {include if (not "with-c") or "with-c"}
{imply "with-a" if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{stop if "with-b"}
password    requisite     pam_pwquality.so
account     required      pam_unix.so {include if "with-c" or "with-a" or "with-a" or "with-a"} tail {imply "with-a" if (not ("with-a"))}
session     optional      pam_keyinit.so revoke {stop if "with-c"}
 {if not "with-b" and "with-c" or "with-a":only_yes}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/smartcard-auth 470
{include if "with-a"}
auth        sufficient    pam_unix.so nullok
    {exclude if "with-d"}
account     required      pam_unix.so {continue if ("with-a") and "with-b" and "with-d" and "with-c"}
auth        required      pam_env.so
account     required      pam_unix.so {if ("with-b" or "with-b" or "with-a"):yes_text|no_text}
    {stop if ("with-a" and "with-c") or "with-c"}
auth        required      pam_env.so {if ("with-c" or "with-a" or "with-c"):yes_text|no_text}
=== usr/share/authselect/vendor/tprof/system-auth 543
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{imply "with-a" if not "with-a"}
auth        sufficient    pam_unix.so nullok
{imply "with-c" if "with-d"}
password    requisite     pam_pwquality.so {continue if (("with-c"))}
account     required      pam_unix.so
session     optional      pam_keyinit.so revoke {if "with-d":yes_text|no_text} tail {include if (not "with-a")}
   
{continue if "with-d"}
account     required      pam_unix.so {imply "with-b" if not not "with-c" or ("with-b") or "with-b"}

