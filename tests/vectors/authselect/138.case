=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 510
{continue if "with-a"}
auth        sufficient    pam_unix.so nullok {exclude if ("with-a" and "with-c" or "with-c" or "with-a")} tail {include if ("with-d") or "with-a" or "with-d" and not "with-d"}
session     optional      pam_keyinit.so revoke {exclude if not "with-b"} tail {stop if (("with-b"))}
{continue if "with-b" and "with-c" or "with-c"}
account     required      pam_unix.so {exclude if "with-d"}
auth        required      pam_env.so {imply "with-b" if "with-a"}
{include if "with-d" and "with-c"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 409
password    requisite     pam_pwquality.so
auth        required      pam_env.so {if "with-c":yes_text|no_text}
auth        required      pam_env.so {if "with-c" or ("with-b") or "with-c":yes_text|no_text} tail {include if ("with-c")}
{if "with-b" or not "with-b" and ("with-c"):only_yes}
    {exclude if (not not "with-c")} tail {stop if "with-b"}
{if "with-a" and "with-b":yes_text|no_text}
# a comment line

=== usr/share/authselect/vendor/tprof/password-auth 27
   
{continue if "with-b"}

=== usr/share/authselect/vendor/tprof/postlogin 52
   
auth        sufficient    pam_unix.so nullok
   
=== usr/share/authselect/vendor/tprof/smartcard-auth 116
{if "with-c" or ("with-b"):yes_text|no_text}
 {include if "with-a"}
# a comment line {if not not "with-a":only_yes}

=== usr/share/authselect/vendor/tprof/system-auth 22
{include if "with-b"}

