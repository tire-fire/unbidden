=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 131
password    requisite     pam_pwquality.so {include if not "with-d"}
{if not "with-c" or "with-b":only_yes}
{if "with-d":only_yes}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 533
{if "with-c":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-d"}
auth        sufficient    pam_unix.so nullok
{exclude if "with-a"}
auth        sufficient    pam_unix.so nullok {imply "with-c" if "with-b" or "with-c"}
password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok {include if "with-d"}
auth        sufficient    pam_unix.so nullok
auth        sufficient    pam_unix.so nullok {if ("with-c") and "with-b":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 283
session     optional      pam_keyinit.so revoke {if "with-c":yes_text|no_text} tail {include if "with-a"}
# a comment line {continue if not "with-c" or "with-c"}
    {imply "with-b" if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/smartcard-auth 149
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-a" or "with-a"} tail {include if "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 435
# a comment line {stop if "with-d" and not "with-a" and "with-c"}
password    requisite     pam_pwquality.so {continue if ("with-c")}
{imply "with-b" if "with-d" and "with-a" and "with-b" or "with-b"}
{continue if "with-c"}
# a comment line {include if "with-b"} tail {stop if "with-d" and not "with-d"}
{include if "with-b"}
   
{continue if not "with-d"}
   
auth        sufficient    pam_unix.so nullok {imply "with-a" if "with-c"}

