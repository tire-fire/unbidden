=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 314
# a comment line {exclude if "with-d"}
{exclude if "with-a"}
# a comment line
{if "with-a" and "with-b":yes_text|no_text}
auth        required      pam_env.so {if ("with-b"):yes_text|no_text}
auth        required      pam_env.so
    {stop if ("with-b")}
auth        required      pam_env.so
{continue if "with-a"}

=== usr/share/authselect/vendor/tprof/password-auth 413

auth        required      pam_env.so
{if ("with-a":x}
# a comment line

# a comment line {exclude if not (not "with-c")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d" or "with-d" and ("with-a")} tail {if ("with-b" and "with-b") or "with-c":yes_text|no_text}
auth        required      pam_env.so {stop if (not "with-d") and "with-b" or not "with-d"}

