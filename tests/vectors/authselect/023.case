=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 156
{include if "with-a" and "with-c" or "with-b"}
    {if "with-b":only_yes}
   
{include if "with-b"}
auth        required      pam_env.so {stop if "with-b"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 402
{include if "with-a"}
account     required      pam_unix.so
password    requisite     pam_pwquality.so {if not "with-b" and "with-b" or "with-d" or "with-d":yes_text|no_text} tail {exclude if ("with-d" and "with-c") or ("with-c")}
{continue if "with-a"}
{exclude if "with-a" or "with-d" and ("with-d") or "with-a"}
auth        required      pam_env.so {include if "with-d"} tail {include if ("with-a")}
=== usr/share/authselect/vendor/tprof/postlogin 338
password    requisite     pam_pwquality.so
password    requisite     pam_pwquality.so
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok {stop if "with-a"}
{stop if "with-d" or "with-d" or "with-d" or ("with-b")}
{include if ("with-a")}
{if "with-b":only_yes}
    {include if not not "with-c" and "with-d"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 473
password    requisite     pam_pwquality.so
session     optional      pam_keyinit.so revoke {continue if "with-a" and "with-d" or "with-a"} tail {if "with-b":only_yes}
auth        required      pam_env.so {continue if "with-d" and ("with-d")}
auth        required      pam_env.so {if "with-d":only_yes}
{include if ("with-d")}
auth        required      pam_env.so
password    requisite     pam_pwquality.so {stop if "with-d" or "with-a"} tail {if "with-a":yes_text|no_text}

