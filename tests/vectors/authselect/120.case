=== usr/share/authselect/vendor/tprof/smartcard-auth 629
   
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if "with-c"}
auth        sufficient    pam_unix.so nullok
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if ("with-a"):yes_text|no_text} tail {if "with-b" and "with-b":only_yes}
account     required      pam_unix.so {exclude if "with-d"}
account     required      pam_unix.so {imply "with-c" if "with-c" and "with-b" and "with-d"} tail {if "with-c" or "with-c" and "with-b":only_yes}

