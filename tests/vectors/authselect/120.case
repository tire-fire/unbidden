Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 539
# a comment line {exclude if ("with-b")}

account     required      pam_unix.so {continue if not (("with-c"))}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-c":only_yes}
auth        required      pam_env.so
session     optional      pam_keyinit.so revoke {}
{imply "with-c" if "with-b" and ("with-b")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-a" and ("with-b") or "with-b"}
{include if "with-a" or "with-d" and "with-d"}

=== usr/share/authselect/vendor/tprof/password-auth 431
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"}
auth        required      pam_env.so {if "with-d":only_yes}
{include if "with-d" or "with-d" and "with-a" and not "with-d"}
{continue if "with-b"}
{include if "with-a"}
# a comment line {if "with-c":yes_text|no_text}
session     optional      pam_keyinit.so revoke
{continue if not not not "with-b"}
# a comment line
   

