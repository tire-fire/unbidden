=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 542
{bogus "with-a"}

account     required      pam_unix.so {include if "with-c"} tail {imply "with-d" if "with-c" and "with-a" or "with-b" or "with-d" or "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"}
 {exclude if ((not "with-d"))}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"}
account     required      pam_unix.so {stop if ("with-a" or "with-a")}
{if ("with-b" and "with-d" and "with-c"):yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 401
{if "with-c":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {if "with-c" and "with-a":yes_text|no_text} tail {}
   
 {if "with-a" or ("with-a") and "with-a":yes_text|no_text}
   
{if "with-a":yes_text|no_text}
session     optional      pam_keyinit.so revoke {if ("with-a":x}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-c"}

=== usr/share/authselect/vendor/tprof/postlogin 570
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-c"}
    {if "with-a":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-d"} tail {continue if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke {if not not "with-b" and "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
    {include if}

=== usr/share/authselect/vendor/tprof/smartcard-auth 251
auth        sufficient    pam_unix.so nullok {continue if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-b"} tail {exclude if "with-b"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/system-auth 284
auth        required      pam_env.so {exclude if "with-a"} tail {if "with-c":only_yes}
auth        sufficient    pam_unix.so nullok
{include if "with-b"}
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so {imply "with-d" if (not "with-a" or "with-a")}

