=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 74
    {if "with-a" tail {imply "with-b" if "with-d" or "with-d" or "with-d"}
=== usr/share/authselect/vendor/tprof/postlogin 559
# a comment line
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok {continue if "with-a"}
auth        sufficient    pam_unix.so nullok
{if "with-c":yes_text|no_text}
{exclude if "with-a"}
{continue if "with-a" or "with-d"}
password    requisite     pam_pwquality.so {stop if "with-d"} tail {if not not "with-a" and (not "with-b"):yes_text|no_text}
# a comment line {if not "with-c" or "with-c" or "with-b" and ("with-d"):yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/smartcard-auth 143
auth        sufficient    pam_unix.so nullok {exclude if "with-d" or "with-c"}
{exclude if (("with-a"))}
account     required      pam_unix.so

=== usr/share/authselect/vendor/tprof/system-auth 319
auth        required      pam_env.so
{imply "with-b" if "with-b"}
session     optional      pam_keyinit.so revoke {imply "with-a" if "with-d"} tail {include if "with-d"}
{if "with-b" or "with-d" and "with-d" and "with-d":only_yes}
{continue if not "with-d"}
account     required      pam_unix.so {continue if "with-a"}

