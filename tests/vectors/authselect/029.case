=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 596
auth        sufficient    pam_unix.so nullok {continue if "with-d"}
{continue if "with-a" and not "with-c" and "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if ("with-b") and "with-d" and "with-c"}
# a comment line
account     required      pam_unix.so
account     required      pam_unix.so {if (not not "with-a"):only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":yes_text|no_text} tail {include if "with-c"}
session     optional      pam_keyinit.so revoke
# a comment line

