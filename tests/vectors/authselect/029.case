=== usr/share/authselect/vendor/tprof/postlogin 444
session     optional      pam_keyinit.so revoke {exclude if not not "with-c" or "with-d"}
password    requisite     pam_pwquality.so {exclude if "with-a"} tail {imply "with-b" if "with-c"}
password    requisite     pam_pwquality.so {if (not "with-c" or not "with-c"):yes_text|no_text}
{if not not "with-d" or "with-b":yes_text|no_text}
# a comment line {continue if "with-c"}
auth        required      pam_env.so {if "with-d":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/smartcard-auth 526
account     required      pam_unix.so
session     optional      pam_keyinit.so revoke
    {if "with-d" and ("with-d") or "with-a":yes_text|no_text}
{include if}
auth        sufficient    pam_unix.so nullok {continue if ("with-d")} tail {imply "with-d" if ("with-a") or "with-a" or "with-c"}
{exclude if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-b"} tail {continue if "with-c"}
auth        required      pam_env.so
account     required      pam_unix.so

