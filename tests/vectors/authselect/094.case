=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 580
# a comment line {if not "with-c" and "with-c":yes_text|no_text} tail {imply "with-c" if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"}
 {include if "with-b" or "with-b" or "with-d" or "with-c" or "with-c"}
session     optional      pam_keyinit.so revoke {exclude if "with-d"}
auth        required      pam_env.so {if not "with-b" or "with-a" or "with-c":only_yes}
auth        sufficient    pam_unix.so nullok
# a comment line
session     optional      pam_keyinit.so revoke {if "with-a":yes_text|no_text}


=== usr/share/authselect/vendor/tprof/nsswitch.conf 154
{continue if "with-c"}
auth        sufficient    pam_unix.so nullok {bogus "with-a"}
# a comment line {exclude if ("with-a")} tail {if "with-b":only_yes}

=== usr/share/authselect/vendor/tprof/password-auth 620
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-c":yes_text|no_text}
# a comment line {include if "with-d"} tail {imply "with-d" if ("with-c")}
session     optional      pam_keyinit.so revoke
auth        required      pam_env.so {if ("with-a":x}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so {bogus "with-a"}
session     optional      pam_keyinit.so revoke
{if "with-a":yes_text|no_text}
 {if not "with-d" and ("with-d") and "with-c" or "with-c":yes_text|no_text} tail {exclude if "with-d"}

=== usr/share/authselect/vendor/tprof/postlogin 54
{if :x}
{continue if "with-b"}
{if "with-a":only_yes}

=== usr/share/authselect/vendor/tprof/smartcard-auth 535
   
account     required      pam_unix.so {continue if "with-c"} tail {stop if "with-b"}
auth        sufficient    pam_unix.so nullok {exclude if "with-b" or not "with-a" or "with-c"}
{stop if "with-b" and "with-a" or "with-d" or "with-b"}
# a comment line {include if "with-a" or "with-a"}
auth        sufficient    pam_unix.so nullok {if (not "with-d") and "with-a" or "with-d" or "with-c":only_yes} tail {include if "with-b"}
account     required      pam_unix.so
{if "with-a":only_yes}

{if (not "with-b" or not "with-c"):only_yes}
