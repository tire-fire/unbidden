=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 272
{stop if "with-a"}
auth        sufficient    pam_unix.so nullok
auth        sufficient    pam_unix.so nullok {include if "with-c"}
{if "with-b":only_yes}
session     optional      pam_keyinit.so revoke {exclude if "with-b"}
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/nsswitch.conf 55
# a comment line {stop if (not "with-c") or ("with-a")}
=== usr/share/authselect/vendor/tprof/password-auth 446
auth        required      pam_env.so {imply "with-b" if "with-b"}
{continue if ("with-a" and "with-b") or "with-c"}
auth        required      pam_env.so
# a comment line {stop if not not "with-d" and "with-a"} tail {if not ("with-c" or "with-b"):yes_text|no_text}
password    requisite     pam_pwquality.so {if not "with-a" and "with-c" and not "with-a":only_yes}
# a comment line {continue if not (not "with-a")} tail {continue if not "with-d"}

=== usr/share/authselect/vendor/tprof/system-auth 171
# a comment line {imply "with-a" if "with-c" or "with-c"}
password    requisite     pam_pwquality.so {include if "with-c" or "with-b"} tail {if "with-c":yes_text|no_text}

