=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 335
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

auth        required      pam_env.so {if not "with-d" or "with-a" or "with-b" or "with-a" or "with-c":only_yes}
{imply "with-a" if "with-c" and "with-b" and "with-b" or "with-b" and "with-d" and "with-a" or "with-c" and "with-c"}
# a comment line
=== usr/share/authselect/vendor/tprof/nsswitch.conf 505
{if "with-d" or not "with-d" or ("with-d") or "with-b" and "with-d":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
{stop if not ("with-c" and "with-d")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-a":only_yes}
password    requisite     pam_pwquality.so {if ("with-d"):only_yes}
session     optional      pam_keyinit.so revoke {continue if "with-d"} tail {bogus "with-a"}
# a comment line
 {if ("with-a":x} tail {if "with-a":only_yes}


=== usr/share/authselect/vendor/tprof/password-auth 364
{if "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-a":yes_text|no_text}
 {stop if "with-b"}
session     optional      pam_keyinit.so revoke {exclude if "with-a"} tail {exclude if "with-a" and "with-a"}
{exclude if "with-c"}
account     required      pam_unix.so
 {continue if "with-b"}

=== usr/share/authselect/vendor/tprof/postlogin 360
auth        sufficient    pam_unix.so nullok {continue if not "with-a"} tail {continue if "with-a"}
session     optional      pam_keyinit.so revoke
   
password    requisite     pam_pwquality.so
account     required      pam_unix.so {exclude if ("with-c" or "with-b" and "with-a")}
{imply "with-d" if "with-b"}
    {continue if "with-d"}
{continue if "with-b"}
=== usr/share/authselect/vendor/tprof/system-auth 71
password    requisite     pam_pwquality.so
{include if (not "with-c")}

