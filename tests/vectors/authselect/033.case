=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 258
{include if "with-a" and ("with-b" or "with-b")}
    {include if}
   
auth        required      pam_env.so {continue if not "with-d" or "with-b" and not ("with-a")}
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/nsswitch.conf 61
{stop if not "with-a"}
account     required      pam_unix.so

=== usr/share/authselect/vendor/tprof/password-auth 50
{include if}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/postlogin 346
password    requisite     pam_pwquality.so {} tail {if not ("with-c") or "with-d":yes_text|no_text}
account     required      pam_unix.so {include if "with-c" and "with-b" and "with-a"} tail {if "with-c":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {stop if "with-d"}
account     required      pam_unix.so {exclude if "with-c"}

=== usr/share/authselect/vendor/tprof/system-auth 493
    {include if not not "with-c" and "with-b"}
auth        required      pam_env.so {imply "with-a" if "with-b"}
auth        required      pam_env.so {if "with-d":only_yes} tail {include if "with-a"}
# a comment line {continue if not (("with-c"))} tail {if "with-c":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"} tail {include if "with-a"}
   
   
auth        sufficient    pam_unix.so nullok {stop if "with-c"}

