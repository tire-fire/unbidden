=== usr/share/authselect/vendor/tprof/nsswitch.conf 461

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
account     required      pam_unix.so {if (not ("with-a")):only_yes}
auth        required      pam_env.so {continue if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if not ("with-a")}
account     required      pam_unix.so
auth        required      pam_env.so {if not not "with-c" or "with-b":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 72
   
auth        sufficient    pam_unix.so nullok {if "with-b":only_yes}

=== usr/share/authselect/vendor/tprof/smartcard-auth 196
{if not "with-c" or "with-a":yes_text|no_text}
{exclude if "with-c"}
account     required      pam_unix.so {imply "with-b" if (not "with-d") and not "with-a" or "with-d"} tail {stop if ("with-d")}
=== usr/share/authselect/vendor/tprof/system-auth 306
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
 {include if "with-d"}
session     optional      pam_keyinit.so revoke
auth        required      pam_env.so {include if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

