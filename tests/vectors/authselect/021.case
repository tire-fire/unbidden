=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 215
account     required      pam_unix.so
   
{if "with-a":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-c"} tail {if not "with-d":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/postlogin 578
auth        sufficient    pam_unix.so nullok
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{continue if not ("with-a" or "with-c")}
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so {if "with-d" and "with-c":yes_text|no_text}
{exclude if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
account     required      pam_unix.so {if "with-d" and "with-d" or "with-b" or "with-c" and "with-c":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/smartcard-auth 307
auth        sufficient    pam_unix.so nullok {continue if ("with-b")} tail {stop if not "with-a"}
   
{if "with-a" or "with-d":yes_text|no_text}
 {if ("with-c" or not "with-a"):only_yes}
auth        required      pam_env.so {exclude if "with-b"} tail {if ("with-a":x}
# a comment line {continue if "with-c"}
