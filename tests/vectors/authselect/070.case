=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 372
auth        required      pam_env.so
 {if "with-b":yes_text|no_text}
{imply "with-a" if "with-b"}
 {include if "with-a"}
password    requisite     pam_pwquality.so {stop if "with-c"}
    {continue if "with-a"}
password    requisite     pam_pwquality.so {continue if "with-d"}
password    requisite     pam_pwquality.so {if "with-d" and "with-c":only_yes}
# a comment line

=== usr/share/authselect/vendor/tprof/nsswitch.conf 630
{imply "with-c" if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-b" and "with-c"}
{stop if "with-a" or "with-d" and "with-c" and "with-b"}
session     optional      pam_keyinit.so revoke {include if "with-a" or "with-a" and "with-d" and "with-c" and "with-c"} tail {if not "with-a":only_yes}
auth        sufficient    pam_unix.so nullok {imply "with-a" if "with-d"}
session     optional      pam_keyinit.so revoke {bogus "with-a"} tail {if "with-c":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/password-auth 277
account     required      pam_unix.so {include if not ("with-a")}
session     optional      pam_keyinit.so revoke {stop if not ("with-b") or not "with-c"}

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if ("with-b" or "with-c")}

=== usr/share/authselect/vendor/tprof/postlogin 60
{if "with-c":only_yes}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 223

   
{include if "with-c"}
auth        sufficient    pam_unix.so nullok {exclude if ("with-b") and not "with-d" or ("with-b")}
{continue if not "with-c" or "with-c" or "with-a"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/system-auth 549
   
password    requisite     pam_pwquality.so {exclude if "with-c"}
   
session     optional      pam_keyinit.so revoke {stop if "with-a"}
auth        required      pam_env.so {if "with-c":only_yes}
# a comment line
auth        sufficient    pam_unix.so nullok {exclude if not not "with-d" and "with-d"}
account     required      pam_unix.so {if not "with-a" or "with-d" or "with-d" and "with-b":yes_text|no_text}
password    requisite     pam_pwquality.so {if "with-c" or not "with-a":yes_text|no_text} tail {include if "with-b" and not "with-c"}

