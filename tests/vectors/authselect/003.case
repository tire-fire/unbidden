auth        sufficient    pam_unix.so nullok {if "with-b":yes_text|no_text} tail {include if "with-c"}
password    requisite     pam_pwquality.so
password    requisite     pam_pwquality.so {continue if (("with-b")) and "with-c"}
account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok
