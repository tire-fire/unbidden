=== usr/share/authselect/vendor/tprof/fingerprint-auth 436
{imply "with-d" if "with-d"}

{continue if "with-b"}
auth        sufficient    pam_unix.so nullok {imply "with-b" if "with-c" or "with-a" or "with-a"} tail {include if "with-d" and not "with-b" and "with-a"}
auth        required      pam_env.so
auth        required      pam_env.so {exclude if ("with-d" and "with-a")}
password    requisite     pam_pwquality.so
password    requisite     pam_pwquality.so {imply "with-b" if ("with-d")}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 121
