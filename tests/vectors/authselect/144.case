=== usr/share/authselect/vendor/tprof/fingerprint-auth 23
 {exclude if "with-b"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 588
account     required      pam_unix.so {imply "with-c" if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke
account     required      pam_unix.so
session     optional      pam_keyinit.so revoke {if "with-b":yes_text|no_text}
auth        required      pam_env.so
password    requisite     pam_pwquality.so {exclude if "with-a" and "with-a"}
{if "with-d" or "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-a"}

=== usr/share/authselect/vendor/tprof/password-auth 47
session     optional      pam_keyinit.so revoke
=== usr/share/authselect/vendor/tprof/postlogin 181
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
 {imply "with-d" if "with-d"} tail {if "with-c":yes_text|no_text}
{continue if not "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 292
# a comment line {include if "with-b"} tail {continue if "with-b"}
{continue if not "with-d" or "with-b"}
# a comment line {exclude if (not ("with-d"))}
password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok {imply "with-a" if "with-d"}
{include if "with-a"}

