=== usr/share/authselect/vendor/tprof/nsswitch.conf 376
auth        sufficient    pam_unix.so nullok {exclude if "with-a"} tail {if "with-c" or "with-d" and "with-d":only_yes}
 {include if not "with-b"} tail {if "with-c":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-b"}
password    requisite     pam_pwquality.so
# a comment line {exclude if "with-a"}

=== usr/share/authselect/vendor/tprof/password-auth 285
    {exclude if "with-d"} tail {include if not "with-d"}
    {if ("with-a":x}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-a"} tail {stop if not not not "with-b"}
# a comment line {if "with-a":only_yes}
{include if "with-d"}
=== usr/share/authselect/vendor/tprof/postlogin 475
account     required      pam_unix.so
{if not not "with-d" and "with-c":yes_text|no_text}
session     optional      pam_keyinit.so revoke
 {include if not ("with-d") or "with-d" or "with-b"} tail {if "with-b" and ("with-d"):yes_text|no_text}
    {if "with-c":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d" or "with-c"}
   
   
# a comment line
auth        required      pam_env.so {exclude if "with-a"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 396
{if not "with-b" or "with-b":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
    {if not (("with-a")):yes_text|no_text}
password    requisite     pam_pwquality.so {imply "with-a" if "with-a"} tail {if (not "with-d"):only_yes}
    {continue if "with-a" and "with-b" or "with-d" and "with-a"}
{include if "with-a"}
password    requisite     pam_pwquality.so {continue if ("with-b")}

=== usr/share/authselect/vendor/tprof/system-auth 304
   
account     required      pam_unix.so {continue if "with-c"}
account     required      pam_unix.so {exclude if "with-b"}
{stop if not "with-b"}
auth        required      pam_env.so {if "with-b":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
password    requisite     pam_pwquality.so

