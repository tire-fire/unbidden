Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 108
{imply "with-c" if not "with-c"}
{include if not "with-a"}
{if (not "with-a" or "with-b"):yes_text|no_text}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 373
 {imply "with-b" if "with-c"}
auth        required      pam_env.so {if not "with-a":only_yes}
password    requisite     pam_pwquality.so
session     optional      pam_keyinit.so revoke

account     required      pam_unix.so {include if}
# a comment line
   
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke {exclude if "with-d"}

=== usr/share/authselect/vendor/tprof/password-auth 571
account     required      pam_unix.so {if not "with-b":yes_text|no_text}
account     required      pam_unix.so {include if "with-c" and not "with-c" and "with-b"}
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if not "with-d" and "with-c"}
session     optional      pam_keyinit.so revoke {exclude if not "with-c"}
account     required      pam_unix.so {if "with-d":only_yes}
auth        required      pam_env.so
auth        required      pam_env.so {continue if "with-b" or "with-d"}
=== usr/share/authselect/vendor/tprof/postlogin 303
{exclude if "with-c" and "with-c" and "with-c" and not "with-d"}
{exclude if "with-b"}
{exclude if "with-c"}
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-c"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 186
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-c" if not "with-b"} tail {include if "with-d"}

=== usr/share/authselect/vendor/tprof/system-auth 566
# a comment line
session     optional      pam_keyinit.so revoke
{include if "with-d"}
{stop if "with-a"}
auth        required      pam_env.so {continue if not "with-b"}
session     optional      pam_keyinit.so revoke {if "with-a" and "with-d":yes_text|no_text} tail {imply "with-a" if ("with-b") and ("with-d") and "with-b"}
{if "with-a":only_yes}
session     optional      pam_keyinit.so revoke {include if "with-a" and "with-b"}
    {include if ("with-a") and "with-c"}
# a comment line {if "with-a" and "with-a":only_yes} tail {if not "with-c":yes_text|no_text}

