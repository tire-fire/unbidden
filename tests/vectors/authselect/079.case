=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 617
    {if "with-c":only_yes} tail {include if not "with-d"}
session     optional      pam_keyinit.so revoke {continue if "with-c" and "with-c"}
session     optional      pam_keyinit.so revoke {exclude if not not "with-c"}
{exclude if "with-a"}
{if "with-c":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-a" and "with-b" or not "with-c" and "with-a"}
auth        sufficient    pam_unix.so nullok
    {continue if ("with-b")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if ("with-d") and "with-b"}

=== usr/share/authselect/vendor/tprof/password-auth 505
{continue if "with-b" or "with-a"}
# a comment line
session     optional      pam_keyinit.so revoke {include if "with-b"}
auth        sufficient    pam_unix.so nullok {exclude if ("with-a") and ("with-d") and "with-c"}
password    requisite     pam_pwquality.so {continue if "with-d"} tail {imply "with-d" if "with-d"}
session     optional      pam_keyinit.so revoke
session     optional      pam_keyinit.so revoke {include if "with-d"} tail {imply "with-a" if "with-d" and ("with-c") and (not "with-d")}

=== usr/share/authselect/vendor/tprof/postlogin 525
session     optional      pam_keyinit.so revoke {stop if "with-b"}
password    requisite     pam_pwquality.so {imply "with-c" if "with-d"} tail {include if not ("with-c")}
password    requisite     pam_pwquality.so
{exclude if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if ("with-d")}
{include if ("with-c" and "with-b") and "with-b"}
auth        required      pam_env.so

