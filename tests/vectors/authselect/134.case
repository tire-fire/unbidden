=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 143
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b" or "with-c" or "with-b":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 221
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
    {if "with-b" and "with-a" and "with-a" and "with-b":only_yes}
auth        sufficient    pam_unix.so nullok {exclude if "with-d"}

=== usr/share/authselect/vendor/tprof/password-auth 400
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-c" if "with-b"} tail {if "with-a":only_yes}
session     optional      pam_keyinit.so revoke
{if not ("with-d"):only_yes}
auth        sufficient    pam_unix.so nullok {if "with-a" or ("with-b"):only_yes}
auth        required      pam_env.so {include if "with-b"}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/postlogin 640
session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so
{if ("with-a":x}
session     optional      pam_keyinit.so revoke {include if "with-a"}
session     optional      pam_keyinit.so revoke {continue if (not "with-c")}
auth        sufficient    pam_unix.so nullok {exclude if (("with-a" and "with-c"))} tail {include if "with-d"}
account     required      pam_unix.so {imply "with-a" if not "with-b" or "with-c" or ("with-b" and "with-d")} tail {include if "with-b" or not not "with-b"}
account     required      pam_unix.so {stop if "with-c" or "with-b"}
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/smartcard-auth 236
 {imply "with-b" if not not "with-d" and not "with-b" or "with-a"} tail {if "with-b":only_yes}
session     optional      pam_keyinit.so revoke {continue if "with-b" or "with-b" and not "with-c" or not ("with-a")}
{continue if "with-c"}

=== usr/share/authselect/vendor/tprof/system-auth 255
# a comment line {continue if ("with-c")}
session     optional      pam_keyinit.so revoke {stop if "with-a" or "with-c"}
   
# a comment line
password    requisite     pam_pwquality.so {if "with-a" and "with-b" or ("with-a") and "with-a":yes_text|no_text}
