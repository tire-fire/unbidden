=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 321
{include if not "with-c" and "with-a" or ("with-c") and not "with-b"}
   
 {if not "with-d" or "with-d" and (not "with-b"):only_yes} tail {stop if "with-b"}

account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/nsswitch.conf 48
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/password-auth 291
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{include if "with-c"}
auth        required      pam_env.so
 {if "with-c":yes_text|no_text}
account     required      pam_unix.so
session     optional      pam_keyinit.so revoke {include if not "with-a"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 267
 {include if "with-d"} tail {if "with-c":yes_text|no_text}
auth        required      pam_env.so {if "with-d":yes_text|no_text}
session     optional      pam_keyinit.so revoke {exclude if "with-d"}
session     optional      pam_keyinit.so revoke {if "with-b":only_yes}
=== usr/share/authselect/vendor/tprof/system-auth 480
account     required      pam_unix.so
# a comment line
{include if "with-b"}
 {continue if "with-d"} tail {continue if "with-b"}
auth        sufficient    pam_unix.so nullok {include if "with-c"}
# a comment line {if "with-b":only_yes}
   
auth        required      pam_env.so
# a comment line {imply "with-d" if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if ("with-a"):yes_text|no_text} tail {if "with-a":yes_text|no_text}

