=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 445
account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok {exclude if "with-d"} tail {if (("with-b")):yes_text|no_text}
password    requisite     pam_pwquality.so
 {if "with-b":yes_text|no_text}
    {continue if (not "with-d" and "with-c")}
 {continue if not "with-c"} tail {exclude if not not "with-a" or ("with-a" and "with-a")}
   
auth        sufficient    pam_unix.so nullok {exclude if (not "with-d" or "with-c")}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 377
{if "with-c":yes_text|no_text}
{include if "with-d"}
{if not not "with-c":yes_text|no_text}
{if "with-b" or "with-a" and not "with-d":only_yes}
session     optional      pam_keyinit.so revoke {exclude if "with-c"}

password    requisite     pam_pwquality.so {if "with-a":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/postlogin 299
 {stop if "with-b" and "with-d" and "with-d" or "with-c" and "with-b"}
    {include if ("with-c" or "with-d") and "with-a"}
{include if "with-d" and "with-a" or "with-c" or not ("with-a")}
auth        sufficient    pam_unix.so nullok {stop if not "with-b" and "with-d" or "with-b" and not "with-a"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 453
account     required      pam_unix.so {if "with-a":yes_text|no_text}
session     optional      pam_keyinit.so revoke {include if not "with-b" and "with-b" or not "with-d"}
auth        sufficient    pam_unix.so nullok {bogus "with-a"}
auth        sufficient    pam_unix.so nullok {if "with-a" or "with-a" and "with-b" or "with-d" or (not "with-d"):yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/system-auth 47
    {include if "with-c"}
{include if "with-a"}
