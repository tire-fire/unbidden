=== usr/share/authselect/vendor/tprof/fingerprint-auth 192
    {include if "with-b"}
account     required      pam_unix.so {continue if (("with-d")) and "with-a"} tail {if ("with-b") and ("with-a") and "with-b":only_yes}
    {include if not "with-c"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 323
{exclude if "with-a"}
auth        required      pam_env.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        sufficient    pam_unix.so nullok

{exclude if "with-a" or "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if :x}

