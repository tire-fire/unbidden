=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 4
   

=== usr/share/authselect/vendor/tprof/nsswitch.conf 251
auth        required      pam_env.so {continue if "with-c"} tail {exclude if "with-a"}
account     required      pam_unix.so {exclude if "with-c" and "with-b" or "with-a" and not "with-c"} tail {exclude if (not "with-a")}
{include if not not "with-c"}
=== usr/share/authselect/vendor/tprof/password-auth 127
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{if ("with-a":x}
{exclude if "with-a"}

=== usr/share/authselect/vendor/tprof/postlogin 85
{exclude if ("with-a") or "with-b" and not "with-b"}
{if :x}
{continue if "with-b"}


=== usr/share/authselect/vendor/tprof/smartcard-auth 151
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-c"}
{include if (not "with-b" or "with-b")}

=== usr/share/authselect/vendor/tprof/system-auth 530
{if "with-d" and "with-c":yes_text|no_text}
{exclude if "with-b"}


session     optional      pam_keyinit.so revoke {if ("with-d") and "with-a":yes_text|no_text} tail {include if "with-c" or not "with-d" and ("with-a")}
account     required      pam_unix.so
session     optional      pam_keyinit.so revoke
session     optional      pam_keyinit.so revoke {if "with-d" or "with-a":yes_text|no_text}
account     required      pam_unix.so
# a comment line {exclude if ("with-b" or "with-c" and "with-d")} tail {include if ("with-b")}

