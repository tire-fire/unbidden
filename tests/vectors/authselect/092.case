=== usr/share/authselect/vendor/tprof/nsswitch.conf 497
auth        required      pam_env.so
{include if "with-a"}
{if not "with-b" or "with-d" or "with-a" or "with-a":only_yes}
account     required      pam_unix.so
password    requisite     pam_pwquality.so {continue if "with-d"} tail {continue if ("with-c")}
account     required      pam_unix.so {include if "with-d"}
{if not "with-c":yes_text|no_text}
{exclude if ("with-d")}
password    requisite     pam_pwquality.so {continue if "with-b"} tail {exclude if not "with-c" and "with-d" or "with-d"}

=== usr/share/authselect/vendor/tprof/password-auth 444
auth        sufficient    pam_unix.so nullok {imply "with-b" if "with-b"}
auth        sufficient    pam_unix.so nullok {include if "with-a"} tail {if "with-b":yes_text|no_text}

password    requisite     pam_pwquality.so {if "with-a"
session     optional      pam_keyinit.so revoke

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b" and not "with-c" and "with-a" or "with-b":yes_text|no_text}

