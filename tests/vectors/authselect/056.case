=== usr/share/authselect/vendor/tprof/system-auth 530
password    requisite     pam_pwquality.so
{exclude if "with-a"}
password    requisite     pam_pwquality.so {include if "with-a"}
password    requisite     pam_pwquality.so
{if (not "with-b" or "with-c"):yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if (("with-a") and not "with-b")}
{include if "with-b"}
session     optional      pam_keyinit.so revoke
{if "with-d":only_yes}
{exclude if "with-b" and "with-c" or "with-d" or "with-a" and "with-d" and "with-b"}
