=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 431
# a comment line {continue if not "with-d"}
session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so
    {continue if ("with-d") or "with-c"}
{include if not "with-d" and "with-a"}

account     required      pam_unix.so
{imply "with-a" if ("with-a" and "with-b")}
{include if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-c"}

=== usr/share/authselect/vendor/tprof/password-auth 447
{include if not "with-b" and "with-d" or "with-c"}
password    requisite     pam_pwquality.so {include if "with-a" and "with-d" and ("with-b") or "with-c" and "with-a"}
password    requisite     pam_pwquality.so {continue if not ("with-a") or not "with-c"} tail {exclude if "with-b"}
account     required      pam_unix.so {include if "with-d"}
session     optional      pam_keyinit.so revoke {exclude if "with-c" and "with-c" or not "with-b"}
   

=== usr/share/authselect/vendor/tprof/postlogin 320
{if "with-a"
auth        required      pam_env.so
    {if "with-d":only_yes}
{if "with-a":yes_text|no_text}
auth        required      pam_env.so {include if}
password    requisite     pam_pwquality.so {continue if ("with-c")}
password    requisite     pam_pwquality.so
    {if "with-b":only_yes} tail {stop if "with-c"}

