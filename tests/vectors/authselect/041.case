=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 78
{include if not ("with-c") or "with-b"}
account     required      pam_unix.so

=== usr/share/authselect/vendor/tprof/password-auth 246
# a comment line
auth        sufficient    pam_unix.so nullok {continue if "with-d" and "with-a"} tail {exclude if "with-c" or not "with-d" and "with-c"}
 {include if "with-a"} tail {continue if "with-c" or "with-c" and "with-b" or not "with-a"}

=== usr/share/authselect/vendor/tprof/postlogin 225
account     required      pam_unix.so {include if "with-d" or "with-b"} tail {continue if "with-b" and ("with-b")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-b"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 185
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-d" or "with-c" and "with-b":yes_text|no_text}
   
 {stop if "with-a" or "with-d"}


=== usr/share/authselect/vendor/tprof/system-auth 116
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{stop if (("with-d"))}
   


