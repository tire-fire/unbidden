account     required      pam_unix.so
=== usr/share/authselect/vendor/tprof/smartcard-auth 113
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if ("with-c"):only_yes}

=== usr/share/authselect/vendor/tprof/system-auth 569
auth        sufficient    pam_unix.so nullok
{continue if "with-c"}
# a comment line {continue if not ("with-b") and ("with-b")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
# a comment line {exclude if "with-c"}
    {include if not ("with-c" and "with-d")} tail {include if not "with-b" and "with-b" and "with-d"}
auth        sufficient    pam_unix.so nullok {continue if "with-b" and ("with-b")}
    {include if "with-a"} tail {if "with-d":yes_text|no_text}
{imply "with-a" if "with-b" and not "with-d" and (("with-d"))}
   
