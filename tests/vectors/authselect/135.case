=== usr/share/authselect/vendor/tprof/nsswitch.conf 317
{continue if not "with-d" or "with-b"}
{if "with-a":only_yes}
auth        sufficient    pam_unix.so nullok
auth        required      pam_env.so {include if "with-d"}
password    requisite     pam_pwquality.so {exclude if not "with-b"}
{exclude if "with-a"}
account     required      pam_unix.so {if "with-c":only_yes}
=== usr/share/authselect/vendor/tprof/password-auth 329
    {exclude if "with-c"}
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not "with-b" or "with-a"}
# a comment line
password    requisite     pam_pwquality.so
{include if (not ("with-b"))}
session     optional      pam_keyinit.so revoke
{exclude if "with-b"}

=== usr/share/authselect/vendor/tprof/postlogin 229
 {if "with-c":yes_text|no_text}
password    requisite     pam_pwquality.so {include if "with-c"}
{stop if "with-c"}
