=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 223
password    requisite     pam_pwquality.so {include if "with-b"}
{stop if (("with-b" or "with-c"))}
{continue if "with-c"}
auth        sufficient    pam_unix.so nullok {continue if "with-c"} tail {continue if "with-b"}
   

=== usr/share/authselect/vendor/tprof/nsswitch.conf 21
{include if "with-d"}
=== usr/share/authselect/vendor/tprof/password-auth 208

account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok
password    requisite     pam_pwquality.so {include if "with-d"}
auth        required      pam_env.so {exclude if "with-d"}

=== usr/share/authselect/vendor/tprof/postlogin 483
 {if (not "with-b") and "with-b":only_yes}
# a comment line {stop if "with-b" or "with-a" and "with-d" and "with-a"}
auth        required      pam_env.so {imply "with-d" if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if not "with-d"}
auth        required      pam_env.so
auth        required      pam_env.so
account     required      pam_unix.so
# a comment line {continue if "with-d"}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 219
auth        required      pam_env.so {if "with-d" or ("with-a") or ("with-a"):yes_text|no_text}
account     required      pam_unix.so {include if ("with-d")}
{exclude if "with-d"}
{imply "with-c" if not not ("with-c")}

=== usr/share/authselect/vendor/tprof/system-auth 493
{if "with-a":only_yes}
   
session     optional      pam_keyinit.so revoke {include if "with-c"} tail {include if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{}
    {exclude if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if ("with-b"):yes_text|no_text} tail {if "with-c":yes_text|no_text}
 {continue if not "with-c" or "with-b"}
{continue if not "with-c"}
 {continue if not "with-d"}

