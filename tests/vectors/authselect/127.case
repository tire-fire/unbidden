=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 112
session     optional      pam_keyinit.so revoke
# a comment line {if not "with-a" or "with-a":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 223
# a comment line {exclude if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if not not "with-d" or "with-b"} tail {if "with-d" and "with-c":yes_text|no_text}
   

=== usr/share/authselect/vendor/tprof/password-auth 241
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok {if "with-c" or ("with-d"):yes_text|no_text}

account     required      pam_unix.so
{stop if "with-d"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/smartcard-auth 219
    {if "with-c" and ("with-a") or not "with-c":yes_text|no_text}
session     optional      pam_keyinit.so revoke {continue if "with-a"}
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/system-auth 555
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if not (("with-a"))}
session     optional      pam_keyinit.so revoke
{if not not "with-a":yes_text|no_text}
password    requisite     pam_pwquality.so {if :x}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not "with-a"} tail {exclude if not (not "with-a")}
password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok {continue if "with-c"}
account     required      pam_unix.so
