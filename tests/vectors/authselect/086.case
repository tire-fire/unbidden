=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 245
account     required      pam_unix.so

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        sufficient    pam_unix.so nullok
{stop if "with-b"}
# a comment line
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/nsswitch.conf 456
auth        required      pam_env.so {include if (not "with-d")}
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so {if ("with-b"):only_yes}
    {stop if ("with-d")}
# a comment line {exclude if "with-c"}
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
    {if ("with-c" and "with-c" or "with-c"):yes_text|no_text}
{if "with-b":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 446
auth        required      pam_env.so {continue if ("with-a") and "with-d" or "with-a" and "with-a"}
auth        sufficient    pam_unix.so nullok {continue if (not "with-a")} tail {exclude if "with-c"}
auth        required      pam_env.so {if "with-c":only_yes}
account     required      pam_unix.so
 {if ("with-d" or ("with-d")):yes_text|no_text}
{exclude if "with-d"}
account     required      pam_unix.so {continue if (("with-d")) or "with-b"}

=== usr/share/authselect/vendor/tprof/postlogin 332
 {imply "with-b" if "with-c"}
{if "with-d" or "with-b":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
# a comment line
auth        required      pam_env.so
auth        required      pam_env.so {imply "with-a" if not "with-d"} tail {exclude if "with-b"}
 {exclude if not "with-c"} tail {continue if (not ("with-b"))}

=== usr/share/authselect/vendor/tprof/smartcard-auth 420
session     optional      pam_keyinit.so revoke
session     optional      pam_keyinit.so revoke {continue if (not "with-a" and "with-c")} tail {if :x}
password    requisite     pam_pwquality.so {if "with-d":yes_text|no_text}
{if "with-a" or not "with-a" or (not "with-a"):yes_text|no_text}
# a comment line
session     optional      pam_keyinit.so revoke {continue if "with-d" and "with-c" and "with-a" or not "with-d"}

