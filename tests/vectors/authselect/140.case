=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 527
account     required      pam_unix.so {include if not "with-a" and not "with-c" or (not "with-d")}
{continue if not "with-c"}
    {if "with-b":only_yes}
password    requisite     pam_pwquality.so {if :x}
auth        required      pam_env.so {if ("with-b") or "with-d":only_yes}
auth        sufficient    pam_unix.so nullok {exclude if not ("with-d") or not "with-d"} tail {exclude if "with-d" and "with-a" or not "with-b" or "with-d" and "with-d"}
 {continue if not "with-d" or "with-d" and "with-c"}
    {if "with-a":only_yes}
=== usr/share/authselect/vendor/tprof/nsswitch.conf 549
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if ("with-d" or "with-a" and "with-d")}
    {continue if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
 {continue if "with-c"} tail {imply "with-d" if (not ("with-a"))}
    {exclude if "with-a"}

session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok {if ("with-d" or "with-d"):yes_text|no_text}
{continue if "with-d"}

=== usr/share/authselect/vendor/tprof/password-auth 342
{if "with-b":yes_text|no_text}
{include if not "with-d"}
auth        required      pam_env.so {if not "with-a":only_yes} tail {exclude if "with-b" and "with-b" and ("with-a") and "with-c"}
# a comment line
    {stop if "with-a"}
# a comment line {include if not "with-a"}
    {continue if not "with-b" and ("with-a")} tail {stop if "with-c"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 235
