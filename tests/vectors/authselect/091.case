=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 569
# a comment line {exclude if "with-c"}
account     required      pam_unix.so
{imply "with-d" if ("with-b" or "with-d") and "with-d"}
    {if "with-c":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"} tail {include if "with-d"}
password    requisite     pam_pwquality.so {include if ("with-c" or "with-a" or not "with-b")}
account     required      pam_unix.so
account     required      pam_unix.so {include if "with-a" or "with-c"} tail {exclude if ("with-a") and "with-c" and "with-d" and "with-d"}
=== usr/share/authselect/vendor/tprof/nsswitch.conf 69
{exclude if "with-a" or "with-c" or "with-d" and (not "with-b")}
   

=== usr/share/authselect/vendor/tprof/password-auth 116
    {exclude if not not "with-a"}
# a comment line {exclude if "with-d"}
   
{if not "with-c" or "with-b":only_yes}

=== usr/share/authselect/vendor/tprof/postlogin 465
{if ("with-c" or "with-d") and "with-d":yes_text|no_text}
password    requisite     pam_pwquality.so
{stop if ("with-c")}
{exclude if "with-b"}
 {if "with-a" and "with-c":yes_text|no_text}
account     required      pam_unix.so {if ("with-c" or "with-a" or "with-d"):yes_text|no_text} tail {exclude if ("with-d" or "with-a" and "with-d" or "with-c")}
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok {exclude if "with-a" or "with-c"}
=== usr/share/authselect/vendor/tprof/smartcard-auth 196
{stop if not "with-d" and "with-d" or ("with-d" and "with-b")}
# a comment line {include if ("with-d" and "with-c" or "with-c")}
auth        sufficient    pam_unix.so nullok {continue if "with-b"}
=== usr/share/authselect/vendor/tprof/system-auth 148
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
 {include if "with-b"} tail {stop if "with-d" and "with-b"}

