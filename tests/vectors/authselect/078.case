=== usr/share/authselect/vendor/tprof/postlogin 190
{imply "with-b" if "with-a" and not "with-c"}
   
{if "with-d" or "with-d" and "with-d" or "with-a":only_yes}
auth        required      pam_env.so
password    requisite     pam_pwquality.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 406
{include if not "with-d" and "with-b" or "with-c" and "with-b" and "with-a" or "with-b"}
{exclude if "with-b" or "with-d" or "with-c" or "with-c" and "with-c" or "with-a"}
session     optional      pam_keyinit.so revoke {include if not "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if ("with-c")}
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/system-auth 601
   

auth        sufficient    pam_unix.so nullok {imply "with-a" if "with-b"} tail {continue if (("with-a" or "with-b"))}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-c"} tail {imply "with-a" if not "with-a"}
auth        sufficient    pam_unix.so nullok {if "with-b" or "with-c":only_yes}
password    requisite     pam_pwquality.so
{include if (("with-b") or ("with-b"))}
auth        required      pam_env.so {if "with-a":only_yes}
{stop if "with-a"}
auth        required      pam_env.so {continue if "with-d"} tail {include if "with-d"}

