=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 251
{if ("with-b") or "with-a":yes_text|no_text}
# a comment line
account     required      pam_unix.so {stop if "with-a"}
   
auth        sufficient    pam_unix.so nullok
auth        required      pam_env.so {imply "with-d" if "with-c"}
# a comment line

=== usr/share/authselect/vendor/tprof/postlogin 713
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-b" if (not "with-d" or "with-d")}
account     required      pam_unix.so {exclude if "with-c" or "with-d" or "with-b"} tail {continue if (not "with-c" or "with-c")}
password    requisite     pam_pwquality.so
session     optional      pam_keyinit.so revoke {include if ("with-c")} tail {include if "with-d"}
auth        sufficient    pam_unix.so nullok
=== usr/share/authselect/vendor/tprof/smartcard-auth 391
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-a" if "with-c" or "with-a" and "with-d" or not "with-d" and "with-c"} tail {include if "with-a" or "with-b"}
auth        required      pam_env.so {if "with-d":yes_text|no_text} tail {include if "with-c" and "with-b"}
 {stop if not ("with-d")}
{include if "with-c"}
{exclude if not "with-c"}
=== usr/share/authselect/vendor/tprof/system-auth 394
auth        required      pam_env.so
account     required      pam_unix.so {include if "with-d" or not not "with-d"} tail {if "with-a":yes_text|no_text}
session     optional      pam_keyinit.so revoke
account     required      pam_unix.so {continue if "with-b"}
password    requisite     pam_pwquality.so
# a comment line
    {continue if ("with-d" or "with-b" or "with-a")}
{stop if "with-c"}

