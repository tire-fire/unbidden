=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 91
auth        required      pam_env.so {imply "with-c" if not "with-d"}
{exclude if "with-c"}
=== usr/share/authselect/vendor/tprof/nsswitch.conf 391
auth        sufficient    pam_unix.so nullok {continue if "with-d"}
# a comment line
{if not "with-c":only_yes}
auth        required      pam_env.so
account     required      pam_unix.so

{continue if "with-d"}
session     optional      pam_keyinit.so revoke {if "with-b" and "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/password-auth 117
   

session     optional      pam_keyinit.so revoke
# a comment line
# a comment line {include if "with-a"} tail {}

=== usr/share/authselect/vendor/tprof/smartcard-auth 119
    {imply "with-d" if "with-d" or "with-b"}
password    requisite     pam_pwquality.so {if "with-b":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/system-auth 409
auth        required      pam_env.so {stop if "with-b" or "with-b" and "with-a"}
 {continue if not "with-d" or "with-b"}
auth        sufficient    pam_unix.so nullok
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke {if (not "with-c"):yes_text|no_text}
auth        required      pam_env.so {exclude if not "with-d" and "with-d" or ("with-a")}
{continue if "with-a"}

