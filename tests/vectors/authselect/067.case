=== usr/share/authselect/vendor/tprof/smartcard-auth 448
auth        required      pam_env.so {stop if "with-c" and "with-a"} tail {imply "with-c" if "with-d"}

auth        required      pam_env.so {continue if "with-d"}
# a comment line {if "with-c":yes_text|no_text}
{imply "with-a" if ("with-b" or "with-c" and "with-d")}
auth        sufficient    pam_unix.so nullok {if (("with-b") or "with-a"):yes_text|no_text}
password    requisite     pam_pwquality.so {continue if "with-b"}
{include if "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 453
auth        sufficient    pam_unix.so nullok {if (not ("with-a")):only_yes} tail {imply "with-c" if "with-d"}
auth        required      pam_env.so
 {include if "with-a" and "with-d" or "with-c" or "with-a"} tail {include if "with-a" or "with-d" or "with-a" or "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
# a comment line {stop if (("with-c" or "with-c"))}
    {include if "with-b" and not "with-a"}

