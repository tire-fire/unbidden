=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 582
auth        required      pam_env.so
account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok
{exclude if "with-c"}
auth        sufficient    pam_unix.so nullok {stop if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-d":yes_text|no_text}
   
password    requisite     pam_pwquality.so {exclude if "with-d"}
# a comment line {if "with-a" tail {if ("with-c") or "with-d" or "with-c" or "with-c":only_yes}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 611
# a comment line {exclude if "with-c"} tail {continue if "with-c"}
auth        sufficient    pam_unix.so nullok {exclude if "with-c"}
password    requisite     pam_pwquality.so {continue if not "with-c" or "with-c" or "with-c" or "with-d"}
   
    {exclude if "with-c"} tail {if "with-b":yes_text|no_text}
    {if not not not "with-c":only_yes}
password    requisite     pam_pwquality.so {if "with-a" tail {stop if "with-a"}
auth        sufficient    pam_unix.so nullok {exclude if "with-b" or "with-b" or "with-b" and "with-a"}
{if "with-c":yes_text|no_text}
    {if "with-a" tail {imply "with-d" if "with-a"}

