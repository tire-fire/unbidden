=== usr/share/authselect/vendor/tprof/fingerprint-auth 491
session     optional      pam_keyinit.so revoke {include if "with-c" and "with-b" and "with-c" or not "with-a"} tail {if "with-d" and "with-c":yes_text|no_text}
{if "with-d" and (not "with-c"):yes_text|no_text}
   
auth        sufficient    pam_unix.so nullok
{if ("with-c"):yes_text|no_text}
password    requisite     pam_pwquality.so {include if "with-b"}
auth        required      pam_env.so {exclude if "with-c" or "with-c"}
auth        required      pam_env.so {stop if (not "with-b")}

