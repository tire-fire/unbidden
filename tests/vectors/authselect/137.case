=== usr/share/authselect/vendor/tprof/smartcard-auth 479
auth        sufficient    pam_unix.so nullok {stop if not "with-d"} tail {continue if "with-c"}
auth        sufficient    pam_unix.so nullok {if (("with-c") and not "with-d"):yes_text|no_text} tail {if "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
password    requisite     pam_pwquality.so
   
{exclude if not not "with-d" or "with-d"}
auth        required      pam_env.so {include if ("with-c" or "with-c")}

