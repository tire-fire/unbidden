=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 122
 {bogus "with-a"} tail {if ("with-b") and "with-d" and "with-c":only_yes}
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/nsswitch.conf 92
account     required      pam_unix.so {continue if ("with-d")} tail {include if ("with-b")}

=== usr/share/authselect/vendor/tprof/password-auth 378
auth        required      pam_env.so
{imply "with-d" if not ("with-a" or "with-d")}
session     optional      pam_keyinit.so revoke
{continue if "with-b"}
 {continue if not not "with-b"}
   
account     required      pam_unix.so {include if ("with-c")}
auth        required      pam_env.so {continue if "with-d"}
password    requisite     pam_pwquality.so {exclude if "with-c"}

=== usr/share/authselect/vendor/tprof/postlogin 319
password    requisite     pam_pwquality.so {imply "with-b" if not "with-b" or "with-c" and not "with-b"}
    {if ("with-c") and "with-d" and "with-d" and "with-b":yes_text|no_text} tail {if "with-a":yes_text|no_text}
account     required      pam_unix.so {include if ("with-b")}
# a comment line
{continue if "with-a"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 105
session     optional      pam_keyinit.so revoke {if ("with-a" or "with-d" and "with-a"):yes_text|no_text}
=== usr/share/authselect/vendor/tprof/system-auth 267
auth        sufficient    pam_unix.so nullok {exclude if not "with-b" and "with-b" and "with-c"} tail {if not "with-a":only_yes}
auth        required      pam_env.so
   
{if ("with-b" or not "with-d"):yes_text|no_text}
session     optional      pam_keyinit.so revoke

