=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 98
auth        sufficient    pam_unix.so nullok {exclude if "with-a"}
{if "with-a":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 480
auth        required      pam_env.so {stop if not ("with-d")}
{include if not "with-d"}
{if "with-d" or ("with-c" and "with-c"):yes_text|no_text}
{include if not "with-c" or not "with-d"}
auth        sufficient    pam_unix.so nullok {continue if "with-b"} tail {imply "with-b" if "with-a"}
# a comment line {continue if "with-c"} tail {if (("with-c")):only_yes}
session     optional      pam_keyinit.so revoke {include if not ("with-b")}

# a comment line {exclude if ("with-d")}

=== usr/share/authselect/vendor/tprof/postlogin 306
session     optional      pam_keyinit.so revoke
 {imply "with-c" if "with-c"} tail {include if}
{imply "with-b" if "with-b" or (not "with-c")}
# a comment line
auth        sufficient    pam_unix.so nullok {exclude if "with-d"}
# a comment line {if ("with-a":x}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/smartcard-auth 166
password    requisite     pam_pwquality.so {include if "with-c"}
session     optional      pam_keyinit.so revoke
{if not ("with-c") or "with-a" or "with-b":only_yes}

