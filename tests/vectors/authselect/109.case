=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 690
{continue if not "with-a" and not "with-b"}
{if "with-c":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {include if not "with-a" and "with-d" or "with-a"}
    {include if not "with-d"} tail {stop if "with-b"}
   
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if (not "with-b")} tail {if not "with-d" or "with-d" and "with-d":yes_text|no_text}
auth        required      pam_env.so
session     optional      pam_keyinit.so revoke
{include if "with-d" and "with-b" or "with-d" and "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-a"} tail {continue if "with-d"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 75
 {include if "with-d" and "with-b" or "with-c"} tail {exclude if "with-c"}

=== usr/share/authselect/vendor/tprof/postlogin 477
{if "with-d":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{if not not "with-c" and "with-d" and not "with-c":only_yes}
# a comment line
password    requisite     pam_pwquality.so {if "with-a" and "with-c" and "with-d" and "with-d":yes_text|no_text}
# a comment line
password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok
{continue if "with-c"}
session     optional      pam_keyinit.so revoke
=== usr/share/authselect/vendor/tprof/smartcard-auth 141

auth        required      pam_env.so
    {include if}
password    requisite     pam_pwquality.so
    {exclude if "with-b" and not "with-d"}

=== usr/share/authselect/vendor/tprof/system-auth 271
# a comment line {include if "with-b"}
{if not "with-b" and "with-a":yes_text|no_text}
{exclude if not ("with-a")}
{if ("with-d" and "with-d") or "with-d" or "with-b" or "with-b" and "with-b":yes_text|no_text}
auth        required      pam_env.so {include if ("with-d")}

