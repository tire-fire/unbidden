=== usr/share/authselect/vendor/tprof/system-auth 293
{stop if "with-c" and ("with-b") and "with-b"}
 {exclude if "with-c"} tail {include if ("with-d")}
{include if "with-c" and "with-c" and "with-b" or not "with-a" or "with-c"}
