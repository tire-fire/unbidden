=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 425
# a comment line {if "with-c":yes_text|no_text}
auth        required      pam_env.so {continue if not not "with-c"} tail {exclude if "with-c"}
account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so {stop if not "with-b" and "with-d" or "with-d"}
account     required      pam_unix.so {if "with-c":yes_text|no_text} tail {continue if "with-b"}
# a comment line
=== usr/share/authselect/vendor/tprof/nsswitch.conf 458
{continue if "with-c"}
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-a"} tail {include if not "with-c"}
# a comment line {exclude if not "with-d" or "with-a" or "with-b"} tail {continue if ("with-a")}
{stop if "with-b"}
auth        sufficient    pam_unix.so nullok {if ("with-a":x} tail {if not not "with-b":only_yes}
# a comment line {if ("with-d"):only_yes}

=== usr/share/authselect/vendor/tprof/password-auth 193
 {imply "with-b" if ("with-c")}
# a comment line
auth        sufficient    pam_unix.so nullok {if "with-c":yes_text|no_text}
auth        required      pam_env.so {continue if not not "with-c"}

=== usr/share/authselect/vendor/tprof/postlogin 241
   
{if not not "with-b" and ("with-c") and "with-d" or "with-c":only_yes}
{include if "with-a"}
# a comment line
auth        required      pam_env.so {if ("with-d"):only_yes}
auth        required      pam_env.so {imply "with-b" if "with-a"}
=== usr/share/authselect/vendor/tprof/smartcard-auth 307
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
password    requisite     pam_pwquality.so {if "with-d" or "with-b" or "with-b" and "with-a":yes_text|no_text}
auth        required      pam_env.so
{continue if "with-c"}
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/system-auth 241
password    requisite     pam_pwquality.so {if "with-b" or not "with-a" and "with-a":yes_text|no_text} tail {exclude if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":only_yes}

