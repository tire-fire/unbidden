=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 487
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-a"} tail {include if "with-d"}
auth        required      pam_env.so {exclude if "with-c" or not "with-b" or "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":only_yes} tail {exclude if "with-c" or "with-b" or "with-a" and "with-c"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 518
auth        required      pam_env.so {if "with-b":yes_text|no_text} tail {if "with-c":yes_text|no_text}
# a comment line {stop if not "with-d"} tail {include if "with-a"}
{continue if "with-c" or "with-a" or "with-d" or "with-a" or "with-d" or "with-a"}
{include if not "with-d"}
session     optional      pam_keyinit.so revoke {if "with-b":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {exclude if not "with-a" or "with-b"}
account     required      pam_unix.so {include if not "with-b" or "with-a"}

=== usr/share/authselect/vendor/tprof/password-auth 282
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{stop if not "with-a"}
auth        sufficient    pam_unix.so nullok {imply "with-b" if "with-d" and "with-b" or "with-d" and "with-a"}
# a comment line
=== usr/share/authselect/vendor/tprof/postlogin 218
{imply "with-a" if not not "with-c" and not "with-c"}
password    requisite     pam_pwquality.so {if ("with-d"):yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/smartcard-auth 248
{stop if not "with-c"}
auth        sufficient    pam_unix.so nullok
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
   
session     optional      pam_keyinit.so revoke {continue if not "with-c" and "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 499
password    requisite     pam_pwquality.so {stop if "with-d"}
   

account     required      pam_unix.so {if ("with-b"):yes_text|no_text}
password    requisite     pam_pwquality.so {include if "with-a"}
session     optional      pam_keyinit.so revoke {exclude if "with-d"}
account     required      pam_unix.so
password    requisite     pam_pwquality.so {include if "with-b"}
# a comment line
auth        required      pam_env.so {if "with-b" or ("with-c"):yes_text|no_text} tail {stop if "with-d"}

