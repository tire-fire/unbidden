=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 413
# a comment line
    {exclude if "with-a"}
 {continue if not not "with-d"}
account     required      pam_unix.so {exclude if "with-b"}
password    requisite     pam_pwquality.so
auth        required      pam_env.so {imply "with-d" if ("with-b")} tail {stop if not "with-a" or not not "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 124
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d" or ("with-d")}

=== usr/share/authselect/vendor/tprof/postlogin 433
session     optional      pam_keyinit.so revoke
{imply "with-b" if "with-b"}
 {continue if (not "with-a" or "with-b")} tail {include if not "with-a"}
 {continue if ("with-c") and "with-c" or "with-a"} tail {if ("with-a"):only_yes}
auth        required      pam_env.so
    {stop if ("with-d")}
password    requisite     pam_pwquality.so {if "with-a" or "with-d" or not "with-d" and (not "with-c"):only_yes} tail {include if "with-b"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 472
account     required      pam_unix.so {exclude if ("with-b" and "with-d" and not "with-d")}
auth        required      pam_env.so
 {include if not "with-b" or ("with-c")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if :x}
auth        required      pam_env.so {include if (not "with-c" or "with-b")}
# a comment line
account     required      pam_unix.so {exclude if ("with-d" and "with-b") or "with-b" and "with-d" or "with-d"}

