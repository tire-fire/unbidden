=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 462
{stop if "with-d"}
{if "with-a" and not not "with-c":only_yes}
account     required      pam_unix.so {stop if "with-d"}
session     optional      pam_keyinit.so revoke {stop if "with-c" and "with-c" and "with-b"} tail {exclude if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {bogus "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-a" if "with-b"}

=== usr/share/authselect/vendor/tprof/password-auth 202
{continue if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{if "with-b" and "with-a" and "with-c" or "with-a":yes_text|no_text}
 {exclude if "with-d"}
=== usr/share/authselect/vendor/tprof/postlogin 231
{imply "with-b" if "with-c" and ("with-c") and not "with-b" or "with-b"}

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-c":only_yes} tail {include if "with-c" and not ("with-d")}

=== usr/share/authselect/vendor/tprof/smartcard-auth 514
session     optional      pam_keyinit.so revoke {exclude if "with-d"}
auth        required      pam_env.so {stop if ("with-a" or "with-d") or "with-d"}
# a comment line {if ("with-d" or "with-b") or (not "with-c"):only_yes} tail {include if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b":only_yes}
account     required      pam_unix.so {if not "with-d" or not "with-d" or not "with-d" and "with-c" or "with-b":yes_text|no_text}
{exclude if "with-c"}

=== usr/share/authselect/vendor/tprof/system-auth 201
session     optional      pam_keyinit.so revoke
# a comment line
password    requisite     pam_pwquality.so {if "with-c":yes_text|no_text} tail {exclude if not "with-b"}
{imply "with-a" if ("with-a")}

