=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 24
{continue if "with-d"}


=== usr/share/authselect/vendor/tprof/nsswitch.conf 331
session     optional      pam_keyinit.so revoke
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if ("with-a") and "with-c"} tail {exclude if not "with-d" and "with-b"}
auth        required      pam_env.so
auth        required      pam_env.so
password    requisite     pam_pwquality.so

=== usr/share/authselect/vendor/tprof/password-auth 228
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok {include if ("with-d")}
    {imply "with-b" if "with-d" and ("with-a")}
    {if "with-d":yes_text|no_text}
    {exclude if ("with-c")}

=== usr/share/authselect/vendor/tprof/postlogin 270
{continue if (("with-a") or "with-d" and "with-c")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-a":yes_text|no_text} tail {if "with-a" and "with-d":only_yes}
    {if not "with-d":only_yes}
 {exclude if "with-b"}

=== usr/share/authselect/vendor/tprof/system-auth 473
auth        required      pam_env.so {exclude if (("with-d")) and not "with-b" or "with-c"}
{include if "with-d"}
auth        sufficient    pam_unix.so nullok {include if not "with-d"}
 {if not ("with-b") or "with-d":only_yes}
# a comment line {include if "with-c"}
account     required      pam_unix.so {if "with-c":yes_text|no_text}
password    requisite     pam_pwquality.so
{continue if not ("with-d")}
password    requisite     pam_pwquality.so {if "with-c":only_yes}

