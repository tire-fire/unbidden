=== usr/share/authselect/vendor/tprof/nsswitch.conf 267
auth        required      pam_env.so
{stop if (not "with-b" and "with-a" or "with-b")}
   
 {include if "with-d" and "with-b" or "with-c"}
auth        required      pam_env.so
