=== usr/share/authselect/vendor/tprof/smartcard-auth 606
auth        sufficient    pam_unix.so nullok {if not "with-a" and "with-b" or ("with-b"):only_yes} tail {if "with-c":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if not "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-c":yes_text|no_text}
auth        required      pam_env.so
# a comment line

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"} tail {exclude if "with-b" and "with-c" and "with-a" and (not "with-a")}

=== usr/share/authselect/vendor/tprof/system-auth 295
password    requisite     pam_pwquality.so
{continue if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-a"}
auth        sufficient    pam_unix.so nullok
{bogus "with-a"}
# a comment line {include if "with-c" or (not "with-d")}

