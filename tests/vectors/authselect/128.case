=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 413
auth        required      pam_env.so
account     required      pam_unix.so {include if not "with-d" or "with-c" and "with-a" and "with-d"}
password    requisite     pam_pwquality.so {exclude if "with-a"}
session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so
{if "with-a":yes_text|no_text}
{imply "with-a" if not "with-b"}
   
{exclude if ("with-a")}
{include if not "with-b"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 59
account     required      pam_unix.so {include if "with-a"}
=== usr/share/authselect/vendor/tprof/password-auth 122
auth        required      pam_env.so
auth        required      pam_env.so {if "with-c" and not "with-b":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/postlogin 93
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/smartcard-auth 195
{if not not "with-d" or "with-d":yes_text|no_text}
   
   
session     optional      pam_keyinit.so revoke
account     required      pam_unix.so {continue if not not ("with-b")}
# a comment line

=== usr/share/authselect/vendor/tprof/system-auth 247
auth        required      pam_env.so

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-b"}
auth        required      pam_env.so {imply "with-c" if "with-b"} tail {imply "with-b" if "with-c"}
