=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 48
{include if ("with-b")}
{exclude if ("with-c")}

=== usr/share/authselect/vendor/tprof/password-auth 567
password    requisite     pam_pwquality.so {stop if ("with-b" or "with-a" and "with-d" or "with-d")}
# a comment line
session     optional      pam_keyinit.so revoke
{continue if (("with-a") and "with-d")}
{imply "with-b" if "with-c" and "with-d"}
   
 {include if "with-c" and ("with-b" and "with-a")}
session     optional      pam_keyinit.so revoke {include if ("with-a" or "with-b" and "with-c")}
 {continue if "with-c"}
session     optional      pam_keyinit.so revoke {exclude if "with-a" and "with-c" and ("with-a" and "with-a")} tail {continue if not "with-d"}

=== usr/share/authselect/vendor/tprof/postlogin 156
{imply "with-b" if ("with-a")}
password    requisite     pam_pwquality.so {exclude if not "with-b"}

   
auth        required      pam_env.so {include if}


=== usr/share/authselect/vendor/tprof/smartcard-auth 115
account     required      pam_unix.so
# a comment line
auth        required      pam_env.so
{continue if "with-d"}

=== usr/share/authselect/vendor/tprof/system-auth 229
{exclude if "with-b" or "with-b" and "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if (("with-c")):yes_text|no_text}
{include if (not ("with-d"))}
{imply "with-c" if "with-d"}

