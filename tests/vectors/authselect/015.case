=== usr/share/authselect/vendor/tprof/password-auth 171
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so
# a comment line
{if "with-b":only_yes}

=== usr/share/authselect/vendor/tprof/postlogin 505
{continue if "with-b"}
{continue if "with-d"}
 {exclude if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"}
{include if "with-d" and ("with-a" or "with-a")}
session     optional      pam_keyinit.so revoke {if not "with-c" and "with-b" and "with-c" and "with-b" or "with-d":yes_text|no_text} tail {if not ("with-d") and "with-b":yes_text|no_text}
 {imply "with-c" if not "with-b"} tail {if "with-d" and ("with-c") or "with-a":only_yes}
=== usr/share/authselect/vendor/tprof/smartcard-auth 146
account     required      pam_unix.so {continue if "with-c"}
# a comment line

auth        sufficient    pam_unix.so nullok
{include if "with-c"}

=== usr/share/authselect/vendor/tprof/system-auth 95
 {if ("with-a":x}
    {exclude if "with-a" or "with-d" and "with-a"}
{continue if not "with-a"}
