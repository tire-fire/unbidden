=== usr/share/authselect/vendor/tprof/fingerprint-auth 22
{continue if "with-d"}
=== usr/share/authselect/vendor/tprof/nsswitch.conf 174
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so
