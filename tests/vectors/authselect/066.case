=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 81
account     required      pam_unix.so {if "with-d" and "with-c":yes_text|no_text}
=== usr/share/authselect/vendor/tprof/nsswitch.conf 25
{exclude if "with-d"}
   
=== usr/share/authselect/vendor/tprof/password-auth 186
    {imply "with-d" if "with-d" or "with-a"} tail {include if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-a":only_yes}
=== usr/share/authselect/vendor/tprof/postlogin 409
    {continue if ("with-c")}
session     optional      pam_keyinit.so revoke
{exclude if ((("with-b")))}
session     optional      pam_keyinit.so revoke {stop if ("with-b")}
account     required      pam_unix.so {if "with-d":yes_text|no_text} tail {include if not "with-b"}
# a comment line {if ("with-d") or "with-a" or "with-a" and "with-b" or "with-c":yes_text|no_text} tail {if not (("with-d")):only_yes}

=== usr/share/authselect/vendor/tprof/smartcard-auth 744
auth        sufficient    pam_unix.so nullok {if "with-b" or "with-b" and not "with-c" or "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
account     required      pam_unix.so
session     optional      pam_keyinit.so revoke {stop if not "with-a"} tail {if "with-d":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {stop if "with-b" and "with-d"} tail {stop if "with-b"}
    {imply "with-d" if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-b"}
# a comment line {exclude if "with-b"}

=== usr/share/authselect/vendor/tprof/system-auth 618
auth        required      pam_env.so {continue if not "with-d"}
auth        required      pam_env.so {if "with-c" or "with-b":yes_text|no_text}
# a comment line {include if ("with-b")}
# a comment line {if ("with-b"):yes_text|no_text} tail {stop if "with-a" and ("with-b")}
auth        required      pam_env.so {include if "with-c"}
auth        sufficient    pam_unix.so nullok {exclude if ("with-a")}
password    requisite     pam_pwquality.so {exclude if not "with-d"}
# a comment line {stop if ("with-d")}
{stop if "with-d"}
auth        required      pam_env.so {stop if "with-b"} tail {imply "with-b" if "with-b"}

