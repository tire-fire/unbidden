=== usr/share/authselect/vendor/tprof/postlogin 381
{include if "with-a"}
account     required      pam_unix.so

{if "with-a":yes_text|no_text}
 {if not "with-d":yes_text|no_text} tail {if ("with-a":x}
password    requisite     pam_pwquality.so {continue if not "with-d"}
 {continue if "with-c"}
auth        sufficient    pam_unix.so nullok {continue if "with-d" or "with-d"}
account     required      pam_unix.so {stop if "with-b"}

=== usr/share/authselect/vendor/tprof/system-auth 307
{if "with-a" or "with-d":yes_text|no_text}

auth        sufficient    pam_unix.so nullok
auth        required      pam_env.so {exclude if "with-d"}
# a comment line
password    requisite     pam_pwquality.so {if "with-b":only_yes}
# a comment line {exclude if "with-b" or "with-a" or "with-d" and "with-c"}

