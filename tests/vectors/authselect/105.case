=== usr/share/authselect/vendor/tprof/smartcard-auth 499
account     required      pam_unix.so {} tail {exclude if ("with-a") or not "with-a" or ("with-d")}
auth        sufficient    pam_unix.so nullok
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
 {include if "with-c"}
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok {continue if "with-d"} tail {imply "with-b" if "with-c"}
{if "with-d":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
# a comment line

=== usr/share/authselect/vendor/tprof/system-auth 319
auth        sufficient    pam_unix.so nullok {include if not "with-b"} tail {if not "with-c":yes_text|no_text}
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok
auth        required      pam_env.so {exclude if not "with-a" and "with-c"}

{exclude if (("with-a") or "with-d" or "with-c")}
