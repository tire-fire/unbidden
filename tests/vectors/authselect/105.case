=== usr/share/authselect/vendor/tprof/postlogin 347
auth        sufficient    pam_unix.so nullok
password    requisite     pam_pwquality.so {include if}
# a comment line {stop if (("with-d") or "with-a")}
 {continue if "with-a" and ("with-b")} tail {continue if "with-a"}
