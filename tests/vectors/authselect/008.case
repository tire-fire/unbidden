=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 295
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        sufficient    pam_unix.so nullok {exclude if "with-c"} tail {continue if "with-c"}
account     required      pam_unix.so {if "with-d":yes_text|no_text} tail {exclude if not "with-c" or "with-d"}

=== usr/share/authselect/vendor/tprof/password-auth 302
auth        required      pam_env.so {if "with-c" and "with-d":only_yes} tail {include if "with-a"}
# a comment line
{stop if "with-c"}
{if "with-b":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-d" if "with-a"}
{exclude if not "with-a"}

=== usr/share/authselect/vendor/tprof/postlogin 328
password    requisite     pam_pwquality.so {imply "with-d" if not "with-a" and "with-a"}
session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so {bogus "with-a"} tail {continue if not "with-d"}
{include if ("with-d")}
password    requisite     pam_pwquality.so {if ("with-d"):yes_text|no_text}
=== usr/share/authselect/vendor/tprof/smartcard-auth 342
account     required      pam_unix.so
{if not ("with-c"):only_yes}

 {include if "with-b"}
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke {include if "with-d" or "with-b"}
# a comment line {include if "with-c"}
auth        required      pam_env.so
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/system-auth 241
auth        required      pam_env.so {if "with-d":only_yes}
    {exclude if "with-c" or ("with-b") or "with-d"}
    {stop if "with-b"}
    {exclude if "with-a"} tail {imply "with-a" if (("with-b"))}
password    requisite     pam_pwquality.so
