=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 392
session     optional      pam_keyinit.so revoke
 {exclude if "with-b"} tail {include if "with-c"}
# a comment line
# a comment line
# a comment line
{}
password    requisite     pam_pwquality.so {if "with-c":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-b" if not ("with-b")}
    {if not "with-c" or "with-d":only_yes}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 257
password    requisite     pam_pwquality.so {exclude if not "with-c"} tail {if "with-c" or "with-b" and "with-a" and ("with-a"):yes_text|no_text}
{if "with-d" or "with-d":yes_text|no_text}
account     required      pam_unix.so {if "with-b":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/postlogin 502
# a comment line {if "with-a":yes_text|no_text} tail {imply "with-a" if ("with-a")}
auth        required      pam_env.so {if "with-a" tail {exclude if not "with-c"}
    {imply "with-a" if "with-b"}
{if (("with-c")):yes_text|no_text}
auth        required      pam_env.so
{continue if "with-c"}
 {exclude if "with-c" or "with-c"}
session     optional      pam_keyinit.so revoke {include if "with-b" or "with-b" or "with-d" and not "with-d"} tail {continue if "with-a"}
{if not "with-c":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/smartcard-auth 491
# a comment line
auth        required      pam_env.so
password    requisite     pam_pwquality.so
# a comment line {include if "with-b" and ("with-a") or "with-c"}
auth        sufficient    pam_unix.so nullok {imply "with-d" if "with-a" and "with-b" and "with-c" or "with-d"} tail {continue if "with-c"}

 {include if ("with-d")} tail {stop if "with-b"}
password    requisite     pam_pwquality.so {include if "with-c"} tail {if "with-d":yes_text|no_text}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/system-auth 739
   
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if not "with-b" and ("with-d")}
# a comment line {include if "with-a"} tail {stop if not "with-d" or "with-d"}
auth        sufficient    pam_unix.so nullok {include if "with-d" and "with-b"}
auth        required      pam_env.so {if "with-b":only_yes}
account     required      pam_unix.so {continue if "with-b" or not "with-a"}
session     optional      pam_keyinit.so revoke {include if "with-a" and "with-c"}
password    requisite     pam_pwquality.so
auth        required      pam_env.so {imply "with-b" if not ("with-a") or ("with-b")}
session     optional      pam_keyinit.so revoke {include if "with-c"} tail {exclude if "with-b"}

