=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 108
session     optional      pam_keyinit.so revoke {if "with-d":only_yes}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/password-auth 446
auth        required      pam_env.so
account     required      pam_unix.so {include if "with-b"} tail {if not "with-b" or "with-a":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so
   
{stop if ("with-a")}
{include if "with-d" and "with-a"}
{include if "with-c"}
auth        required      pam_env.so
{exclude if ("with-b") and "with-d" or "with-a" and "with-c"}
=== usr/share/authselect/vendor/tprof/postlogin 462

# a comment line {if (not "with-c"):yes_text|no_text}
auth        sufficient    pam_unix.so nullok {exclude if (("with-c")) or "with-b" and "with-d" and "with-b"}
auth        sufficient    pam_unix.so nullok {include if "with-a"} tail {imply "with-b" if "with-b"}
{include if "with-c" or ("with-a") or "with-d"}
{continue if "with-a"}
{imply "with-b" if (("with-d"))}
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/smartcard-auth 121
password    requisite     pam_pwquality.so {continue if not "with-d" and not "with-b"} tail {continue if (not "with-b")}

=== usr/share/authselect/vendor/tprof/system-auth 253
session     optional      pam_keyinit.so revoke
{include if "with-c"}
session     optional      pam_keyinit.so revoke {stop if not "with-c"}
{include if ("with-b")}
auth        sufficient    pam_unix.so nullok
password    requisite     pam_pwquality.so

