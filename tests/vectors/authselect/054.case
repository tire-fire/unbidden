=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 455
auth        required      pam_env.so
   
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-d"}
auth        sufficient    pam_unix.so nullok {exclude if "with-a"}
account     required      pam_unix.so
auth        required      pam_env.so
account     required      pam_unix.so {include if not "with-c" or "with-d" or "with-d" or ("with-b")} tail {if "with-c":yes_text|no_text}

 {exclude if "with-d"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 444
{continue if ("with-a" and "with-c" or "with-a")}

account     required      pam_unix.so
password    requisite     pam_pwquality.so {imply "with-a" if (("with-b" or "with-a"))}
auth        required      pam_env.so {if "with-d":yes_text|no_text}
auth        required      pam_env.so {exclude if "with-d"}
session     optional      pam_keyinit.so revoke {if "with-b":only_yes}
auth        sufficient    pam_unix.so nullok {exclude if ("with-a")}

=== usr/share/authselect/vendor/tprof/password-auth 172
session     optional      pam_keyinit.so revoke {if "with-c":only_yes}
{stop if ("with-b")}
password    requisite     pam_pwquality.so {imply "with-c" if not not "with-c"}

=== usr/share/authselect/vendor/tprof/postlogin 170
# a comment line
session     optional      pam_keyinit.so revoke {exclude if "with-b"} tail {include if not ("with-c")}
{if ("with-c"):only_yes}
{continue if ("with-d")}

=== usr/share/authselect/vendor/tprof/smartcard-auth 569
# a comment line
{exclude if ("with-d") or "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
password    requisite     pam_pwquality.so {exclude if "with-d"}
account     required      pam_unix.so {stop if "with-b"} tail {include if "with-b" and not "with-a" and "with-d"}
session     optional      pam_keyinit.so revoke
{include if "with-d"}
{continue if "with-d"}
session     optional      pam_keyinit.so revoke {imply "with-b" if "with-c"}
session     optional      pam_keyinit.so revoke {if "with-c":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/system-auth 254
# a comment line {if "with-b":yes_text|no_text} tail {imply "with-a" if "with-c"}
 {continue if not "with-a" and "with-b" and "with-c"}
auth        sufficient    pam_unix.so nullok
auth        required      pam_env.so {if "with-a"
   
{stop if "with-b"}

