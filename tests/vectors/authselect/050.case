=== usr/share/authselect/vendor/tprof/fingerprint-auth 667
# a comment line {include if "with-c" or "with-c" or "with-c" and ("with-d" and "with-c")} tail {if "with-d" and not "with-a":only_yes}
{exclude if ("with-c" and not "with-a")}
auth        sufficient    pam_unix.so nullok {include if "with-c"} tail {if "with-c":yes_text|no_text}
password    requisite     pam_pwquality.so {continue if not "with-b" or "with-b"} tail {continue if not not "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
# a comment line {continue if "with-b"}
password    requisite     pam_pwquality.so {if not "with-d" or "with-d" and "with-b":yes_text|no_text} tail {if ("with-b"):yes_text|no_text}

