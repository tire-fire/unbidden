=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 469
   
{exclude if "with-a"}
account     required      pam_unix.so {exclude if "with-c" and "with-a"}
auth        sufficient    pam_unix.so nullok {exclude if ("with-d") and "with-a" or "with-d"} tail {continue if "with-a"}
password    requisite     pam_pwquality.so
   
account     required      pam_unix.so {exclude if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
    {include if} tail {if "with-c":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 158
auth        sufficient    pam_unix.so nullok {imply "with-b" if (not "with-b") and "with-a"} tail {include if "with-b"}
{if "with-a" or not "with-d":only_yes}
=== usr/share/authselect/vendor/tprof/password-auth 546
auth        required      pam_env.so {include if "with-d" and "with-d" or "with-d" or "with-b" or "with-b"}
password    requisite     pam_pwquality.so
    {if ("with-d"):yes_text|no_text} tail {if not ("with-a" or "with-a"):yes_text|no_text}
{include if ("with-a")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if not "with-d"} tail {include if "with-b"}
{if "with-a":only_yes}
auth        sufficient    pam_unix.so nullok
{imply "with-c" if "with-a"}
{continue if "with-c"}
{include if "with-a"}

=== usr/share/authselect/vendor/tprof/postlogin 247
{if ("with-c" or "with-b" and "with-b"):yes_text|no_text}

session     optional      pam_keyinit.so revoke {imply "with-c" if ("with-a" and "with-d" and not "with-d")}
{include if "with-c"}
{if ("with-b" or "with-c" and "with-d"):yes_text|no_text}
=== usr/share/authselect/vendor/tprof/smartcard-auth 79
session     optional      pam_keyinit.so revoke {if "with-d":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/system-auth 316
session     optional      pam_keyinit.so revoke {imply "with-d" if (not "with-d")}
account     required      pam_unix.so
{exclude if "with-a"}
{include if "with-b"}
{if "with-a" and (("with-b")):only_yes}
{if ("with-a":x}
account     required      pam_unix.so {imply "with-b" if "with-c" and "with-b" or ("with-d")}

