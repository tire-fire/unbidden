=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 134
auth        required      pam_env.so
account     required      pam_unix.so {continue if "with-a"} tail {imply "with-c" if ("with-b")}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 462
auth        required      pam_env.so {include if ("with-b")}
password    requisite     pam_pwquality.so
# a comment line
password    requisite     pam_pwquality.so
# a comment line {continue if not "with-c" and "with-b" and "with-a"}
auth        sufficient    pam_unix.so nullok {include if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if ("with-c") and not not "with-c"} tail {exclude if "with-a"}

=== usr/share/authselect/vendor/tprof/password-auth 597
password    requisite     pam_pwquality.so {exclude if "with-b"}
# a comment line {if (not "with-b" or ("with-a")):yes_text|no_text} tail {include if not not "with-c" or "with-c"}
 {exclude if (not "with-c") and "with-b"} tail {if "with-c" and ("with-b") or "with-c":yes_text|no_text}
account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok
auth        sufficient    pam_unix.so nullok
password    requisite     pam_pwquality.so
password    requisite     pam_pwquality.so {if "with-a":yes_text|no_text}
session     optional      pam_keyinit.so revoke {stop if "with-b"}

=== usr/share/authselect/vendor/tprof/postlogin 310
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-b" if "with-a"} tail {include if not "with-d" and "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if :x} tail {if "with-c":yes_text|no_text}

