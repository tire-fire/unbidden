=== usr/share/authselect/vendor/tprof/fingerprint-auth 72
auth        required      pam_env.so {if not "with-a":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 455
{include if ("with-b") or "with-d" or "with-d" and "with-b"}
{if :x}

account     required      pam_unix.so {include if ("with-d")}
auth        sufficient    pam_unix.so nullok {continue if "with-c"}
{exclude if "with-b"}
auth        sufficient    pam_unix.so nullok {if ("with-c") or "with-a":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
{include if ("with-c") or "with-c" and not "with-d"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/password-auth 348
auth        required      pam_env.so {exclude if "with-d"}
auth        sufficient    pam_unix.so nullok



auth        sufficient    pam_unix.so nullok {if "with-b" or ("with-b") or not not "with-c":yes_text|no_text}
session     optional      pam_keyinit.so revoke
    {exclude if "with-c"} tail {if not ("with-b") or "with-c":yes_text|no_text}
{}

=== usr/share/authselect/vendor/tprof/postlogin 142
auth        sufficient    pam_unix.so nullok {continue if "with-b" and ("with-d") and "with-b"}
{imply "with-a" if "with-d" and (("with-b"))}

=== usr/share/authselect/vendor/tprof/smartcard-auth 703
{include if "with-d"}
account     required      pam_unix.so {continue if not "with-d" or "with-c" and "with-a" and "with-c"}
password    requisite     pam_pwquality.so {stop if "with-b" and "with-d"} tail {continue if not "with-b"}
session     optional      pam_keyinit.so revoke {if :x}
{imply "with-b" if "with-d"}
session     optional      pam_keyinit.so revoke {continue if "with-c"}
password    requisite     pam_pwquality.so {continue if "with-a" or not "with-a" and "with-a"}
auth        sufficient    pam_unix.so nullok {include if not not "with-a" and "with-c"} tail {if ("with-c") and "with-c" or "with-b" and "with-a":only_yes}
   
password    requisite     pam_pwquality.so {bogus "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 176
{if "with-d":only_yes}
session     optional      pam_keyinit.so revoke {continue if "with-a"}
