=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 325
account     required      pam_unix.so {include if "with-d"}
auth        required      pam_env.so {include if "with-b"}
account     required      pam_unix.so {if "with-b":only_yes} tail {if "with-a":only_yes}
auth        sufficient    pam_unix.so nullok {exclude if "with-a" and "with-d"}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/password-auth 391
auth        required      pam_env.so {exclude if not "with-b" or "with-a"}
auth        required      pam_env.so {continue if "with-d" and "with-c" or "with-a"}
    {if "with-d":yes_text|no_text} tail {include if}
 {imply "with-b" if "with-c" and "with-a" and "with-a" or "with-a" and not "with-d"}
# a comment line
{include if "with-a"}
# a comment line
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 102
account     required      pam_unix.so {include if "with-c"} tail {if ("with-d") or "with-d":only_yes}

=== usr/share/authselect/vendor/tprof/system-auth 65
