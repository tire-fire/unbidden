=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 429
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if :x} tail {if "with-c":only_yes}
{stop if "with-c"}
account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok
# a comment line {continue if not "with-d" or "with-c" and not "with-c" and "with-d"} tail {exclude if "with-c"}
{exclude if ("with-c") and "with-b" or "with-c"}
{if "with-a"
 {continue if not "with-c"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 166
    {exclude if "with-a" and not "with-c" or ("with-d") or not "with-b"} tail {imply "with-c" if "with-d"}
account     required      pam_unix.so {include if "with-a"}
=== usr/share/authselect/vendor/tprof/password-auth 275
{if "with-c":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if (("with-c")) or "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-c"}
# a comment line
=== usr/share/authselect/vendor/tprof/postlogin 615

auth        required      pam_env.so {continue if "with-c"} tail {exclude if "with-d"}
auth        sufficient    pam_unix.so nullok
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if ("with-c" and "with-d") or not not "with-c"}
auth        sufficient    pam_unix.so nullok {include if ("with-b" or "with-c") and "with-a"}
{continue if "with-a" or "with-d" or "with-b" and ("with-a")}
account     required      pam_unix.so
# a comment line {if "with-a":only_yes}
 {if "with-b":only_yes} tail {imply "with-c" if not not "with-d"}
account     required      pam_unix.so
=== usr/share/authselect/vendor/tprof/smartcard-auth 107
   
