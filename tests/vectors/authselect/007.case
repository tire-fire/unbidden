=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 366
auth        required      pam_env.so
{exclude if "with-b"}
auth        sufficient    pam_unix.so nullok
{stop if "with-c"}
auth        required      pam_env.so {if "with-b":yes_text|no_text}
session     optional      pam_keyinit.so revoke
 {if "with-a":yes_text|no_text} tail {continue if "with-a"}
# a comment line {exclude if ("with-b" and "with-b" and "with-c")}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 229
account     required      pam_unix.so {stop if "with-a"} tail {include if ("with-d")}
auth        required      pam_env.so {continue if ("with-b")}
auth        required      pam_env.so {if "with-b":only_yes}
{include if "with-d"}
=== usr/share/authselect/vendor/tprof/password-auth 461
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b":only_yes}
password    requisite     pam_pwquality.so {include if ("with-d")} tail {include if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke {continue if "with-a"} tail {bogus "with-a"}
# a comment line {include if ("with-b")} tail {imply "with-a" if "with-b"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 352
auth        sufficient    pam_unix.so nullok {if "with-a" and ("with-a"):yes_text|no_text}
auth        sufficient    pam_unix.so nullok {if not "with-a":yes_text|no_text} tail {if "with-a" and "with-a" and "with-a" or "with-d" and "with-b":yes_text|no_text}
{exclude if "with-d"}

# a comment line {include if not "with-b" or not "with-d" or "with-c"}

=== usr/share/authselect/vendor/tprof/system-auth 190
# a comment line
password    requisite     pam_pwquality.so {if (not "with-c"):only_yes} tail {continue if not "with-b"}
account     required      pam_unix.so {if "with-a":yes_text|no_text}

