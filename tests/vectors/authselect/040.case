=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 418
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if ("with-d" or "with-c" or "with-a")}
# a comment line {stop if not not "with-c" and not "with-c"}
account     required      pam_unix.so
{if not "with-a":yes_text|no_text}
{include if "with-d" or "with-d" and "with-d" and "with-c"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 279
auth        required      pam_env.so {continue if not "with-a"}

{include if ("with-a") or "with-a"}
session     optional      pam_keyinit.so revoke {include if not "with-d" or not "with-b"}
# a comment line
session     optional      pam_keyinit.so revoke {stop if not "with-a"}

=== usr/share/authselect/vendor/tprof/postlogin 376
# a comment line
{imply "with-c" if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-d" and (not "with-d")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
 {continue if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/smartcard-auth 197
password    requisite     pam_pwquality.so {include if ("with-c") and "with-c" or "with-b"}
{include if ("with-b" or not "with-b")}
# a comment line {include if ("with-d" or "with-c" or "with-d")}

