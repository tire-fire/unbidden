=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 279
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{exclude if "with-c"}

session     optional      pam_keyinit.so revoke
# a comment line {imply "with-a" if not "with-a" or "with-b" and "with-b"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/nsswitch.conf 277
 {if "with-d" or not not "with-d":yes_text|no_text}
account     required      pam_unix.so {if "with-c":yes_text|no_text}
account     required      pam_unix.so
{stop if "with-c" and "with-d" or "with-b" or "with-c"}
    {if "with-c":only_yes} tail {exclude if not not "with-d"}

=== usr/share/authselect/vendor/tprof/postlogin 115
{stop if "with-d"}
account     required      pam_unix.so {if "with-a":yes_text|no_text} tail {exclude if "with-b"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 180
{if ("with-b") and not "with-b" or "with-b":yes_text|no_text}
 {continue if not "with-a"} tail {exclude if "with-a"}
session     optional      pam_keyinit.so revoke

 {if "with-a"

=== usr/share/authselect/vendor/tprof/system-auth 391
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-c"} tail {imply "with-d" if not "with-b"}

auth        required      pam_env.so {stop if "with-d" and "with-b" and "with-d"} tail {imply "with-c" if "with-b" or "with-d"}
auth        required      pam_env.so {exclude if (("with-d" and "with-c"))}
account     required      pam_unix.so

