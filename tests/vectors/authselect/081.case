=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 568
{if "with-b":yes_text|no_text}
# a comment line {continue if not not "with-c" or not "with-b"} tail {if not "with-c":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-b" if not "with-b"}
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok {exclude if "with-b"}
auth        required      pam_env.so {if "with-d":only_yes} tail {stop if "with-b"}
password    requisite     pam_pwquality.so
{include if "with-a"}
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/nsswitch.conf 406
auth        required      pam_env.so {include if "with-d"}
account     required      pam_unix.so {imply "with-a" if ("with-c")}
auth        sufficient    pam_unix.so nullok
{continue if "with-d"}
{exclude if "with-a" and not "with-c"}
{if "with-c":yes_text|no_text}
 {exclude if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-c" if "with-c"}

=== usr/share/authselect/vendor/tprof/password-auth 351
auth        sufficient    pam_unix.so nullok
# a comment line
account     required      pam_unix.so
# a comment line {include if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-c" and "with-c" or "with-d" or not ("with-a"):only_yes} tail {if not "with-b" or (not "with-a"):yes_text|no_text}

=== usr/share/authselect/vendor/tprof/postlogin 534
    {if ("with-b") and not "with-b" or ("with-d"):yes_text|no_text}
account     required      pam_unix.so {continue if ("with-a" and "with-d" or "with-a")}
password    requisite     pam_pwquality.so
{exclude if not "with-d" and "with-d" or "with-b" or "with-c"}
{if not (("with-b")):yes_text|no_text}
# a comment line {exclude if "with-d"}
session     optional      pam_keyinit.so revoke
{stop if ("with-a" or "with-a" and "with-d")}
 {if "with-a":only_yes}
session     optional      pam_keyinit.so revoke {stop if (not not "with-b")}
=== usr/share/authselect/vendor/tprof/system-auth 71
auth        sufficient    pam_unix.so nullok {include if not "with-a"}

