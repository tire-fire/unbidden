{if "with-b":only_yes}

=== usr/share/authselect/vendor/tprof/smartcard-auth 489
 {continue if "with-c"}
   
   
 {if not not "with-c":only_yes} tail {include if (("with-d")) and (("with-d"))}
auth        required      pam_env.so {stop if (not "with-d")}
auth        sufficient    pam_unix.so nullok {stop if "with-b" or "with-d" and ("with-c") or not "with-b"} tail {if "with-b":only_yes}
{if "with-b":only_yes}
{include if "with-b"}
    {if not "with-b" and "with-a" and not "with-a":yes_text|no_text}
