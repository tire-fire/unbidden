=== usr/share/authselect/vendor/tprof/fingerprint-auth 124
# a comment line {include if (("with-b" or "with-b"))}
auth        sufficient    pam_unix.so nullok
 {include if ("with-c")}
=== usr/share/authselect/vendor/tprof/nsswitch.conf 370
 {if not ("with-c"):yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{exclude if "with-b"}
 {if not "with-b":yes_text|no_text} tail {include if "with-b"}

auth        sufficient    pam_unix.so nullok {continue if not not "with-c"}
   
    {if "with-a" and "with-d" or "with-c" and "with-b" and "with-b":only_yes}

=== usr/share/authselect/vendor/tprof/password-auth 484
auth        required      pam_env.so
account     required      pam_unix.so {include if not "with-b"} tail {include if "with-a"}
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok
    {exclude if ("with-b")} tail {imply "with-a" if "with-d"}
    {if "with-a" tail {imply "with-d" if not not "with-b" and "with-c" and "with-b"}
{stop if ("with-a" or "with-d" or "with-d" or "with-c")}
   
# a comment line
account     required      pam_unix.so

