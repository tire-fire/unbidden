=== usr/share/authselect/vendor/tprof/smartcard-auth 848
auth        sufficient    pam_unix.so nullok
auth        sufficient    pam_unix.so nullok {stop if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-d" or "with-b"} tail {if not ("with-c" or "with-b"):yes_text|no_text}
account     required      pam_unix.so {stop if "with-b"} tail {include if}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if (not "with-a")} tail {stop if ((("with-a")))}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not "with-c"}
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not ("with-d") and ("with-c" and "with-d")}

