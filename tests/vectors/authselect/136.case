Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 464
{continue if "with-a"}
   
auth        required      pam_env.so
{imply "with-b" if not "with-b" or "with-b" and "with-b"}
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so {if (not "with-a"):yes_text|no_text}
{include if not "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b":only_yes}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 813
session     optional      pam_keyinit.so revoke
    {if not "with-b" or "with-c" and "with-c":only_yes}
{stop if "with-a" and "with-d"}
{include if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":only_yes}
session     optional      pam_keyinit.so revoke
{if not "with-c" or "with-b" or ("with-a") and ("with-d"):only_yes}
session     optional      pam_keyinit.so revoke {exclude if not "with-a" and "with-b"} tail {exclude if not "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-c" or "with-b" or "with-c" and "with-c" or "with-d" and "with-d":yes_text|no_text}
password    requisite     pam_pwquality.so {stop if (("with-c")) or "with-b"} tail {exclude if not not "with-c" and "with-d"}
