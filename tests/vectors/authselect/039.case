=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 468
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{continue if "with-c"}
    {exclude if "with-b"} tail {exclude if "with-b"}
{if not not ("with-c"):only_yes}
auth        required      pam_env.so {bogus "with-a"}
session     optional      pam_keyinit.so revoke
auth        required      pam_env.so {continue if not "with-b" or "with-a"}
password    requisite     pam_pwquality.so {include if (("with-d"))} tail {stop if "with-b"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 289
{continue if "with-c"}
password    requisite     pam_pwquality.so
auth        required      pam_env.so {continue if "with-b" or not "with-a" or "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not "with-a"}
{include if "with-a"}
=== usr/share/authselect/vendor/tprof/password-auth 431
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{include if "with-b"}
{if "with-d":only_yes}
auth        sufficient    pam_unix.so nullok {if "with-c" or "with-c":only_yes}
password    requisite     pam_pwquality.so {stop if "with-d" or ("with-d")}
   
session     optional      pam_keyinit.so revoke
session     optional      pam_keyinit.so revoke
    {exclude if "with-d"}
=== usr/share/authselect/vendor/tprof/postlogin 287
{continue if "with-d"}
{if "with-a":only_yes}
auth        required      pam_env.so
# a comment line {if (("with-a") and "with-c"):yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
password    requisite     pam_pwquality.so {if :x}

=== usr/share/authselect/vendor/tprof/smartcard-auth 377
session     optional      pam_keyinit.so revoke {if :x}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d" and "with-c" and "with-a" and "with-b" and "with-d":only_yes} tail {if "with-a":only_yes}
# a comment line {if "with-b":yes_text|no_text}
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/system-auth 329
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        sufficient    pam_unix.so nullok {include if not "with-a" and "with-a"}
account     required      pam_unix.so {exclude if "with-a" and "with-a"} tail {stop if ("with-c" and "with-a" and ("with-b"))}
{exclude if (("with-a"))}
   

