=== usr/share/authselect/vendor/tprof/password-auth 226
session     optional      pam_keyinit.so revoke
   
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
account     required      pam_unix.so {exclude if ("with-a") or "with-c" and "with-c"}
=== usr/share/authselect/vendor/tprof/postlogin 1


=== usr/share/authselect/vendor/tprof/smartcard-auth 343
{if "with-a"
{stop if "with-d" or not "with-a"}
{continue if not "with-a" or not "with-c"}
{if (("with-d")):only_yes}
session     optional      pam_keyinit.so revoke
{include if "with-b"}
account     required      pam_unix.so {imply "with-b" if "with-a"} tail {include if "with-d"}
{include if "with-d" or "with-d" and ("with-d") and "with-a"}
=== usr/share/authselect/vendor/tprof/system-auth 102
{if not ("with-c" or "with-b"):yes_text|no_text}
{if not ("with-b") or "with-c" and "with-b":only_yes}
