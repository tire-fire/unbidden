=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 234
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so
account     required      pam_unix.so {if "with-b":only_yes}
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/password-auth 349
 {if ("with-d" and "with-c"):yes_text|no_text} tail {include if ("with-b") or not "with-c"}
password    requisite     pam_pwquality.so {continue if ("with-c")}
{continue if "with-c" and "with-c"}
    {include if ("with-c")} tail {exclude if not not "with-a"}
# a comment line
auth        sufficient    pam_unix.so nullok

    {continue if "with-a"}

=== usr/share/authselect/vendor/tprof/postlogin 197
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-d"} tail {exclude if "with-b"}
{include if "with-b" or "with-b" and "with-b" and "with-b"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 706
auth        required      pam_env.so
 {stop if "with-b" or "with-d"}
auth        sufficient    pam_unix.so nullok {if "with-d" or "with-d" and "with-b" and "with-c":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-c"} tail {exclude if "with-c"}
account     required      pam_unix.so {exclude if "with-b"}
account     required      pam_unix.so {exclude if "with-b" or not "with-a" or "with-b"} tail {exclude if "with-b" and "with-b"}
session     optional      pam_keyinit.so revoke
{stop if not not "with-d" or ("with-a")}
auth        sufficient    pam_unix.so nullok
# a comment line {if (("with-b" or "with-b")):yes_text|no_text}

=== usr/share/authselect/vendor/tprof/system-auth 349
session     optional      pam_keyinit.so revoke {include if "with-c" and not "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{include if "with-b"}
{if "with-a":yes_text|no_text}
    {continue if "with-c"}
# a comment line {continue if "with-b"}
# a comment line
auth        required      pam_env.so

