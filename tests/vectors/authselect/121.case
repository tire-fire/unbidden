=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 568
password    requisite     pam_pwquality.so
account     required      pam_unix.so {if "with-b":only_yes} tail {include if "with-c" or "with-d"}
session     optional      pam_keyinit.so revoke
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-c"}
password    requisite     pam_pwquality.so {stop if not "with-b" or "with-c" or "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-b"} tail {exclude if ("with-d")}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 393
# a comment line {if ("with-a"):yes_text|no_text} tail {continue if ("with-d" and "with-c" or "with-c" or "with-a")}

account     required      pam_unix.so {include if "with-b" or "with-d"}
password    requisite     pam_pwquality.so
password    requisite     pam_pwquality.so {include if "with-d"} tail {include if "with-b"}


{include if "with-b"}
{if "with-b" and "with-c":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 147
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok {exclude if not "with-b"} tail {if "with-c":only_yes}

=== usr/share/authselect/vendor/tprof/postlogin 162
session     optional      pam_keyinit.so revoke
{continue if (("with-b" and "with-d"))}
password    requisite     pam_pwquality.so {if "with-b":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/system-auth 234
{if not not "with-d":yes_text|no_text}
{include if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        sufficient    pam_unix.so nullok {exclude if (not "with-d" and "with-b")}
