=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 231
{if "with-c":only_yes}
password    requisite     pam_pwquality.so {include if "with-c"} tail {if ((not "with-b")):only_yes}
auth        sufficient    pam_unix.so nullok {include if "with-a" or "with-a"} tail {continue if "with-c"}

=== usr/share/authselect/vendor/tprof/password-auth 272
account     required      pam_unix.so
auth        required      pam_env.so {exclude if ("with-d" and "with-d") or "with-d" or "with-d" and "with-d" and "with-b"} tail {include if not "with-b" and "with-d"}
    {if ("with-c"):only_yes}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 195
{if ("with-a":x}
password    requisite     pam_pwquality.so {exclude if "with-d"}
# a comment line
   
auth        required      pam_env.so
account     required      pam_unix.so
# a comment line

=== usr/share/authselect/vendor/tprof/system-auth 355
session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so {include if "with-d"}
session     optional      pam_keyinit.so revoke {imply "with-b" if not not "with-c" or "with-b"} tail {imply "with-a" if not "with-c" or "with-d"}
    {imply "with-d" if (not "with-a" and "with-c")}
# a comment line {include if "with-a"}
   

