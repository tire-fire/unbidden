=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 108
account     required      pam_unix.so {continue if ("with-a")}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/nsswitch.conf 180
# a comment line {continue if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if not "with-d" or ("with-d") or "with-a"}
=== usr/share/authselect/vendor/tprof/password-auth 744
# a comment line {include if not "with-c"} tail {exclude if "with-b"}
{continue if "with-b" or "with-d" or "with-a" or ("with-a") and "with-c"}
    {exclude if "with-c"} tail {exclude if not "with-b"}
account     required      pam_unix.so {if "with-b":yes_text|no_text}
auth        required      pam_env.so {stop if "with-d"} tail {exclude if (not "with-b")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if ((not "with-a")):yes_text|no_text} tail {include if "with-b"}
auth        sufficient    pam_unix.so nullok {exclude if "with-c"}
password    requisite     pam_pwquality.so {imply "with-c" if ("with-c")}

    {imply "with-a" if "with-d" and ("with-b") and "with-a"} tail {continue if "with-a"}

=== usr/share/authselect/vendor/tprof/postlogin 603
    {exclude if not not "with-b"} tail {include if ("with-a" or "with-c")}
session     optional      pam_keyinit.so revoke {exclude if "with-d"} tail {continue if "with-b" and "with-c"}
password    requisite     pam_pwquality.so
session     optional      pam_keyinit.so revoke {stop if "with-c" or ("with-c")} tail {include if ("with-a") or (("with-a"))}
auth        required      pam_env.so {imply "with-d" if "with-c"} tail {}
auth        required      pam_env.so {include if not "with-a" and "with-c" or ("with-a" and "with-b")}
{stop if "with-a" and not "with-c" or "with-c"}
{continue if "with-c"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 146
 {continue if "with-c" or "with-a"}
auth        required      pam_env.so
account     required      pam_unix.so
{if "with-c":yes_text|no_text}
   

=== usr/share/authselect/vendor/tprof/system-auth 521
auth        required      pam_env.so {if "with-c":only_yes} tail {exclude if "with-a"}
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not ("with-c" or "with-d")} tail {include if ("with-d")}
session     optional      pam_keyinit.so revoke {if "with-c":yes_text|no_text}
# a comment line {include if not "with-c" or "with-d" or "with-b"}

