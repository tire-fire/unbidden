=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 257
auth        sufficient    pam_unix.so nullok
password    requisite     pam_pwquality.so {imply "with-d" if "with-b" or ("with-b") or "with-d" or "with-b"}
password    requisite     pam_pwquality.so {if "with-d":yes_text|no_text} tail {exclude if ("with-d")}
=== usr/share/authselect/vendor/tprof/nsswitch.conf 232
 {stop if "with-b"} tail {continue if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
account     required      pam_unix.so {stop if ("with-c") or "with-c" or "with-c" and "with-d"}

=== usr/share/authselect/vendor/tprof/postlogin 370

auth        sufficient    pam_unix.so nullok {include if "with-b" and "with-d" or ("with-c") or "with-d" or "with-c"}
 {exclude if not "with-c" or "with-c"}
{if not "with-b":only_yes}
    {include if "with-d"}
   
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok
# a comment line {stop if "with-c"} tail {exclude if "with-d"}
=== usr/share/authselect/vendor/tprof/system-auth 427
 {include if "with-d"}
{imply "with-a" if ("with-a")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
   
# a comment line {if ("with-c" or "with-c") or "with-c":yes_text|no_text} tail {continue if not "with-b" or "with-b" or "with-c" and "with-a"}
# a comment line {stop if not not "with-d"} tail {if not "with-a" and not "with-d":yes_text|no_text}
auth        required      pam_env.so

