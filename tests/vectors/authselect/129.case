=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 634
account     required      pam_unix.so {if (("with-b")) and not "with-a" or not "with-c":yes_text|no_text}
session     optional      pam_keyinit.so revoke
session     optional      pam_keyinit.so revoke {continue if "with-b"}
 {if not "with-c":yes_text|no_text}
session     optional      pam_keyinit.so revoke {if "with-a":yes_text|no_text} tail {include if "with-b"}
session     optional      pam_keyinit.so revoke {include if "with-c"} tail {if "with-a" and not "with-b" and "with-c":only_yes}
auth        sufficient    pam_unix.so nullok {continue if not "with-c"} tail {bogus "with-a"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/nsswitch.conf 221
auth        sufficient    pam_unix.so nullok
{stop if (not "with-d") and not "with-a" or "with-c"}
session     optional      pam_keyinit.so revoke {if "with-a" or "with-d" and "with-a" and "with-b" and "with-b":only_yes}

=== usr/share/authselect/vendor/tprof/smartcard-auth 489
session     optional      pam_keyinit.so revoke {if "with-c":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if ("with-d")}
auth        sufficient    pam_unix.so nullok
    {if "with-c":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b":only_yes}
   
# a comment line {include if "with-d"}
auth        sufficient    pam_unix.so nullok {include if not "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 390
session     optional      pam_keyinit.so revoke {include if "with-b"}
{stop if "with-d" or not "with-d" and ("with-b") or "with-b" or "with-b"}
password    requisite     pam_pwquality.so
{if "with-c":only_yes}
    {imply "with-d" if not ("with-b")}
    {imply "with-b" if "with-b"}
{if "with-b":yes_text|no_text}
{imply "with-b" if not "with-c"}

password    requisite     pam_pwquality.so

