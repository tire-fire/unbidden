=== usr/share/authselect/vendor/tprof/password-auth 409
{if "with-b" and "with-d":only_yes}
{if ("with-b"):only_yes}

password    requisite     pam_pwquality.so {include if "with-b"}
account     required      pam_unix.so {exclude if "with-d"} tail {include if "with-d" and "with-b" or "with-b" and "with-c" and not "with-a"}
session     optional      pam_keyinit.so revoke {if "with-c" and "with-c" and "with-d":yes_text|no_text} tail {exclude if not not "with-a"}

