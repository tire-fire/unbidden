account     required      pam_unix.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 306
{if ("with-d") or "with-c":only_yes}
# a comment line {imply "with-d" if "with-a"}
{if (("with-c") and "with-c"):yes_text|no_text}
auth        sufficient    pam_unix.so nullok {include if (("with-d"))}
session     optional      pam_keyinit.so revoke {imply "with-d" if "with-a"} tail {include if "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 603
{if "with-a" and "with-d" or "with-b" and "with-d":only_yes}
{continue if (("with-b")) or "with-d"}
{include if "with-d" and "with-a"}
session     optional      pam_keyinit.so revoke {imply "with-b" if not "with-b"} tail {exclude if "with-c"}
auth        sufficient    pam_unix.so nullok {include if "with-d" or "with-d"}
    {continue if "with-d"}
 {}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if ("with-b")} tail {stop if "with-d"}
{imply "with-b" if "with-b" or not "with-d" and not "with-d"}
{exclude if not "with-c" and "with-a" and "with-d"}

