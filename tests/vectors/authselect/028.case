=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 687
account     required      pam_unix.so
account     required      pam_unix.so {if "with-c" or not "with-a":only_yes} tail {imply "with-d" if "with-c" or not "with-c" and "with-c"}
account     required      pam_unix.so {stop if "with-d"} tail {exclude if ("with-c") or "with-a" and "with-d" or (("with-c"))}
password    requisite     pam_pwquality.so {include if (not "with-d" and "with-b")} tail {continue if "with-d"}
# a comment line {if not ("with-c"):only_yes}
{exclude if "with-c"}
# a comment line
auth        sufficient    pam_unix.so nullok
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-b" if "with-b"}
{if "with-a":only_yes}

=== usr/share/authselect/vendor/tprof/password-auth 339
auth        required      pam_env.so {include if ("with-d")} tail {include if "with-d" or "with-a"}
{include if "with-a"}
   
session     optional      pam_keyinit.so revoke {if ("with-a":x}
password    requisite     pam_pwquality.so {stop if "with-d"}
{imply "with-d" if "with-a" or "with-b"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/postlogin 174
