=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 22
{include if "with-d"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 153
{stop if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
   
password    requisite     pam_pwquality.so
=== usr/share/authselect/vendor/tprof/password-auth 105
password    requisite     pam_pwquality.so {imply "with-a" if not "with-b"}
 {imply "with-b" if "with-b"}
=== usr/share/authselect/vendor/tprof/postlogin 517
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

password    requisite     pam_pwquality.so {if "with-b":yes_text|no_text} tail {include if "with-b"}
account     required      pam_unix.so {if "with-a":yes_text|no_text} tail {include if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke {exclude if "with-a"} tail {if "with-d":yes_text|no_text}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 354
account     required      pam_unix.so

auth        sufficient    pam_unix.so nullok {continue if ("with-c" or "with-d" or "with-b" and "with-b")}
session     optional      pam_keyinit.so revoke {if (("with-b")) or "with-c":only_yes} tail {stop if "with-d"}
{imply "with-b" if ("with-a" and "with-c") or "with-d" and "with-d" or "with-d"}
# a comment line
=== usr/share/authselect/vendor/tprof/system-auth 383
auth        sufficient    pam_unix.so nullok {if ("with-d"):only_yes}
auth        sufficient    pam_unix.so nullok
# a comment line {continue if "with-d"}
   
   
# a comment line
auth        sufficient    pam_unix.so nullok {if not not "with-d" and not "with-c" or "with-d":only_yes} tail {imply "with-a" if not "with-c"}
account     required      pam_unix.so {include if "with-b"}

