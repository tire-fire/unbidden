session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 339
# a comment line {if "with-c":yes_text|no_text}
    {stop if ("with-b")} tail {if (("with-b") and "with-b"):yes_text|no_text}
# a comment line {stop if "with-d"} tail {include if "with-b" or "with-b"}
{if "with-c":only_yes}
# a comment line {stop if "with-a"} tail {imply "with-b" if "with-b"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/nsswitch.conf 94
auth        required      pam_env.so
account     required      pam_unix.so
{stop if "with-a"}

=== usr/share/authselect/vendor/tprof/password-auth 137
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if "with-c" and not "with-a" and "with-a"}

=== usr/share/authselect/vendor/tprof/postlogin 414
account     required      pam_unix.so {include if "with-b"} tail {imply "with-c" if "with-d"}
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke
account     required      pam_unix.so
{imply "with-c" if "with-c"}
password    requisite     pam_pwquality.so {stop if ("with-c")}
account     required      pam_unix.so {include if "with-c" and "with-c" or "with-c" or "with-c"}
=== usr/share/authselect/vendor/tprof/smartcard-auth 216
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{include if not "with-a"}
account     required      pam_unix.so {include if ("with-c")} tail {exclude if "with-b" and "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 344
{include if not "with-d" and ("with-b")}
session     optional      pam_keyinit.so revoke {if ("with-c") or not "with-b":yes_text|no_text}
auth        required      pam_env.so {include if not "with-a" and "with-c" or not "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if not "with-a"}

