=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 268
account     required      pam_unix.so {imply "with-c" if not ("with-b")}
{continue if ("with-a")}
{imply "with-d" if not "with-b" or "with-c" or "with-b"}
session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so {include if "with-a"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 430
session     optional      pam_keyinit.so revoke
    {if not "with-b":yes_text|no_text} tail {continue if ("with-b" and "with-b") or "with-a"}
session     optional      pam_keyinit.so revoke
session     optional      pam_keyinit.so revoke
# a comment line

password    requisite     pam_pwquality.so {include if not "with-a"}
password    requisite     pam_pwquality.so {exclude if ("with-d") or "with-c" and "with-a" and "with-d"}

=== usr/share/authselect/vendor/tprof/password-auth 458
account     required      pam_unix.so
{stop if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{exclude if not "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{if "with-a":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {imply "with-d" if "with-c"}
account     required      pam_unix.so
password    requisite     pam_pwquality.so
{include if}

=== usr/share/authselect/vendor/tprof/postlogin 249
{continue if not ("with-a") and "with-a" or "with-c" and "with-b"}
auth        required      pam_env.so


 {imply "with-c" if "with-d"}
auth        sufficient    pam_unix.so nullok {continue if "with-c"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/smartcard-auth 491
{if "with-b":yes_text|no_text}
session     optional      pam_keyinit.so revoke {exclude if ("with-b" and "with-a")} tail {imply "with-d" if not ("with-a") or "with-a"}
{if :x}
 {stop if ("with-c") or "with-d" and "with-b" or "with-c"}
{if "with-d" or "with-b" and "with-d":yes_text|no_text}
{if "with-c" or not "with-c":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-c":yes_text|no_text} tail {imply "with-a" if "with-b"}

=== usr/share/authselect/vendor/tprof/system-auth 388
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-c"}
{exclude if "with-a"}
{if not "with-b" or not "with-c":yes_text|no_text}
auth        required      pam_env.so {if "with-d":only_yes}
{exclude if "with-b" or "with-d"}
{if not "with-d" or "with-c":yes_text|no_text}
    {stop if ("with-c" or "with-c") or not "with-d" or "with-c"}
