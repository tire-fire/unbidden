=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 499
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if ("with-c" or "with-b"):only_yes} tail {include if ("with-c" or "with-d" and "with-c")}
account     required      pam_unix.so
 {stop if (not "with-a" and "with-c")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":only_yes}
 {continue if not "with-b"}
account     required      pam_unix.so {stop if not "with-c"}
password    requisite     pam_pwquality.so

=== usr/share/authselect/vendor/tprof/nsswitch.conf 219
auth        required      pam_env.so
auth        required      pam_env.so {include if}
password    requisite     pam_pwquality.so
session     optional      pam_keyinit.so revoke {if not not ("with-d"):yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 251
 {continue if not not not "with-d"}
    {include if ("with-d" and "with-b" or not "with-b")} tail {include if "with-d"}
# a comment line
{continue if ("with-a")}
    {if "with-d":only_yes}
# a comment line
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/postlogin 506

{include if not "with-c" or "with-b" and "with-c"}
password    requisite     pam_pwquality.so
account     required      pam_unix.so {include if ("with-a") or ("with-d")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
 {if "with-d":yes_text|no_text}
session     optional      pam_keyinit.so revoke
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke {if ((not "with-d")):only_yes}

=== usr/share/authselect/vendor/tprof/smartcard-auth 263
{imply "with-d" if "with-d" and not "with-a"}
# a comment line
session     optional      pam_keyinit.so revoke {continue if "with-b" and not "with-a"}
{include if "with-a" or "with-a" and not "with-b"}
 {if "with-c":yes_text|no_text} tail {if ("with-a"):only_yes}
=== usr/share/authselect/vendor/tprof/system-auth 612
account     required      pam_unix.so {continue if "with-a" and not "with-c" or "with-b"} tail {imply "with-b" if ("with-a")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{stop if "with-c"}
   
auth        required      pam_env.so
password    requisite     pam_pwquality.so {exclude if "with-d"}
auth        sufficient    pam_unix.so nullok {imply "with-a" if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so {if not not "with-c":only_yes}
# a comment line {exclude if not "with-a"}

