=== usr/share/authselect/vendor/tprof/nsswitch.conf 266
auth        required      pam_env.so {continue if "with-d" or not "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-a"} tail {if "with-b" and "with-a":only_yes}
# a comment line {exclude if "with-b"}

