=== usr/share/authselect/vendor/tprof/postlogin 226
auth        required      pam_env.so {exclude if "with-a"}
auth        required      pam_env.so
account     required      pam_unix.so {if "with-d" and "with-d" and "with-c":yes_text|no_text} tail {exclude if not not "with-c"}

