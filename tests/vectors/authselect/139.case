=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 144
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-b" if "with-d"} tail {include if "with-d"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 71
session     optional      pam_keyinit.so revoke
{if "with-c":only_yes}

=== usr/share/authselect/vendor/tprof/password-auth 164
session     optional      pam_keyinit.so revoke {continue if (("with-c")) or ("with-a")} tail {exclude if "with-b"}
{stop if ("with-d") or not "with-a" or "with-d"}
=== usr/share/authselect/vendor/tprof/postlogin 21
    {if ("with-a":x}

=== usr/share/authselect/vendor/tprof/smartcard-auth 159
account     required      pam_unix.so {if "with-b":yes_text|no_text} tail {continue if "with-a" or "with-b"}
{imply "with-c" if "with-c"}
{exclude if "with-c"}
=== usr/share/authselect/vendor/tprof/system-auth 22
{continue if "with-c"}
