=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 322
   
auth        required      pam_env.so
auth        required      pam_env.so {continue if "with-d"}
# a comment line {exclude if not "with-b" or "with-d"}
{imply "with-b" if "with-d"}
    {if "with-a":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-a"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 123

   
 {imply "with-c" if "with-d"} tail {continue if "with-d"}
auth        required      pam_env.so {continue if "with-d"}

=== usr/share/authselect/vendor/tprof/password-auth 88
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/postlogin 48
{imply "with-a" if not ("with-a") and "with-b"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 373
# a comment line {bogus "with-a"}
account     required      pam_unix.so {include if (not "with-c")} tail {exclude if "with-c" or "with-c"}

   
session     optional      pam_keyinit.so revoke
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if (not "with-b") or not not "with-b"}
auth        sufficient    pam_unix.so nullok

