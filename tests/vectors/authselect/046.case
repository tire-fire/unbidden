=== usr/share/authselect/vendor/tprof/fingerprint-auth 595
account     required      pam_unix.so {imply "with-a" if ("with-b") or ("with-d") or (not "with-b")} tail {if not "with-d" and not "with-b" and not "with-c" and "with-a":only_yes}
session     optional      pam_keyinit.so revoke {exclude if "with-b"} tail {if not (("with-c")):only_yes}
password    requisite     pam_pwquality.so
password    requisite     pam_pwquality.so {exclude if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-c":only_yes}
{exclude if "with-d"}
# a comment line {imply "with-c" if not not "with-c" and "with-a"}


=== usr/share/authselect/vendor/tprof/nsswitch.conf 364
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so {if ("with-b"):yes_text|no_text} tail {exclude if not "with-d" and "with-b" or "with-c"}

auth        sufficient    pam_unix.so nullok
password    requisite     pam_pwquality.so
{continue if "with-a"}

auth        required      pam_env.so

