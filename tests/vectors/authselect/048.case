=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 105
password    requisite     pam_pwquality.so {continue if ("with-d") and "with-a" or "with-a" or "with-d"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 479
auth        sufficient    pam_unix.so nullok {if not "with-c":only_yes}
password    requisite     pam_pwquality.so {if ("with-c") and "with-a":yes_text|no_text}
password    requisite     pam_pwquality.so
account     required      pam_unix.so
auth        required      pam_env.so
{if "with-c" or "with-c" or "with-a" or "with-b":only_yes}
auth        sufficient    pam_unix.so nullok
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{if :x}

=== usr/share/authselect/vendor/tprof/postlogin 591
    {include if "with-c"}
auth        required      pam_env.so {imply "with-d" if "with-d"}


session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        sufficient    pam_unix.so nullok {imply "with-c" if not "with-a"}
session     optional      pam_keyinit.so revoke {stop if "with-c"}
# a comment line {if ("with-c"):yes_text|no_text} tail {include if "with-a"}
account     required      pam_unix.so {if "with-d" or "with-c":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {if "with-c":yes_text|no_text} tail {include if not "with-a"}
=== usr/share/authselect/vendor/tprof/smartcard-auth 565
password    requisite     pam_pwquality.so {continue if "with-b"} tail {imply "with-c" if "with-a"}
{imply "with-a" if "with-c" and "with-d" or not "with-a" and not "with-c" and "with-a" and "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so
{continue if ("with-a")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-c" if not "with-b"}
session     optional      pam_keyinit.so revoke
{continue if not "with-b"}

# a comment line

=== usr/share/authselect/vendor/tprof/system-auth 191
auth        required      pam_env.so {include if "with-d"} tail {if ("with-b"):only_yes}
auth        required      pam_env.so
# a comment line
session     optional      pam_keyinit.so revoke

