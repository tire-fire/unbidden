=== usr/share/authselect/vendor/tprof/nsswitch.conf 402
{include if "with-a"}
# a comment line
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok
 {if "with-d":yes_text|no_text} tail {include if ("with-d" or "with-b" and "with-c")}
session     optional      pam_keyinit.so revoke {imply "with-a" if ("with-c")} tail {exclude if ("with-a" and "with-b")}
password    requisite     pam_pwquality.so {if "with-c":yes_text|no_text}

