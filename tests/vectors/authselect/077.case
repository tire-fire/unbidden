=== usr/share/authselect/vendor/tprof/postlogin 522
auth        sufficient    pam_unix.so nullok {continue if "with-a" and "with-a"}
# a comment line {continue if "with-d"}
# a comment line {include if "with-a"}
 {stop if (("with-b")) or "with-d" or "with-c" or "with-d"}
auth        sufficient    pam_unix.so nullok
 {continue if not "with-d" or "with-d" or "with-a"} tail {if "with-b":yes_text|no_text}
    {if "with-d" and "with-b":yes_text|no_text} tail {continue if "with-b"}
auth        required      pam_env.so {include if "with-d"} tail {imply "with-d" if "with-d"}

