=== usr/share/authselect/vendor/tprof/system-auth 366
session     optional      pam_keyinit.so revoke
 {if "with-b":yes_text|no_text} tail {exclude if not "with-c" or "with-d"}
{if ("with-a" or "with-d" or "with-c"):yes_text|no_text}
    {if "with-a":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if "with-c" and "with-c"}
{continue if not not "with-c"}

