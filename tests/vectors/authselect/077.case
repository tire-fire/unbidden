=== usr/share/authselect/vendor/tprof/fingerprint-auth 544
# a comment line {exclude if "with-a"}

account     required      pam_unix.so {if ("with-a"):only_yes}
# a comment line {if ("with-b" or ("with-c")):only_yes} tail {if "with-a" or "with-d" and ("with-c"):only_yes}
account     required      pam_unix.so {stop if not "with-a"} tail {if "with-c":yes_text|no_text}
password    requisite     pam_pwquality.so
password    requisite     pam_pwquality.so {exclude if ("with-b" or "with-d" or "with-d")}
session     optional      pam_keyinit.so revoke
