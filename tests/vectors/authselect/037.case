=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 289
    {if ((("with-c"))):only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-b"}
auth        sufficient    pam_unix.so nullok {exclude if not "with-b"} tail {if "with-a":yes_text|no_text}
# a comment line {include if "with-b"}

=== usr/share/authselect/vendor/tprof/password-auth 154
{stop if "with-d"}
{imply "with-b" if "with-c" or "with-d" and "with-d" or "with-a"}
auth        sufficient    pam_unix.so nullok
 {continue if "with-c"}

=== usr/share/authselect/vendor/tprof/postlogin 193
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke {stop if "with-d"} tail {imply "with-b" if not "with-a"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 382

auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok {include if "with-c"}
# a comment line {stop if not "with-b"}
session     optional      pam_keyinit.so revoke {continue if ("with-c")} tail {continue if "with-b" or "with-a" and "with-c" or "with-a"}
# a comment line {if not not "with-c":yes_text|no_text} tail {exclude if ("with-d") and "with-a"}


