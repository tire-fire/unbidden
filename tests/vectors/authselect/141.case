=== etc/authselect/system-auth 488
# Generated by authselect
# Do not modify this file manually, use authselect instead. Any user changes will be overwritten.
# You can stop authselect from managing your configuration by calling 'authselect opt-out'.
# See authselect(8) for more details.

session     optional      pam_keyinit.so revoke
account     required      pam_unix.so
 
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid yes_text
# a comment line
  tail no_text
 

    only_yes

=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 251
 {exclude if "with-c"} tail {imply "with-c" if "with-c"}
account     required      pam_unix.so {if "with-d":only_yes} tail {include if "with-b"}
auth        sufficient    pam_unix.so nullok {exclude if ("with-b" and "with-c") or "with-c" or "with-b"}

=== usr/share/authselect/vendor/tprof/password-auth 125
auth        required      pam_env.so
{continue if "with-a"}
password    requisite     pam_pwquality.so {exclude if "with-b"}

=== usr/share/authselect/vendor/tprof/postlogin 158
# a comment line
password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok {exclude if not "with-d"} tail {include if "with-d"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 85
auth        required      pam_env.so
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/system-auth 407
session     optional      pam_keyinit.so revoke
account     required      pam_unix.so
   
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-c" or not "with-d":yes_text|no_text}
# a comment line
 {include if "with-c" and not "with-d" or "with-d"} tail {if "with-a":yes_text|no_text}
   
{if (not "with-c") and "with-a":only_yes}
    {if "with-b":only_yes}

