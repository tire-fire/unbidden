=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 124
auth        required      pam_env.so {exclude if "with-a" and "with-d"}
session     optional      pam_keyinit.so revoke

   
=== usr/share/authselect/vendor/tprof/nsswitch.conf 373
{include if "with-c"}
    {continue if not (not "with-c")}
password    requisite     pam_pwquality.so {exclude if not ("with-a") or "with-a" or "with-b" or ("with-a")} tail {if "with-a":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke
    {imply "with-a" if "with-d"}
password    requisite     pam_pwquality.so

=== usr/share/authselect/vendor/tprof/password-auth 305
password    requisite     pam_pwquality.so {imply "with-a" if "with-d"} tail {continue if not ("with-c") and (not "with-a")}
   
session     optional      pam_keyinit.so revoke {if ("with-a":x}
password    requisite     pam_pwquality.so {exclude if not ("with-a")}
{continue if "with-c"}
{if ("with-a":x}

=== usr/share/authselect/vendor/tprof/system-auth 182
auth        sufficient    pam_unix.so nullok {if "with-a":yes_text|no_text}
{if not "with-d" and "with-a" and "with-a":yes_text|no_text}
auth        sufficient    pam_unix.so nullok

