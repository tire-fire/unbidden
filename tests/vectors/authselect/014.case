=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 456
 {include if "with-a" and (not "with-a")}
session     optional      pam_keyinit.so revoke {include if "with-a"}
password    requisite     pam_pwquality.so {stop if not ("with-a") and "with-c"}
{if (not "with-a"):yes_text|no_text}
session     optional      pam_keyinit.so revoke {exclude if (("with-b"))}
 {if "with-d":yes_text|no_text} tail {imply "with-c" if "with-a"}
session     optional      pam_keyinit.so revoke
account     required      pam_unix.so

=== usr/share/authselect/vendor/tprof/password-auth 500
password    requisite     pam_pwquality.so {continue if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-b"}
{if "with-b":only_yes}
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok {continue if not ("with-a")} tail {continue if "with-c"}
{continue if "with-a"}
auth        required      pam_env.so {if not not "with-a":yes_text|no_text}
{continue if ("with-d")}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/postlogin 49
auth        sufficient    pam_unix.so nullok
   

=== usr/share/authselect/vendor/tprof/smartcard-auth 497
account     required      pam_unix.so {if "with-b":yes_text|no_text}
{stop if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
# a comment line {imply "with-c" if "with-a"}
# a comment line {if "with-c":only_yes} tail {include if "with-d"}
{if not ("with-d"):yes_text|no_text}
auth        sufficient    pam_unix.so nullok {imply "with-c" if ("with-a") and "with-b" and "with-c" and "with-b" and "with-b" and ("with-a")}
{include if (not "with-d")}

=== usr/share/authselect/vendor/tprof/system-auth 71
session     optional      pam_keyinit.so revoke {include if ("with-c")}
