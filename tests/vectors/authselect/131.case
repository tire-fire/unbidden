=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 269
auth        required      pam_env.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":yes_text|no_text}
{include if "with-a"}
account     required      pam_unix.so {exclude if not not "with-c"}
{if "with-c":only_yes}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 188
{if not "with-b" or "with-c" and "with-a" or ("with-a"):yes_text|no_text}

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{continue if ("with-a")}

=== usr/share/authselect/vendor/tprof/password-auth 148
auth        required      pam_env.so {imply "with-c" if "with-b"} tail {if "with-c":yes_text|no_text}
password    requisite     pam_pwquality.so
{}

=== usr/share/authselect/vendor/tprof/postlogin 312

password    requisite     pam_pwquality.so {imply "with-b" if not "with-d" or "with-a" and "with-c"}
auth        required      pam_env.so
session     optional      pam_keyinit.so revoke
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 130
session     optional      pam_keyinit.so revoke {exclude if not not "with-d"}
{imply "with-d" if not ("with-a") and not "with-d"}

