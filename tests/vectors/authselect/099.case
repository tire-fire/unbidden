=== usr/share/authselect/vendor/tprof/password-auth 460
auth        required      pam_env.so
auth        required      pam_env.so
password    requisite     pam_pwquality.so {include if "with-c"}
session     optional      pam_keyinit.so revoke {continue if "with-c"}
{include if not "with-b"}
{exclude if "with-a" and not "with-b" or "with-d"}
{if not "with-d" or "with-a" and ("with-b"):only_yes}
auth        sufficient    pam_unix.so nullok
{include if ("with-a") and "with-a" and "with-c" or "with-c" and "with-c"}
=== usr/share/authselect/vendor/tprof/postlogin 478
session     optional      pam_keyinit.so revoke
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b":yes_text|no_text} tail {if not ("with-a") and "with-d" and "with-d" or "with-b" and "with-d":yes_text|no_text}
   
{include if not "with-b" or "with-c" or "with-b" or ("with-a")}
account     required      pam_unix.so
{imply "with-c" if "with-b"}
{include if "with-c"}
{include if ("with-d" and "with-b") and "with-b" or "with-c"}
