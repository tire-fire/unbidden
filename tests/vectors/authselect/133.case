=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 88
auth        sufficient    pam_unix.so nullok {exclude if "with-c"}
   
# a comment line

=== usr/share/authselect/vendor/tprof/nsswitch.conf 411
account     required      pam_unix.so
password    requisite     pam_pwquality.so {stop if "with-b"}

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke {if "with-b":yes_text|no_text} tail {imply "with-a" if "with-b" or not "with-d" and "with-d" and "with-c"}
   
account     required      pam_unix.so {include if not "with-b"}
=== usr/share/authselect/vendor/tprof/postlogin 152
{include if "with-a"}
auth        required      pam_env.so

 {if (not ("with-b")):yes_text|no_text} tail {if "with-d" or "with-b":yes_text|no_text}
   

=== usr/share/authselect/vendor/tprof/smartcard-auth 551
account     required      pam_unix.so
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-a"}
{include if "with-b" or (not "with-d")}
auth        sufficient    pam_unix.so nullok {if "with-d" or "with-c":yes_text|no_text}
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if not "with-a" and "with-a"}
account     required      pam_unix.so {if "with-a" and not "with-a" and "with-d":only_yes}

