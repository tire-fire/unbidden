=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 294
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {}
{continue if "with-c" or "with-a"}
password    requisite     pam_pwquality.so {if "with-a":only_yes}
{exclude if "with-a"}
account     required      pam_unix.so {continue if "with-b"}
{stop if "with-c"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 115
# a comment line {imply "with-d" if "with-d"}
    {if not "with-d" and "with-b":yes_text|no_text}
# a comment line

=== usr/share/authselect/vendor/tprof/password-auth 344
auth        sufficient    pam_unix.so nullok {if "with-a":yes_text|no_text}
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok {include if "with-b"}
password    requisite     pam_pwquality.so {if ("with-d"):yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/postlogin 422
password    requisite     pam_pwquality.so {continue if "with-c"} tail {include if ("with-a" and "with-c") and "with-d"}
{include if "with-b"}
# a comment line {stop if ("with-d")} tail {stop if ("with-c" and "with-b") or "with-d"}
session     optional      pam_keyinit.so revoke {include if (("with-a" and "with-c"))}
password    requisite     pam_pwquality.so
{include if "with-c"}
auth        required      pam_env.so


=== usr/share/authselect/vendor/tprof/smartcard-auth 272
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so {include if not ("with-a")}
{if not "with-c" and "with-b" and "with-b":only_yes}
    {if "with-b" or "with-a":only_yes}
{stop if "with-d"}
 {stop if "with-c"}
{if "with-d":yes_text|no_text}
