=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 538
password    requisite     pam_pwquality.so
password    requisite     pam_pwquality.so {continue if "with-c"}
{exclude if "with-c" and "with-c" and "with-d"}
session     optional      pam_keyinit.so revoke
 {continue if "with-b"} tail {continue if ("with-b" or "with-b")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-c"}
auth        required      pam_env.so {stop if "with-b"}
{if "with-a"
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/nsswitch.conf 102
 {stop if "with-a"}
account     required      pam_unix.so {if "with-c" and "with-d":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 419
account     required      pam_unix.so {imply "with-c" if "with-d" or "with-d"} tail {imply "with-c" if "with-d" and "with-a" or "with-d" or "with-b" or "with-c" and "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-b" and "with-d":only_yes}
session     optional      pam_keyinit.so revoke
# a comment line {continue if ("with-c") and "with-c"} tail {if :x}

=== usr/share/authselect/vendor/tprof/postlogin 384

account     required      pam_unix.so
session     optional      pam_keyinit.so revoke {if "with-a":only_yes} tail {if "with-b":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {exclude if "with-b" and not ("with-d")} tail {include if "with-b"}
    {imply "with-a" if not "with-b"} tail {if ("with-a" and "with-a"):yes_text|no_text}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 529
{stop if (not "with-d" and "with-b")}
password    requisite     pam_pwquality.so {include if not not ("with-c")}
auth        required      pam_env.so {stop if "with-a"} tail {continue if not ("with-a")}
{exclude if "with-b"}

password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok
auth        sufficient    pam_unix.so nullok {if ("with-a":x} tail {include if "with-b"}
password    requisite     pam_pwquality.so {include if "with-c" or not "with-b"} tail {if not ("with-d") or "with-b":only_yes}
