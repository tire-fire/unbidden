=== usr/share/authselect/vendor/tprof/nsswitch.conf 410
auth        required      pam_env.so {continue if ("with-d")}
session     optional      pam_keyinit.so revoke {if "with-c" or "with-a" and "with-d":only_yes}
 {include if ((("with-d")))}
auth        sufficient    pam_unix.so nullok {include if not ("with-d") and ("with-a")}
{include if not ("with-d")}
# a comment line
{if "with-b":yes_text|no_text}
auth        required      pam_env.so {continue if "with-c"}
