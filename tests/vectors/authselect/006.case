=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 112
account     required      pam_unix.so {if "with-c":only_yes} tail {if ("with-b" and "with-c"):yes_text|no_text}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 334
   
{include if ("with-b" and "with-c") or ("with-d")}
    {continue if "with-c" or ("with-c" and "with-b")} tail {include if "with-c" and ("with-b")}
{imply "with-a" if "with-c"}
account     required      pam_unix.so {continue if "with-b" and "with-b"}
{if (not "with-a") and "with-a":only_yes}
account     required      pam_unix.so

=== usr/share/authselect/vendor/tprof/password-auth 330
password    requisite     pam_pwquality.so
{imply "with-a" if ("with-a")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if not not "with-d"} tail {stop if not "with-a" or "with-d" and "with-c" or "with-b" and "with-b"}
account     required      pam_unix.so {exclude if "with-a"}

=== usr/share/authselect/vendor/tprof/postlogin 666
auth        sufficient    pam_unix.so nullok {include if not "with-b"}
auth        required      pam_env.so
account     required      pam_unix.so {if "with-b":yes_text|no_text} tail {bogus "with-a"}
account     required      pam_unix.so
session     optional      pam_keyinit.so revoke {exclude if "with-d" or not "with-c" or "with-d"}
session     optional      pam_keyinit.so revoke {exclude if "with-c"}
   
auth        required      pam_env.so
# a comment line {exclude if "with-d"} tail {exclude if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b" or "with-a" or "with-a" or "with-b":yes_text|no_text}
=== usr/share/authselect/vendor/tprof/smartcard-auth 552
{if :x}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d" or ("with-c") or "with-b":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
auth        sufficient    pam_unix.so nullok {include if "with-c" and "with-b"} tail {exclude if "with-c" and ("with-a") or "with-d"}
   
{continue if "with-d" and "with-b"}
session     optional      pam_keyinit.so revoke {if "with-b":yes_text|no_text}
password    requisite     pam_pwquality.so {imply "with-b" if (not "with-b")}
 {exclude if "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 415
# a comment line {if not "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if "with-b"} tail {stop if not "with-c"}
{stop if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-a" if (("with-d"))}

