=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 378
{include if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{exclude if "with-b"}
auth        required      pam_env.so
password    requisite     pam_pwquality.so {continue if "with-d" or "with-a" or "with-c" or not "with-d"}
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok
   
# a comment line

=== usr/share/authselect/vendor/tprof/nsswitch.conf 251
account     required      pam_unix.so {exclude if "with-b"}
# a comment line {if "with-c":only_yes}
 {exclude if (not "with-a")}
session     optional      pam_keyinit.so revoke
account     required      pam_unix.so {stop if (("with-a") and "with-b")}

=== usr/share/authselect/vendor/tprof/password-auth 200
account     required      pam_unix.so {include if "with-b"}
   
{continue if "with-d"}
{continue if ("with-d") and "with-d" or "with-b" or ("with-a")}
{if (not "with-d" or "with-a"):yes_text|no_text}

=== usr/share/authselect/vendor/tprof/postlogin 340
   
   
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {bogus "with-a"} tail {include if "with-a" or ("with-a") and "with-a"}
auth        sufficient    pam_unix.so nullok
{continue if "with-a"}
# a comment line {continue if "with-a" and "with-d" or "with-c" and "with-d"} tail {include if "with-d"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 238
account     required      pam_unix.so
password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok {exclude if ("with-b")}
    {} tail {imply "with-b" if "with-a"}
password    requisite     pam_pwquality.so
   

=== usr/share/authselect/vendor/tprof/system-auth 280
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{imply "with-a" if not "with-a"}
auth        required      pam_env.so {include if "with-a"}
session     optional      pam_keyinit.so revoke {if "with-a" tail {continue if not not not "with-d"}
