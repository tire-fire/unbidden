=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 458
auth        required      pam_env.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{include if "with-d"}
 {if "with-d":yes_text|no_text} tail {stop if not "with-a" and "with-b" and "with-a" or "with-c" and "with-c"}
account     required      pam_unix.so {include if not not "with-d" and "with-b"} tail {include if "with-b" and not "with-c"}
{continue if "with-b" or "with-c"}
# a comment line {if "with-c":only_yes}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 268
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if ("with-d")}
account     required      pam_unix.so {if "with-d":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
=== usr/share/authselect/vendor/tprof/postlogin 536
password    requisite     pam_pwquality.so {if "with-c":only_yes}
auth        sufficient    pam_unix.so nullok
{continue if "with-b"}
auth        sufficient    pam_unix.so nullok {exclude if "with-b"}
account     required      pam_unix.so {if "with-d":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-a" and not "with-c" or "with-d"} tail {imply "with-c" if "with-c" or "with-c" and "with-c" and "with-d"}
{imply "with-b" if not "with-b" and not not "with-c"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 234
# a comment line
password    requisite     pam_pwquality.so {if "with-c":yes_text|no_text} tail {}
session     optional      pam_keyinit.so revoke {include if "with-c"}
auth        required      pam_env.so {imply "with-a" if "with-d"}
=== usr/share/authselect/vendor/tprof/system-auth 366
password    requisite     pam_pwquality.so {exclude if "with-c"} tail {include if "with-d"}
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-c":only_yes}
auth        required      pam_env.so {continue if "with-b"} tail {continue if "with-b"}
    {include if "with-a"} tail {exclude if ("with-d")}
