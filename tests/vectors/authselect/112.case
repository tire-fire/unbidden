=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 376
session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok
auth        required      pam_env.so
account     required      pam_unix.so {imply "with-d" if "with-b"}
password    requisite     pam_pwquality.so {stop if "with-a"} tail {continue if "with-b"}
 {include if (not "with-d")}

# a comment line
=== usr/share/authselect/vendor/tprof/nsswitch.conf 174
auth        sufficient    pam_unix.so nullok {stop if "with-d"} tail {if not "with-b" or "with-a" or ("with-d"):yes_text|no_text}
auth        required      pam_env.so
    {}

=== usr/share/authselect/vendor/tprof/password-auth 449
auth        required      pam_env.so {if "with-a":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {if "with-a" tail {if "with-a":yes_text|no_text}
password    requisite     pam_pwquality.so {include if "with-a" or (not "with-c")} tail {if "with-c":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {if :x}
   
auth        required      pam_env.so {if "with-c":yes_text|no_text}
password    requisite     pam_pwquality.so

