=== usr/share/authselect/vendor/tprof/smartcard-auth 96
password    requisite     pam_pwquality.so {exclude if "with-c"} tail {exclude if not "with-b"}

=== usr/share/authselect/vendor/tprof/system-auth 237
session     optional      pam_keyinit.so revoke
# a comment line {exclude if not not "with-b" and "with-a"}
auth        required      pam_env.so {exclude if "with-d"} tail {imply "with-b" if (not "with-d") and not "with-c" and "with-d"}

