=== usr/share/authselect/vendor/tprof/nsswitch.conf 561
    {if "with-d":only_yes}
session     optional      pam_keyinit.so revoke {if not "with-a":yes_text|no_text} tail {if "with-d":yes_text|no_text}
    {imply "with-a" if "with-a"}
auth        sufficient    pam_unix.so nullok
auth        sufficient    pam_unix.so nullok {include if "with-a"}
# a comment line {exclude if "with-c"}
password    requisite     pam_pwquality.so {imply "with-d" if "with-c"}
 {stop if "with-a"} tail {imply "with-d" if "with-a"}
account     required      pam_unix.so {continue if "with-a"} tail {continue if (("with-b" or "with-c"))}

