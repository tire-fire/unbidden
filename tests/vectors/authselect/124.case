# a comment line
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/smartcard-auth 684
{include if ("with-b")}
auth        required      pam_env.so {continue if not ("with-c")} tail {if not ("with-a") or ("with-b"):only_yes}
auth        sufficient    pam_unix.so nullok {if "with-a" tail {continue if "with-d"}
auth        required      pam_env.so {exclude if "with-b" or "with-d" and "with-d" or "with-d" and "with-b"}
auth        required      pam_env.so {imply "with-d" if "with-d"}
 {imply "with-a" if ("with-c")} tail {include if "with-c"}
# a comment line
account     required      pam_unix.so {exclude if (("with-d"))}
# a comment line
session     optional      pam_keyinit.so revoke {exclude if not "with-c"} tail {if "with-c" and "with-c" and "with-c":only_yes}

=== usr/share/authselect/vendor/tprof/system-auth 448
{exclude if ("with-a")}
auth        required      pam_env.so {exclude if "with-c" and "with-d"} tail {if "with-a":yes_text|no_text}
account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok {if not not "with-a" or (not "with-b"):yes_text|no_text}
auth        required      pam_env.so {if "with-c" or ("with-a") or "with-d":only_yes} tail {include if "with-c"}
    {include if ((not "with-a"))}
{if (not "with-a"):only_yes}

