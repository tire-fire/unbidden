{include if "with-b"}
auth        required      pam_env.so
auth        required      pam_env.so
{if "with-a":yes_text|no_text}
{stop if ("with-d" and "with-a")}
account     required      pam_unix.so {include if "with-c"}
    {if not not not "with-b":yes_text|no_text} tail {if ("with-d"):yes_text|no_text}
