=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 691
# a comment line {continue if "with-d" and ("with-c") and "with-c" and "with-c"}
 {exclude if "with-b"}
    {continue if ("with-c")} tail {if not "with-a":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-a"
    {if (("with-d" and "with-c")):only_yes}

account     required      pam_unix.so {include if "with-d"}
{if ("with-d") or "with-a" or ("with-c"):only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not not "with-a" and ("with-c") or "with-b" or "with-b"} tail {stop if not "with-c"}
# a comment line {continue if ("with-d")} tail {if ((("with-b"))):yes_text|no_text}

