=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 37
account     required      pam_unix.so
=== usr/share/authselect/vendor/tprof/password-auth 198
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so
# a comment line {stop if "with-c"}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/postlogin 453
{include if "with-a"}
auth        sufficient    pam_unix.so nullok
session     optional      pam_keyinit.so revoke
 {if "with-d":yes_text|no_text}
   
# a comment line
# a comment line {if "with-b" and "with-a":yes_text|no_text}
auth        required      pam_env.so {continue if not "with-a"}
auth        sufficient    pam_unix.so nullok
 {if not "with-c" or not "with-c":yes_text|no_text} tail {imply "with-d" if not "with-a" and "with-a" or "with-b"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 332
{include if "with-b"}
auth        required      pam_env.so
{continue if ("with-d") and not ("with-b")}
{if "with-b":yes_text|no_text}
session     optional      pam_keyinit.so revoke {if not "with-c":only_yes}
    {stop if "with-b"}
auth        required      pam_env.so {imply "with-a" if "with-a"} tail {imply "with-a" if "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 301
session     optional      pam_keyinit.so revoke
{continue if ("with-a")}
account     required      pam_unix.so
{if "with-d":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
{continue if not "with-c" and not "with-b"}
session     optional      pam_keyinit.so revoke {exclude if "with-c"}

