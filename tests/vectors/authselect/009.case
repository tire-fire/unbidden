=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 55
{include if}
# a comment line {stop if not ("with-a")}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 17
# a comment line

=== usr/share/authselect/vendor/tprof/password-auth 200
password    requisite     pam_pwquality.so {continue if (("with-a" and "with-a"))}
    {stop if "with-c"}
# a comment line
auth        required      pam_env.so {exclude if not "with-b" and "with-a"}


=== usr/share/authselect/vendor/tprof/postlogin 174
    {include if "with-d"}
 {include if} tail {if "with-c":yes_text|no_text}
session     optional      pam_keyinit.so revoke {if (not "with-b" and "with-b"):yes_text|no_text}

=== usr/share/authselect/vendor/tprof/smartcard-auth 260
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-b"}
 {exclude if not "with-b" or not "with-b"}
password    requisite     pam_pwquality.so {if "with-c":yes_text|no_text}
{imply "with-c" if not "with-c"}

=== usr/share/authselect/vendor/tprof/system-auth 332
auth        required      pam_env.so
account     required      pam_unix.so {stop if "with-b"} tail {imply "with-b" if ("with-c") or "with-b"}
password    requisite     pam_pwquality.so
{exclude if ("with-b" or "with-d")}
{if "with-c":only_yes}
{include if "with-d" and "with-c"}
    {exclude if "with-d"} tail {include if "with-c"}

