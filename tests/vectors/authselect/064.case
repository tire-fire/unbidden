=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 4
   

=== usr/share/authselect/vendor/tprof/nsswitch.conf 229
password    requisite     pam_pwquality.so {if "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if ("with-d")}
password    requisite     pam_pwquality.so

=== usr/share/authselect/vendor/tprof/password-auth 635
account     required      pam_unix.so {include if "with-d"}
password    requisite     pam_pwquality.so {exclude if ("with-a" and "with-b") and "with-c" and "with-a"} tail {if (("with-b") or ("with-c")):only_yes}
password    requisite     pam_pwquality.so {if "with-a":only_yes} tail {if not "with-a":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {exclude if (("with-b") and "with-a")} tail {include if (not "with-b")}
    {if "with-d" or "with-c":yes_text|no_text}
{imply "with-c" if "with-b" or "with-a" and "with-a"}
auth        required      pam_env.so {if ("with-c"):yes_text|no_text} tail {continue if ("with-c")}
=== usr/share/authselect/vendor/tprof/postlogin 528
password    requisite     pam_pwquality.so {if "with-b":yes_text|no_text} tail {exclude if not not "with-b"}
# a comment line
session     optional      pam_keyinit.so revoke {exclude if "with-c"}
{if "with-c":yes_text|no_text}
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-a" if "with-c"}
{if "with-b" or ("with-c") or "with-a":yes_text|no_text}
password    requisite     pam_pwquality.so {include if "with-d"}
{exclude if ("with-d")}

=== usr/share/authselect/vendor/tprof/smartcard-auth 141
auth        sufficient    pam_unix.so nullok {continue if "with-b"} tail {if not "with-b" and ("with-a") and "with-a" and "with-a":only_yes}

=== usr/share/authselect/vendor/tprof/system-auth 440
auth        required      pam_env.so
{bogus "with-a"}
{if "with-c" or "with-a" and "with-c" and "with-d":yes_text|no_text}
    {if ("with-c" or "with-a") and not not "with-d":only_yes}
password    requisite     pam_pwquality.so {if "with-d":only_yes}
account     required      pam_unix.so {exclude if ("with-d") and not "with-a"}
   
account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok {if "with-d":only_yes}

