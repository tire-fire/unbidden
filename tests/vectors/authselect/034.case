=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 490
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

    {if "with-c":yes_text|no_text} tail {exclude if "with-b"}
{include if "with-b" and "with-a" or ("with-c") or ("with-a" or "with-b")}
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/nsswitch.conf 297
{if not "with-c":yes_text|no_text}
# a comment line {if "with-d":yes_text|no_text}
{if (("with-a") or ("with-a")):yes_text|no_text}
# a comment line {if ("with-a") or "with-a" or not "with-c":only_yes}
   
account     required      pam_unix.so {if "with-a" tail {exclude if "with-d" and "with-c"}

=== usr/share/authselect/vendor/tprof/password-auth 234
account     required      pam_unix.so
# a comment line
session     optional      pam_keyinit.so revoke
{include if "with-a"}
auth        sufficient    pam_unix.so nullok {include if (not not "with-a")}
 {imply "with-d" if ("with-d")}

=== usr/share/authselect/vendor/tprof/smartcard-auth 575
account     required      pam_unix.so {exclude if ("with-d")}
# a comment line {imply "with-d" if "with-d"}
{continue if not "with-c"}
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not not "with-b"} tail {imply "with-d" if not "with-b"}
password    requisite     pam_pwquality.so {stop if "with-d"}
session     optional      pam_keyinit.so revoke {continue if not "with-b"} tail {}
session     optional      pam_keyinit.so revoke {include if "with-a"} tail {include if "with-d"}
=== usr/share/authselect/vendor/tprof/system-auth 425
    {exclude if "with-b"}
auth        required      pam_env.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b" and "with-a" or "with-c":yes_text|no_text}
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{include if "with-c" or "with-b"}
{include if "with-d"}
{if (not ("with-c")):only_yes}

