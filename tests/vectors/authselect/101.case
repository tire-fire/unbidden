=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 663
session     optional      pam_keyinit.so revoke {include if "with-a"} tail {imply "with-c" if "with-b" or "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not "with-d" or ("with-c") or not "with-b" and "with-c" or "with-b"} tail {imply "with-d" if not ("with-c") or "with-c"}
{continue if "with-d"}
password    requisite     pam_pwquality.so
{if not "with-c" or "with-d" and (("with-b")):yes_text|no_text}
auth        required      pam_env.so {if "with-b":only_yes}
# a comment line
# a comment line {if "with-c" and "with-b" and "with-b":yes_text|no_text} tail {if not "with-d" and "with-d":only_yes}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 474
 {exclude if "with-b"}
auth        sufficient    pam_unix.so nullok {include if "with-c" and "with-d" or "with-a" or "with-c"}
password    requisite     pam_pwquality.so {continue if ("with-d")} tail {continue if ("with-a")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        required      pam_env.so {include if "with-a"} tail {continue if not "with-c" or "with-d" and "with-d"}
auth        sufficient    pam_unix.so nullok

=== usr/share/authselect/vendor/tprof/password-auth 563
{continue if "with-c"}
{include if "with-c"}
auth        sufficient    pam_unix.so nullok {exclude if ("with-c" or "with-a" and "with-a")} tail {exclude if ("with-b" and "with-c") and not "with-b" and "with-d"}
auth        required      pam_env.so {include if ("with-d")}
account     required      pam_unix.so {stop if "with-b" or not not "with-d"}
{continue if not "with-d"}
auth        required      pam_env.so {continue if ("with-c")} tail {}
    {continue if (("with-b"))}
{if "with-c" or "with-a":yes_text|no_text}
password    requisite     pam_pwquality.so

