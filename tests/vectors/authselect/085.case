=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 452
   
account     required      pam_unix.so {include if not "with-b" or "with-d"} tail {exclude if not not "with-d"}
{exclude if "with-a"}
account     required      pam_unix.so {include if ((not "with-a"))}
session     optional      pam_keyinit.so revoke {if "with-a":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/nsswitch.conf 157
{include if "with-a"}
 {continue if not ("with-a") or (not "with-d")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
=== usr/share/authselect/vendor/tprof/password-auth 285
account     required      pam_unix.so {include if "with-a"}
session     optional      pam_keyinit.so revoke {imply "with-b" if "with-b"}

account     required      pam_unix.so
session     optional      pam_keyinit.so revoke {continue if "with-c" or "with-d" or ("with-c") and "with-b"}
=== usr/share/authselect/vendor/tprof/postlogin 497
session     optional      pam_keyinit.so revoke {stop if ("with-d" or "with-b")} tail {continue if not ("with-a")}
{include if ((not "with-b"))}
auth        required      pam_env.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if "with-c" and "with-b" and "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke {imply "with-d" if "with-c" and "with-c"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 496
{if "with-b":only_yes}
 {if "with-c" and ("with-c" and "with-d"):yes_text|no_text} tail {include if "with-d"}
   
{if "with-c":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if ("with-b")} tail {include if "with-c"}
session     optional      pam_keyinit.so revoke {stop if "with-b"}
auth        sufficient    pam_unix.so nullok {continue if "with-a"}
password    requisite     pam_pwquality.so
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/system-auth 427
   
 {if "with-d":only_yes}

# a comment line
password    requisite     pam_pwquality.so {exclude if "with-a"}
auth        required      pam_env.so {exclude if ("with-d" and not "with-a")}
auth        sufficient    pam_unix.so nullok {continue if "with-b"}
account     required      pam_unix.so {if "with-c":only_yes} tail {continue if "with-c" and "with-c" or "with-a" or "with-d" and "with-b"}
{if "with-b":yes_text|no_text}

