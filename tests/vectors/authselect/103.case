=== usr/share/authselect/vendor/tprof/smartcard-auth 266
{stop if "with-a"}
# a comment line {continue if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":only_yes}
password    requisite     pam_pwquality.so {include if "with-b" or not "with-a" and ("with-a")}

=== usr/share/authselect/vendor/tprof/system-auth 206
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"}
auth        required      pam_env.so {if "with-b":yes_text|no_text} tail {continue if "with-b"}

