=== usr/share/authselect/vendor/tprof/postlogin 333
# a comment line {continue if not "with-c"}
# a comment line {stop if "with-a"}
session     optional      pam_keyinit.so revoke
# a comment line {if (("with-a") and "with-b"):yes_text|no_text}
auth        required      pam_env.so
account     required      pam_unix.so
session     optional      pam_keyinit.so revoke
