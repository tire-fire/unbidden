=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 715
auth        required      pam_env.so {if "with-b":only_yes} tail {if not not "with-d" and "with-b":yes_text|no_text}
account     required      pam_unix.so {stop if "with-c" and "with-a" and "with-c" or "with-b"}
{exclude if "with-d"}
   
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok {exclude if "with-d"}
session     optional      pam_keyinit.so revoke
 {include if "with-b"} tail {if "with-a" or "with-a" or "with-c" and "with-d" or "with-b" or "with-d" and "with-a":only_yes}
password    requisite     pam_pwquality.so {continue if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if (("with-c") or "with-d")}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 194
 {imply "with-b" if "with-c"}
{if "with-c":only_yes}
# a comment line
