auth        required      pam_env.so {continue if not "with-b" or "with-c" and not "with-c" or ("with-d")}
=== usr/share/authselect/vendor/tprof/password-auth 249
 {include if not "with-c" and "with-d" or "with-c" and "with-a" and "with-b"}
{if ("with-b") or "with-b":only_yes}
account     required      pam_unix.so
password    requisite     pam_pwquality.so {if not ("with-a") or not "with-b":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/postlogin 216
{continue if not "with-c" or "with-b"}
    {stop if not "with-c"} tail {exclude if "with-c"}
 {imply "with-a" if not "with-a" and "with-c"}

auth        sufficient    pam_unix.so nullok {imply "with-a" if "with-a"}


