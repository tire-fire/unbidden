=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 422
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-d"}
auth        sufficient    pam_unix.so nullok
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if "with-a" or "with-b"}
 {imply "with-d" if "with-c"} tail {continue if ("with-d")}

=== usr/share/authselect/vendor/tprof/system-auth 437
{bogus "with-a"}
{imply "with-a" if "with-d"}
# a comment line
auth        required      pam_env.so {exclude if not ("with-d")} tail {include if not ("with-b") or "with-c"}
# a comment line
password    requisite     pam_pwquality.so {imply "with-d" if "with-d" or "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-b"} tail {imply "with-b" if ("with-d")}
# a comment line

