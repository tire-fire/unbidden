=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 301
session     optional      pam_keyinit.so revoke {imply "with-d" if "with-b"}
auth        required      pam_env.so
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if (not "with-c") or not "with-a" or "with-b"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 453
   
auth        required      pam_env.so

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     optional      pam_keyinit.so revoke
account     required      pam_unix.so
auth        sufficient    pam_unix.so nullok
{if "with-a":only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if not (not "with-a")}
session     optional      pam_keyinit.so revoke

=== usr/share/authselect/vendor/tprof/password-auth 350
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so {exclude if ("with-a")}
auth        sufficient    pam_unix.so nullok {if "with-a"
# a comment line {include if not (("with-d"))} tail {imply "with-d" if (not "with-b")}
account     required      pam_unix.so {if not "with-a" or "with-a" and "with-d":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/postlogin 227
   
    {if "with-c":yes_text|no_text} tail {exclude if "with-a"}
# a comment line
{include if "with-d"}
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so
# a comment line {continue if "with-d"}
=== usr/share/authselect/vendor/tprof/smartcard-auth 214
{imply "with-d" if not "with-d"}
# a comment line {imply "with-a" if not "with-c"}
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/system-auth 256
 {exclude if "with-c"}
    {if "with-c":yes_text|no_text} tail {if "with-d" and "with-c" or ("with-a"):yes_text|no_text}
auth        sufficient    pam_unix.so nullok {include if "with-d"}
auth        required      pam_env.so {if "with-a":yes_text|no_text}

