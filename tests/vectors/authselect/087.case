=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 384
session     optional      pam_keyinit.so revoke {imply "with-a" if ("with-b") and "with-a"}
# a comment line
# a comment line {imply "with-c" if "with-c"}
session     optional      pam_keyinit.so revoke {continue if "with-a" or ("with-c") and "with-b"}
{include if not "with-b" or "with-c" and not "with-c"}
{if ((("with-d"))):yes_text|no_text}
# a comment line {include if "with-b"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 164
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-c"}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/password-auth 489
# a comment line {if "with-a":only_yes}
auth        required      pam_env.so {exclude if "with-b"}
 {include if "with-b" and "with-d"} tail {exclude if "with-a"}
session     optional      pam_keyinit.so revoke {if "with-c":only_yes}
# a comment line
# a comment line
 {if "with-a":yes_text|no_text} tail {exclude if "with-c" or ("with-c")}
# a comment line {if "with-c":yes_text|no_text}
{if "with-c":only_yes}
password    requisite     pam_pwquality.so {if not "with-a":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/postlogin 342
password    requisite     pam_pwquality.so {exclude if "with-c"}
password    requisite     pam_pwquality.so
auth        required      pam_env.so
account     required      pam_unix.so
    {exclude if "with-b" and not "with-a" and "with-d"}
session     optional      pam_keyinit.so revoke {include if "with-b"} tail {exclude if not ("with-d")}

=== usr/share/authselect/vendor/tprof/smartcard-auth 371
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so {exclude if "with-d"}
   
# a comment line
session     optional      pam_keyinit.so revoke
   
# a comment line {continue if "with-a"} tail {imply "with-b" if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{if "with-d":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/system-auth 415
# a comment line
{continue if "with-a"}
{if :x}
auth        required      pam_env.so
account     required      pam_unix.so {continue if (not "with-d") or ("with-b")}
account     required      pam_unix.so
password    requisite     pam_pwquality.so
 {exclude if "with-d"}
auth        sufficient    pam_unix.so nullok {if "with-a":only_yes} tail {continue if ("with-c")}
{stop if not "with-a" or "with-a" or "with-d"}

