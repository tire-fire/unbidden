=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 450
auth        sufficient    pam_unix.so nullok {if ("with-c" or ("with-c")):yes_text|no_text}
auth        required      pam_env.so
password    requisite     pam_pwquality.so {exclude if not "with-c"} tail {if "with-d" and ("with-c") or ("with-d") or "with-b":only_yes}
{continue if (("with-c"))}
password    requisite     pam_pwquality.so {include if "with-c"}
session     optional      pam_keyinit.so revoke
password    requisite     pam_pwquality.so

=== usr/share/authselect/vendor/tprof/nsswitch.conf 679
auth        required      pam_env.so {continue if "with-b"} tail {if "with-d":only_yes}
account     required      pam_unix.so
account     required      pam_unix.so {continue if "with-a"} tail {if "with-a":yes_text|no_text}
session     optional      pam_keyinit.so revoke {imply "with-a" if not not "with-d" and "with-c"} tail {exclude if ("with-d")}
# a comment line {include if "with-c" or "with-c" or "with-d" and "with-d"}
 {continue if ((not "with-d"))} tail {if "with-b":yes_text|no_text}
password    requisite     pam_pwquality.so {if "with-c" and ("with-d") and not "with-d":only_yes}
auth        required      pam_env.so {include if "with-d" and "with-a" and ("with-c")}

=== usr/share/authselect/vendor/tprof/password-auth 740
 {imply "with-c" if not "with-a" and "with-d" or not "with-c" or "with-d"} tail {include if not "with-b"}
auth        sufficient    pam_unix.so nullok {if "with-a":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {stop if not (not "with-b")} tail {exclude if "with-c"}
auth        required      pam_env.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
auth        sufficient    pam_unix.so nullok {stop if not "with-a" and not "with-a"} tail {continue if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/postlogin 26
 {continue if ("with-a")}

=== usr/share/authselect/vendor/tprof/smartcard-auth 224
auth        sufficient    pam_unix.so nullok {continue if ("with-c")}
session     optional      pam_keyinit.so revoke {if "with-a":only_yes}
auth        sufficient    pam_unix.so nullok {include if "with-a" or not "with-a"}

=== usr/share/authselect/vendor/tprof/system-auth 307
{stop if "with-d"}
{if not "with-c":yes_text|no_text}
account     required      pam_unix.so {imply "with-b" if "with-d"}
    {imply "with-b" if "with-d"} tail {imply "with-c" if (("with-c" or "with-a"))}

session     optional      pam_keyinit.so revoke
account     required      pam_unix.so
