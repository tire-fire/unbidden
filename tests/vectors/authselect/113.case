=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 190
auth        required      pam_env.so {stop if (not "with-d" or ("with-d"))}
# a comment line {if "with-d":yes_text|no_text}
auth        required      pam_env.so
{imply "with-b" if "with-c"}

=== usr/share/authselect/vendor/tprof/password-auth 94
session     optional      pam_keyinit.so revoke
{if "with-a":only_yes}
 {exclude if "with-c"}

=== usr/share/authselect/vendor/tprof/postlogin 571
   
    {continue if "with-d"}
account     required      pam_unix.so {exclude if "with-c"} tail {exclude if "with-b"}
{include if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not ("with-d"):only_yes}
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{stop if "with-d" and "with-d"}
auth        sufficient    pam_unix.so nullok {imply "with-d" if "with-c"} tail {exclude if "with-b"}
auth        sufficient    pam_unix.so nullok {if "with-d":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/smartcard-auth 346
session     optional      pam_keyinit.so revoke {include if ("with-d" or "with-c")}
{include if "with-b" and "with-c"}
account     required      pam_unix.so {exclude if "with-d"}
session     optional      pam_keyinit.so revoke
# a comment line
account     required      pam_unix.so {include if ("with-c")} tail {if not "with-b":yes_text|no_text}

