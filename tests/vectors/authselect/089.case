=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 347
account     required      pam_unix.so {exclude if "with-d"}
auth        sufficient    pam_unix.so nullok {if "with-a" or not "with-d" and "with-c":yes_text|no_text} tail {continue if "with-c"}
# a comment line
{include if "with-c"}

session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-c":only_yes}
=== usr/share/authselect/vendor/tprof/nsswitch.conf 539
# a comment line {include if ((("with-d")))} tail {if "with-a":only_yes}
auth        sufficient    pam_unix.so nullok
password    requisite     pam_pwquality.so {if :x}
{continue if (not "with-a") or ("with-b" and "with-a")}
{include if (not "with-b" or "with-d")}
session     optional      pam_keyinit.so revoke {include if ((not "with-b"))}
    {include if "with-b"} tail {exclude if "with-c"}
# a comment line {}
auth        required      pam_env.so {include if "with-a"}
{include if "with-c" and not "with-c" and "with-c" or "with-b"}

=== usr/share/authselect/vendor/tprof/password-auth 222
# a comment line
auth        required      pam_env.so {if "with-c":yes_text|no_text}
auth        required      pam_env.so {exclude if "with-c"} tail {stop if ("with-b") and "with-c" and "with-b" or "with-a" or ("with-b")}

=== usr/share/authselect/vendor/tprof/postlogin 305
# a comment line {continue if "with-c"} tail {if "with-a" and "with-d" or "with-a":only_yes}
{if "with-b" and ("with-a" or "with-a"):yes_text|no_text}

{if "with-d":yes_text|no_text}
# a comment line {stop if ("with-a")} tail {imply "with-d" if ("with-a" and "with-d" and "with-a")}
{exclude if "with-c"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 107
{if "with-d":only_yes}
{if "with-d" and ("with-c"):only_yes}
 {exclude if "with-c"}
    {stop if "with-b"}

=== usr/share/authselect/vendor/tprof/system-auth 460
auth        sufficient    pam_unix.so nullok {stop if "with-a"} tail {stop if "with-c" or not "with-d" or not "with-b"}
auth        sufficient    pam_unix.so nullok {include if} tail {if "with-b" or "with-c":yes_text|no_text}
auth        sufficient    pam_unix.so nullok {include if "with-b"}
{if "with-d":only_yes}
password    requisite     pam_pwquality.so {include if "with-a"} tail {if "with-d":yes_text|no_text}
{if "with-c" or "with-d":yes_text|no_text}

