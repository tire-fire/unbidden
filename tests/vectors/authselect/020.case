=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 457
account     required      pam_unix.so {stop if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{continue if "with-b" or "with-d" or "with-c" and "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if not "with-c" or not "with-c"}
# a comment line
    {exclude if ("with-c")}
auth        sufficient    pam_unix.so nullok {stop if "with-d" or "with-b"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 372
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{include if "with-c"}
account     required      pam_unix.so {include if "with-d"}
auth        sufficient    pam_unix.so nullok {stop if not "with-c"}
password    requisite     pam_pwquality.so
session     optional      pam_keyinit.so revoke {if "with-b" or "with-a":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 368
# a comment line {bogus "with-a"}
session     optional      pam_keyinit.so revoke
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-c"} tail {imply "with-c" if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-d" if not "with-b"}
{include if "with-c"}
=== usr/share/authselect/vendor/tprof/postlogin 287
password    requisite     pam_pwquality.so {continue if "with-d"}
auth        required      pam_env.so {exclude if "with-b" and not "with-c" and "with-b"}
{include if}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/smartcard-auth 309
session     optional      pam_keyinit.so revoke {imply "with-b" if "with-c"} tail {if not not ("with-d"):only_yes}
password    requisite     pam_pwquality.so
{include if (("with-d"))}
account     required      pam_unix.so {exclude if (not ("with-d"))} tail {include if not "with-a" or "with-a" or ("with-d")}

=== usr/share/authselect/vendor/tprof/system-auth 96
auth        required      pam_env.so
# a comment line
password    requisite     pam_pwquality.so
