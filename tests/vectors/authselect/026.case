=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 370
account     required      pam_unix.so
{if "with-d":yes_text|no_text}
session     optional      pam_keyinit.so revoke
{continue if "with-b"}
password    requisite     pam_pwquality.so {include if "with-a" or ("with-c") or not not "with-d"} tail {if ("with-a") and "with-c" or "with-c":only_yes}
auth        required      pam_env.so {exclude if "with-d"}
# a comment line

=== usr/share/authselect/vendor/tprof/nsswitch.conf 128
account     required      pam_unix.so {include if "with-a"} tail {continue if ("with-b" or "with-b" and "with-d" and "with-c")}

=== usr/share/authselect/vendor/tprof/password-auth 278
{stop if ("with-a")}
# a comment line
    {if ("with-a":x}
# a comment line
auth        required      pam_env.so
    {imply "with-d" if "with-b" and not "with-a" or "with-a"} tail {if not "with-d" and "with-b" and "with-d":only_yes}
{exclude if not ("with-a")}
# a comment line

=== usr/share/authselect/vendor/tprof/postlogin 68
account     required      pam_unix.so {exclude if not not "with-c"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 25
{include if not "with-c"}
