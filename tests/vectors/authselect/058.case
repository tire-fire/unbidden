=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 315
auth        sufficient    pam_unix.so nullok {if not "with-d" and "with-a" or "with-b":yes_text|no_text}
account     required      pam_unix.so {if "with-c":only_yes}
password    requisite     pam_pwquality.so {include if ("with-c")}
 {if "with-d" or not "with-b" and not "with-a":yes_text|no_text}
# a comment line

=== usr/share/authselect/vendor/tprof/nsswitch.conf 771
{stop if (("with-c")) and "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-d"}
session     optional      pam_keyinit.so revoke {bogus "with-a"} tail {exclude if "with-c"}
account     required      pam_unix.so {exclude if not "with-c" or "with-a" or not "with-a" and "with-d"}
auth        sufficient    pam_unix.so nullok {if (("with-d")) and "with-c":yes_text|no_text} tail {continue if not ("with-c" or "with-b")}
   
account     required      pam_unix.so {include if "with-c"} tail {include if "with-c"}
auth        sufficient    pam_unix.so nullok {stop if not "with-a" or "with-d" or "with-b" or ("with-c")} tail {if "with-c" or not "with-a" or "with-b":yes_text|no_text}
{continue if not "with-b"}


=== usr/share/authselect/vendor/tprof/password-auth 370
account     required      pam_unix.so
 {exclude if "with-d"}
   
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so {exclude if "with-d" or "with-a"} tail {imply "with-b" if "with-b"}
session     optional      pam_keyinit.so revoke {stop if "with-c" or "with-d" and "with-a"}

{exclude if ("with-a")}
auth        required      pam_env.so

