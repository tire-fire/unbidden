=== usr/share/authselect/vendor/tprof/system-auth 333
auth        required      pam_env.so {bogus "with-a"} tail {exclude if "with-d"}
auth        required      pam_env.so {imply "with-d" if "with-d"} tail {continue if "with-c" or not "with-d" or "with-c"}
{if "with-d" and "with-b" and "with-c":only_yes}
password    requisite     pam_pwquality.so
