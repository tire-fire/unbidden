=== usr/share/authselect/vendor/tprof/password-auth 612
 {continue if "with-a" or "with-b"}
    {continue if ("with-b") and not "with-a"} tail {exclude if "with-b"}
session     optional      pam_keyinit.so revoke {include if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {bogus "with-a"} tail {if "with-b":yes_text|no_text}
account     required      pam_unix.so
session     optional      pam_keyinit.so revoke {imply "with-d" if "with-a" and "with-d" or "with-a" or "with-d" or ("with-d")} tail {imply "with-b" if "with-b"}
 {if "with-c":yes_text|no_text}
account     required      pam_unix.so {include if "with-a"}

