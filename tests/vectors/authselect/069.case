=== usr/share/authselect/vendor/tprof/postlogin 372
account     required      pam_unix.so
{imply "with-d" if not "with-a" and "with-c" or ("with-b")}
auth        required      pam_env.so
password    requisite     pam_pwquality.so
auth        required      pam_env.so {include if "with-c"}
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
   

=== usr/share/authselect/vendor/tprof/smartcard-auth 160
auth        sufficient    pam_unix.so nullok {include if not "with-d" or "with-b" and not "with-a"}
account     required      pam_unix.so {if "with-c":only_yes}
=== usr/share/authselect/vendor/tprof/system-auth 324
   
auth        required      pam_env.so
{exclude if "with-a"}
auth        required      pam_env.so
{include if ("with-d")}
{exclude if ("with-d" and "with-a" and ("with-d"))}
auth        required      pam_env.so
