=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 466
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{imply "with-d" if "with-b"}
session     optional      pam_keyinit.so revoke {if "with-d":yes_text|no_text}
auth        required      pam_env.so
auth        required      pam_env.so
password    requisite     pam_pwquality.so
auth        sufficient    pam_unix.so nullok {if (not "with-d") or "with-c" or not "with-b":yes_text|no_text}
password    requisite     pam_pwquality.so

=== usr/share/authselect/vendor/tprof/nsswitch.conf 141
session     optional      pam_keyinit.so revoke {stop if ("with-d" or "with-c")}
account     required      pam_unix.so {include if "with-b"}

=== usr/share/authselect/vendor/tprof/password-auth 191
auth        sufficient    pam_unix.so nullok
auth        required      pam_env.so
account     required      pam_unix.so {stop if not "with-b"} tail {include if not not "with-b" and "with-d"}

=== usr/share/authselect/vendor/tprof/postlogin 469
{if "with-a":only_yes}
# a comment line {continue if "with-c"}
account     required      pam_unix.so
# a comment line {exclude if not "with-b" and "with-d" or "with-d" or ("with-c")} tail {exclude if ("with-b") or "with-d" or ("with-c")}
    {exclude if "with-d"} tail {imply "with-b" if "with-d"}
session     optional      pam_keyinit.so revoke {if not not ("with-c"):yes_text|no_text}
{continue if not "with-d" and "with-b"}
   
account     required      pam_unix.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 387
session     optional      pam_keyinit.so revoke {include if "with-a"}
password    requisite     pam_pwquality.so {if ("with-a"):only_yes} tail {continue if ("with-b")}
# a comment line
password    requisite     pam_pwquality.so
{if "with-c":yes_text|no_text}
    {exclude if not ("with-d") or ("with-c" and "with-b")} tail {if "with-a":only_yes}
{include if not ("with-c" and "with-c")}

=== usr/share/authselect/vendor/tprof/system-auth 231
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-b":only_yes}
{if not "with-b":yes_text|no_text}
password    requisite     pam_pwquality.so
