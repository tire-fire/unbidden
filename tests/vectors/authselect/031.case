=== usr/share/authselect/vendor/tprof/fingerprint-auth 446
account     required      pam_unix.so
password    requisite     pam_pwquality.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-d"}
account     required      pam_unix.so
{continue if "with-a"}
# a comment line {continue if (not "with-c") and ("with-d" and "with-d")} tail {stop if "with-c"}
account     required      pam_unix.so {exclude if "with-b"}
auth        required      pam_env.so
=== usr/share/authselect/vendor/tprof/password-auth 382
session     optional      pam_keyinit.so revoke
session     optional      pam_keyinit.so revoke
{stop if (not not "with-c")}
auth        sufficient    pam_unix.so nullok {if "with-b":yes_text|no_text}
 {if ("with-c"):only_yes} tail {exclude if "with-d"}
auth        required      pam_env.so
auth        sufficient    pam_unix.so nullok
{exclude if "with-a"}
{include if ("with-d")}

