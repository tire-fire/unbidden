=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 275
auth        required      pam_env.so
{stop if not ("with-b")}
    {continue if "with-d"} tail {include if not "with-b" or "with-d"}
# a comment line {exclude if ("with-b")}
password    requisite     pam_pwquality.so
auth        required      pam_env.so
{include if "with-b"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 507
session     optional      pam_keyinit.so revoke {stop if not "with-d" or "with-a"}
auth        required      pam_env.so {if ("with-b"):yes_text|no_text} tail {exclude if "with-c" or "with-b" and "with-a" or ("with-c") and "with-d"}
# a comment line {include if ("with-d")}
{include if "with-c"}
auth        sufficient    pam_unix.so nullok
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{exclude if "with-d"}
# a comment line {if "with-c":only_yes}

=== usr/share/authselect/vendor/tprof/password-auth 265
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if ("with-b")}
auth        required      pam_env.so {if "with-c" or "with-d":yes_text|no_text} tail {if "with-a":only_yes}
auth        sufficient    pam_unix.so nullok
=== usr/share/authselect/vendor/tprof/smartcard-auth 203
auth        sufficient    pam_unix.so nullok {if "with-c":only_yes} tail {if "with-d":yes_text|no_text}
session     optional      pam_keyinit.so revoke
   
session     optional      pam_keyinit.so revoke
