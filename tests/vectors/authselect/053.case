{include if "with-a"}
{include if}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if ("with-c"):only_yes} tail {stop if "with-c"}
password    requisite     pam_pwquality.so
auth        required      pam_env.so
{if "with-b" and ("with-d"):only_yes}
account     required      pam_unix.so
{if :x}

