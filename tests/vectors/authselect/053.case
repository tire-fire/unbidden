=== usr/share/authselect/vendor/tprof/nsswitch.conf 397
session     optional      pam_keyinit.so revoke
session     optional      pam_keyinit.so revoke
{continue if "with-a"}
{include if (not "with-d")}
auth        sufficient    pam_unix.so nullok {continue if "with-d" or "with-b"}

auth        sufficient    pam_unix.so nullok {continue if (("with-d"))}
