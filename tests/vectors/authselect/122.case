=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 508
{}
 {exclude if ("with-c")}
session     optional      pam_keyinit.so revoke
 {stop if "with-a" and "with-d" and "with-b" or "with-b"}
session     optional      pam_keyinit.so revoke {if "with-d":yes_text|no_text}
auth        required      pam_env.so {if "with-a" or "with-c" or "with-c" and "with-d":yes_text|no_text} tail {stop if (("with-b"))}
# a comment line {include if "with-a"}
   
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{if "with-a":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 314
auth        sufficient    pam_unix.so nullok
{if "with-d":yes_text|no_text}
# a comment line

{if "with-d":only_yes}
password    requisite     pam_pwquality.so {include if "with-b"}
auth        required      pam_env.so
{stop if ("with-d" and "with-b") and "with-b"}
{stop if "with-d"}
{imply "with-d" if "with-a"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 219
 {include if "with-a" or "with-d" or not "with-c"} tail {include if "with-a" or "with-b"}
password    requisite     pam_pwquality.so {exclude if "with-d"}
{exclude if "with-a" or "with-c" and ("with-b") and ("with-d")}

=== usr/share/authselect/vendor/tprof/system-auth 568
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
password    requisite     pam_pwquality.so {continue if ("with-d")}
session     optional      pam_keyinit.so revoke
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-d":yes_text|no_text}
# a comment line {imply "with-d" if not "with-c" or "with-b" and ("with-b")}
   
session     optional      pam_keyinit.so revoke
# a comment line
 {if "with-a" and "with-d" or not "with-b":yes_text|no_text}

