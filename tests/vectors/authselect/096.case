=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 469
# a comment line {imply "with-c" if not "with-b"}
 {continue if (not "with-d" or "with-d")} tail {include if}
{include if not "with-c"}
auth        sufficient    pam_unix.so nullok {include if "with-d"} tail {if (not "with-a" and "with-d"):only_yes}
session     optional      pam_keyinit.so revoke {exclude if "with-a"}
account     required      pam_unix.so {if "with-a":only_yes} tail {stop if not ("with-c") or ("with-c")}
   
# a comment line {continue if "with-c"}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 93
auth        sufficient    pam_unix.so nullok {continue if "with-a" or "with-a" and "with-c"}

=== usr/share/authselect/vendor/tprof/password-auth 69
password    requisite     pam_pwquality.so {exclude if not "with-b"}

=== usr/share/authselect/vendor/tprof/postlogin 492
account     required      pam_unix.so {if "with-a":only_yes}
 {if ("with-d" and "with-c"):yes_text|no_text}
 {if (("with-c")):only_yes} tail {include if ("with-c") or not not "with-c"}
{include if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if "with-d"} tail {if not not not "with-d":yes_text|no_text}
# a comment line {continue if "with-a"}
    {stop if not "with-d"}
 {include if "with-d"}
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 513
{stop if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
    {include if "with-b" or ("with-d") or not "with-d"}
# a comment line
# a comment line {stop if "with-a" and "with-a" or "with-d" and "with-c"} tail {if ("with-c") or "with-a" and "with-b" or "with-a" and "with-b":yes_text|no_text}
# a comment line {include if "with-c"}
password    requisite     pam_pwquality.so


