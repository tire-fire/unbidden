=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/postlogin 183
auth        sufficient    pam_unix.so nullok
{continue if "with-c"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{continue if not "with-b"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 397
auth        required      pam_env.so
auth        required      pam_env.so
{imply "with-a" if "with-b"}
session     optional      pam_keyinit.so revoke {if "with-b":yes_text|no_text}
auth        required      pam_env.so {if not ("with-a"):yes_text|no_text} tail {include if ("with-a" and "with-c" or "with-d")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
=== usr/share/authselect/vendor/tprof/system-auth 514
account     required      pam_unix.so
   
account     required      pam_unix.so
account     required      pam_unix.so
password    requisite     pam_pwquality.so
auth        required      pam_env.so {include if not ("with-a") or "with-b"}
password    requisite     pam_pwquality.so {bogus "with-a"} tail {if not "with-b":yes_text|no_text}
{exclude if not "with-d" or ("with-b")}
 {if "with-a"
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if "with-c" or "with-a"}

