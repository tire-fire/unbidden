=== usr/share/authselect/vendor/tprof/fingerprint-auth 370

auth        required      pam_env.so
    {imply "with-a" if ("with-b" and "with-a") or "with-c"}
{stop if "with-a"}
account     required      pam_unix.so
account     required      pam_unix.so {exclude if "with-a"} tail {include if not "with-d" or "with-d"}
   
account     required      pam_unix.so {continue if "with-a"}
session     optional      pam_keyinit.so revoke
=== usr/share/authselect/vendor/tprof/nsswitch.conf 429
auth        required      pam_env.so {exclude if not (not "with-c")} tail {if (not "with-d" or "with-d"):yes_text|no_text}
 {exclude if "with-a" and (not "with-c")}
session     optional      pam_keyinit.so revoke
{include if "with-b"}
session     optional      pam_keyinit.so revoke
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
    {continue if not "with-d"} tail {include if "with-c"}

=== usr/share/authselect/vendor/tprof/postlogin 662
auth        required      pam_env.so {if ("with-d"):only_yes}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not "with-b"}
    {if "with-d":only_yes}
{include if "with-a" or not "with-b" and "with-c"}
account     required      pam_unix.so {if "with-c" and "with-a" or "with-d" and "with-d" or "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
# a comment line
password    requisite     pam_pwquality.so {imply "with-d" if "with-a"} tail {continue if not "with-b"}
account     required      pam_unix.so {include if "with-c" or not not "with-b"}

