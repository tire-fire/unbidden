=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 228
   

account     required      pam_unix.so {stop if "with-c"}
password    requisite     pam_pwquality.so
auth        required      pam_env.so
auth        required      pam_env.so {if "with-b":yes_text|no_text}

{if ("with-a":x}

=== usr/share/authselect/vendor/tprof/nsswitch.conf 390
auth        required      pam_env.so {imply "with-d" if "with-a"}
auth        sufficient    pam_unix.so nullok {stop if "with-d" and "with-c" and "with-d"}
    {continue if "with-a"}
 {if "with-c":only_yes} tail {continue if not ("with-d")}
auth        required      pam_env.so
account     required      pam_unix.so {continue if "with-b"}
{if not not "with-a" or "with-a":yes_text|no_text}

=== usr/share/authselect/vendor/tprof/password-auth 258
account     required      pam_unix.so {imply "with-b" if "with-d"} tail {exclude if ("with-c" and "with-a")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
account     required      pam_unix.so {if "with-d":only_yes}

=== usr/share/authselect/vendor/tprof/postlogin 192
auth        sufficient    pam_unix.so nullok {include if "with-c"}
account     required      pam_unix.so {if "with-b":only_yes}

 {if ("with-c"):yes_text|no_text}
 {imply "with-b" if "with-c"}
=== usr/share/authselect/vendor/tprof/smartcard-auth 174
{continue if "with-b"}
auth        required      pam_env.so
{include if ("with-c" and "with-d" or not "with-a")}
auth        required      pam_env.so {exclude if ("with-d")}

=== usr/share/authselect/vendor/tprof/system-auth 367
{include if "with-b"}
{include if not ("with-a" and "with-a")}
# a comment line {stop if "with-d"}
auth        sufficient    pam_unix.so nullok {continue if (("with-b"))} tail {imply "with-d" if ("with-d")}
    {exclude if "with-d" or not "with-b"} tail {if (not "with-b"):yes_text|no_text}
account     required      pam_unix.so {exclude if "with-b" or not "with-c"}

