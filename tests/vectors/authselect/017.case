Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 1


=== usr/share/authselect/vendor/tprof/nsswitch.conf 361
{include if "with-a" and ("with-b")}


session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
 {stop if "with-d"}
account     required      pam_unix.so
# a comment line {stop if not "with-d"}
{if (("with-c")) and "with-b":yes_text|no_text}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/password-auth 448
auth        required      pam_env.so
session     optional      pam_keyinit.so revoke {if (("with-c")):only_yes}
# a comment line {if "with-c" or "with-c" and "with-c" and (("with-d")):yes_text|no_text}
password    requisite     pam_pwquality.so {if ("with-c"):yes_text|no_text} tail {continue if "with-d"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if "with-c":yes_text|no_text}
{if "with-a":only_yes}

=== usr/share/authselect/vendor/tprof/postlogin 174
{include if "with-a"}
{if "with-a"
{if "with-a":only_yes}
{if "with-c":yes_text|no_text}
session     optional      pam_keyinit.so revoke
auth        required      pam_env.so

=== usr/share/authselect/vendor/tprof/smartcard-auth 543
 {continue if "with-c" and "with-b"} tail {include if "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {continue if ("with-c") and not ("with-d")}
auth        required      pam_env.so {continue if "with-c"}
account     required      pam_unix.so {continue if "with-d" or "with-d" and "with-d" or "with-c" or "with-d"}
{include if ("with-d" or ("with-a"))}
session     optional      pam_keyinit.so revoke
auth        sufficient    pam_unix.so nullok {include if "with-a"} tail {stop if "with-a"}

