=== usr/share/authselect/vendor/tprof/nsswitch.conf 282
# a comment line
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {imply "with-b" if "with-b"}
    {continue if not not "with-d" and "with-d"} tail {continue if "with-a"}
    {exclude if "with-a"}
account     required      pam_unix.so {if :x}

