=== usr/share/authselect/vendor/tprof/smartcard-auth 361
{include if "with-d" and (not "with-d")}
{if not "with-a":yes_text|no_text}
 {if ("with-a":x}
password    requisite     pam_pwquality.so {exclude if "with-c" and "with-d"}
password    requisite     pam_pwquality.so {imply "with-d" if ("with-c")}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-c":only_yes}

