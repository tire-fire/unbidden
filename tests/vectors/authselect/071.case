=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 262
auth        sufficient    pam_unix.so nullok
{stop if "with-d"}
 {if not "with-a":yes_text|no_text} tail {if ("with-b") or "with-a":only_yes}
auth        required      pam_env.so {include if ("with-b") or "with-a" and "with-b" and ("with-d")}
{stop if "with-c"}

=== usr/share/authselect/vendor/tprof/password-auth 576
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if ("with-c" or not "with-c")}
password    requisite     pam_pwquality.so {if "with-b" or "with-a":yes_text|no_text}
auth        sufficient    pam_unix.so nullok
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid
{if not (("with-a")):only_yes}
password    requisite     pam_pwquality.so {exclude if ("with-a")} tail {exclude if not (("with-a"))}
session     optional      pam_keyinit.so revoke
{if not ("with-b" or "with-b"):yes_text|no_text}
=== usr/share/authselect/vendor/tprof/postlogin 235

password    requisite     pam_pwquality.so
auth        required      pam_env.so {include if "with-b"}
 {include if}
session     optional      pam_keyinit.so revoke {exclude if not not "with-b" and "with-d"} tail {include if "with-c"}

=== usr/share/authselect/vendor/tprof/smartcard-auth 640
    {imply "with-c" if "with-b"}
account     required      pam_unix.so
auth        required      pam_env.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {exclude if not "with-c"}
session     optional      pam_keyinit.so revoke
{stop if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if not "with-d" and "with-b" or "with-b"}

password    requisite     pam_pwquality.so {imply "with-b" if "with-d"} tail {continue if ("with-b") and "with-b"}
session     optional      pam_keyinit.so revoke {continue if not "with-a" and not not "with-b"}

