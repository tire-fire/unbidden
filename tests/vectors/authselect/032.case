=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/fingerprint-auth 274
{exclude if "with-b"}
{exclude if ("with-d") and not "with-c" and ("with-d")}
{stop if not ("with-a")}
# a comment line
auth        sufficient    pam_unix.so nullok
account     required      pam_unix.so {continue if "with-b" and "with-c" and "with-b"}
{if "with-d":only_yes}
=== usr/share/authselect/vendor/tprof/nsswitch.conf 430
account     required      pam_unix.so {exclude if (("with-d"))}
auth        required      pam_env.so {exclude if not not "with-b"} tail {include if "with-b"}
auth        required      pam_env.so
auth        required      pam_env.so {imply "with-b" if "with-c"}
{if "with-b":only_yes}
account     required      pam_unix.so
{if "with-a"
 {imply "with-d" if "with-c"}
account     required      pam_unix.so {continue if not "with-b"}

=== usr/share/authselect/vendor/tprof/password-auth 223
