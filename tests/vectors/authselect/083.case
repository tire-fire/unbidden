=== usr/share/authselect/vendor/tprof/README 14
Test profile.

=== usr/share/authselect/vendor/tprof/nsswitch.conf 229
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {include if (("with-d"))} tail {include if "with-b"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid

=== usr/share/authselect/vendor/tprof/password-auth 820
# a comment line {if "with-a":yes_text|no_text} tail {if (("with-c" and "with-d")):yes_text|no_text}
    {if "with-d" and ("with-c" and "with-a"):yes_text|no_text} tail {continue if "with-a" or "with-d" or "with-b" and "with-c" or "with-d" or "with-a"}
auth        sufficient    pam_unix.so nullok {exclude if "with-c" and "with-d" and ("with-d") or not ("with-d")}
session     optional      pam_keyinit.so revoke {if "with-a":only_yes}
account     required      pam_unix.so
# a comment line {continue if "with-c" and not "with-d"} tail {if not "with-c" and "with-a" and "with-d":yes_text|no_text}
{stop if ("with-b" and "with-b") and "with-a"}
account     required      pam_unix.so {if "with-c":yes_text|no_text} tail {exclude if not ("with-c") and ("with-c")}
 {if not "with-c" and "with-d" and not "with-c":only_yes}

=== usr/share/authselect/vendor/tprof/postlogin 206
auth        sufficient    pam_unix.so nullok
# a comment line
{exclude if ("with-c")}
password    requisite     pam_pwquality.so
auth        required      pam_env.so {exclude if (not "with-b" or "with-c")}

=== usr/share/authselect/vendor/tprof/smartcard-auth 224
session     optional      pam_keyinit.so revoke {if "with-c":only_yes}
{imply "with-c" if not "with-c"}
session     optional      pam_keyinit.so revoke {if "with-a":yes_text|no_text}
{exclude if not not "with-d" or "with-c"}
=== usr/share/authselect/vendor/tprof/system-auth 589
auth        sufficient    pam_unix.so nullok {continue if not "with-c"}
account     required      pam_unix.so
auth        required      pam_env.so
password    requisite     pam_pwquality.so {include if}

session     optional      pam_keyinit.so revoke {include if not ("with-b")} tail {imply "with-d" if ((("with-d")))}
account     required      pam_unix.so {if "with-a":only_yes} tail {continue if not not "with-d" or "with-a"}
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if not "with-a" or "with-d" or "with-a" and "with-c":only_yes} tail {}

