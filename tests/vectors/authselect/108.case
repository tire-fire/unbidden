=== usr/share/authselect/vendor/tprof/nsswitch.conf 425
# a comment line
# a comment line
{continue if not "with-c"}
account     required      pam_unix.so {exclude if (not "with-c")}
{include if "with-c" and "with-b"}
   
account     required      pam_unix.so
session     [success=1 default=ignore] pam_succeed_if.so service in crond quiet use_uid {if ("with-c") or not "with-c" or "with-b":only_yes}
    {exclude if not "with-a" or "with-a" and ("with-d")}
 {exclude if "with-b"}

=== usr/share/authselect/vendor/tprof/password-auth 411
