=== usr/share/authselect/vendor/tprof/postlogin 321
{if ("with-c" or "with-d"):yes_text|no_text}
auth        sufficient    pam_unix.so nullok {bogus "with-a"}
auth        required      pam_env.so
{exclude if ("with-d" or "with-c") or not "with-b"}
 {if "with-d":yes_text|no_text} tail {include if "with-b" and "with-c" and ("with-a")}
account     required      pam_unix.so

