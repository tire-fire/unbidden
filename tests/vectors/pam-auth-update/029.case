=== etc/pam.d/common-session 611
# test template for common-session, variant 1
session	optional	pam_local_before.so
# here are the per-package modules (the "Primary" block)
session	[default=1]			pam_permit.so
# here's the fallback if no module succeeds
session	requisite			pam_deny.so
session	required			pam_permit.so
# and here are more per-package modules (the "Additional" block)
session	[success=1 new_authtok_reqd=done default=ignore]	pam_b.so try_first_pass
session	[success=ok new_authtok_reqd=ok ignore=ignore user_unknown=bad default=die]	pam_b.so use_authtok nullok
# end of pam-auth-update config
session	optional	pam_local_after.so

