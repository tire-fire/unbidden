=== usr/share/pam-configs/prof0 623
Name: prof0 profile
Default: yes
Priority: 256
Account-Type: Additional
Account:
	optional	pam_e.so
Password-Type: Additional
Password:
	[success=1 default=ignore]	pam_d.so
	[success=ok new_authtok_reqd=ok ignore=ignore user_unknown=bad default=die]	pam_c.so try_first_pass
Password-Initial:
	[success=end new_authtok_reqd=done default=ignore]	pam_a.so try_first_pass
	[success=end default=ignore]	pam_b.so
Session-Type: Additional
Session:
	optional	pam_e.so use_authtok nullok
	[success=end new_authtok_reqd=done default=ignore]	pam_a.so try_first_pass
Session-Initial:
	sufficient	pam_e.so
Session-Interactive-Only: yes

