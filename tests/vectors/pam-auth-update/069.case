=== usr/share/pam-configs/prof0 830
Name: prof0 profile
Default: yes
Priority: 257
Auth-Type: Additional
Auth:
	[success=ok new_authtok_reqd=ok ignore=ignore user_unknown=bad default=die]	pam_c.so use_authtok nullok
	[success=end new_authtok_reqd=done default=ignore]	pam_c.so try_first_pass
	requisite	pam_e.so quiet
Auth-Initial:
	[success=end new_authtok_reqd=done default=ignore]	pam_b.so try_first_pass
	[default=die]	pam_c.so use_authtok nullok
Password-Type: Additional
Password:
	requisite	pam_e.so use_authtok nullok
	requisite	pam_c.so use_authtok nullok
Password-Initial:
	requisite	pam_c.so try_first_pass
	[default=die]	pam_a.so use_authtok nullok
	optional	pam_d.so
Session-Type: Primary
Session:
	[success=end new_authtok_reqd=done default=ignore]	pam_d.so use_authtok nullok
	[default=die]	pam_c.so try_first_pass
	sufficient	pam_d.so try_first_pass

