# test template for common-account, variant 1
account	optional	pam_local_before.so
# here are the per-package modules (the "Primary" block)
account	requisite	pam_a.so 
account	[success=4 default=ignore]	pam_b.so 
account	requisite	pam_c.so try_first_pass
account	[success=2 new_authtok_reqd=done default=ignore]	pam_a.so 
account	[success=1 default=ignore]	pam_d.so quiet
# here's the fallback if no module succeeds
account	requisite			pam_deny.so
account	required			pam_permit.so
# and here are more per-package modules (the "Additional" block)
account	optional	pam_d.so 
account	optional	pam_c.so 
account	[success=0 new_authtok_reqd=done default=ignore]	pam_e.so use_authtok nullok
# end of pam-auth-update config
account	optional	pam_local_after.so

