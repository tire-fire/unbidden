Name: prof0 profile
Default: yes
Priority: 192
Auth-Type: Primary
Auth:
	[success=end new_authtok_reqd=done default=ignore]	pam_d.so try_first_pass
	[success=end new_authtok_reqd=done default=ignore]	pam_c.so
	[success=end default=ignore]	pam_a.so quiet
Account-Type: Additional
Account:
	[success=ok new_authtok_reqd=ok ignore=ignore user_unknown=bad default=die]	pam_a.so quiet
	sufficient	pam_b.so
	[success=end default=ignore]	pam_b.so
Account-Initial:
	[success=end default=ignore]	pam_a.so use_authtok nullok
	[success=end new_authtok_reqd=done default=ignore]	pam_d.so use_authtok nullok
	[success=end default=ignore]	pam_b.so
Session-Type: Additional
Session:
