Name: prof0 profile
Default: no
Priority: 1024
Auth-Type: Additional
Auth:
	required	pam_c.so try_first_pass
Account-Type: Additional
Account:
	[success=1 default=ignore]	pam_e.so
	[success=end new_authtok_reqd=done default=ignore]	pam_b.so quiet
Password-Type: Primary
Password:
	required	pam_d.so use_authtok nullok
	sufficient	pam_d.so
	requisite	pam_c.so
