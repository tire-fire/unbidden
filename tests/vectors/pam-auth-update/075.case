# test template for common-account, variant 1
account	optional	pam_local_before.so
# here are the per-package modules (the "Primary" block)
account	[success=1 default=ignore]	pam_e.so quiet
account	optional	pam_c.so use_authtok nullok
account	required	pam_e.so use_authtok nullok
account	requisite	pam_e.so try_first_pass
account	[success=ok new_authtok_reqd=ok ignore=ignore user_unknown=bad default=die]	pam_d.so 
# here's the fallback if no module succeeds
account	requisite			pam_deny.so
account	required			pam_permit.so
# and here are more per-package modules (the "Additional" block)
account	[success=1 default=ignore]	pam_a.so use_authtok nullok
account	optional	pam_d.so 
# end of pam-auth-update config
account	optional	pam_local_after.so

