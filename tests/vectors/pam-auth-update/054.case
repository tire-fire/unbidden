Name: prof0 profile
Default: yes
Priority: 256
Account-Type: Primary
Account:
	requisite	pam_a.so quiet
	[success=end default=ignore]	pam_a.so try_first_pass
Account-Initial:
	required	pam_c.so try_first_pass
