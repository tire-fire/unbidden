=== usr/share/pam-configs/prof0 375
Name: prof0 profile
Default: yes
Priority: 192
Auth-Type: Additional
Auth:
	[success=end new_authtok_reqd=done default=ignore]	pam_d.so
	required	pam_a.so try_first_pass
Password-Type: Additional
Password:
	requisite	pam_b.so use_authtok nullok
	[default=die]	pam_b.so
Password-Initial:
	[success=1 default=ignore]	pam_a.so quiet
	[success=end default=ignore]	pam_c.so quiet

